# Data haul — 21 GB (lexicon.db 2.3 GB + backup + data/external 15 GB).
# Never vendored; not history-safe. Re-buildable / re-ingestable separately.
data/

# Exception: small package-data files live in the source tree (GSE/nlp/data/) and ARE
# committed, despite the broad data/ rule above (the CC-BY-SA misspellings table, the
# project allowlist). The big rebuildable validity wordlist stays under data/ (ignored).
!GSE/nlp/data/
!GSE/nlp/data/**

# Virtual env & build artifacts
.venv/
*.egg-info/
build/
dist/

# Python caches
__pycache__/
*.py[cod]
.mypy_cache/
.pytest_cache/
.ruff_cache/
.benchmarks/

# Logs & local runtime
logs/

# LintGate tool state — regenerable cache (analysis runs, spec cache,
# staged workflows, runtime state). Same class as the caches above.
.lintgate/

# Detective / Wesker state — regenerable analysis caches (verdicts, recalled inputs, traces);
# `detective purge` deletes them. Same class as the caches above.
.detective/
.wesker/

# OS / editor cruft
.DS_Store

# tool scrape cache (re-fetchable; not source)
.firecrawl/
.serena/

# Raw lexicon-run dumps of 10 MB or more stay on disk as records but out of git: GitHub warns
# above 50 MB and history keeps every byte. Smaller receipts in the same directories are committed.
docs/readings/2026-11-01-lexicon-alias-identity/body-zipf-006/receipts.json
