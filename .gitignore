# Data haul — 21 GB (lexicon.db 2.3 GB + backup + data/external 15 GB).
# Never vendored; not history-safe. Re-buildable / re-ingestable separately.
data/

# Exception: the small CC-BY-SA common-misspellings table lives in the source tree
# (package data) and IS committed, despite the broad data/ rule above.
!gse/nlp/data/
!gse/nlp/data/misspellings_wikipedia.tsv

# Virtual env & build artifacts
.venv/
*.egg-info/
build/
dist/

# Python caches
__pycache__/
*.py[cod]
.mypy_cache/
.pytest_cache/
.ruff_cache/
.benchmarks/

# Logs & local runtime
logs/

# LintGate tool state — regenerable cache (analysis runs, spec cache,
# staged workflows, runtime state). Same class as the caches above.
.lintgate/

# OS / editor cruft
.DS_Store

# tool scrape cache (re-fetchable; not source)
.firecrawl/
