def _enumerate(self, doc) -> list:
        toks = list(doc)

        def nearest(i: int, step: int):
            j = i + step
            while 0 <= j < len(toks):
                if toks[j].pos_ not in ("PUNCT", "DET"):
                    return toks[j] if _entity_like(toks[j]) else None
                j += step
            return None

        cands: list = []
        seen: set = set()
        for pivot in toks:
            if pivot.pos_ == "PUNCT" or not _has_verb_sense(pivot.lemma_):
                continue
            pre, post = nearest(pivot.i, -1), nearest(pivot.i, +1)
            is_copula = pivot.lemma_.lower() == "be"  # "be" is no content transitive verb
            roles = {"SYN_PRED": pivot}
            if pre is not None:
                roles["SYN_SUBJ"] = pre
            if post is not None:
                roles["SYN_COMPL" if is_copula else "SYN_OBJ"] = post
            rp = {r: self._prims(t.lemma_) for r, t in roles.items()}
            for frame, shape, filler in self._score_against(rp):
                key = (frame, tuple(sorted((r, t.i) for r, t in roles.items())))
                if key in seen:
                    continue
                seen.add(key)
                cands.append(Candidate(dict(roles), frame, shape, filler))
        return cands
def repair_syn_map(self, doc, syn_map: Dict[int, str]) -> Dict[int, str]:
        """Encode-facing auto step: detect a degraded clause from its positional ``syn_map``
        and, ONLY on a confident commit, return a patched map (token-index → role). A clean
        parse, an ambiguous bifurcation, or a no-candidate degraded parse all pass through
        unchanged — the repair never overrides a viable literal."""
        # Tier-1 repair models a SINGLE clause (its prototypes are single-clause frames).
        # A multi-clause sentence ("…because Doran is loyal to Maeve") carries one SYN_PRED
        # per clause; scoring its cross-clause role bag mis-reads it as degraded, and a commit
        # would replace the sentence-wide argument roles with one clause's frame — nulling every
        # OTHER clause's roles (the copula-in-because regression). Out of scope for Tier-1: pass a
        # multi-predicate sentence through untouched (per-clause repair is a later tier).
        if sum(1 for r in syn_map.values() if r == "SYN_PRED") > 1:
            return syn_map
        toks = list(doc)
        roles_tok: Dict[str, object] = {}
        for i in sorted(syn_map):
            if syn_map[i] in ARGUMENT_ROLES:
                roles_tok.setdefault(syn_map[i], toks[i])
        literal = {r: self._prims(t.lemma_) for r, t in roles_tok.items()}
        lit_match = self._score_against(literal)
        if lit_match and not self._false_clean_suspect(doc, lit_match[0][0], roles_tok):
            return syn_map  # clean → untouched
        cands = sorted(self._enumerate(doc), key=lambda c: -c.score)
        if not cands:
            return syn_map  # degraded, no candidate → literal
        top = cands[0]
        if [c for c in cands if top.score - c.score <= EPS and c.frame != top.frame]:
            return syn_map  # bifurcate → don't override
        patched = {i: r for i, r in syn_map.items() if r not in ARGUMENT_ROLES}
        for r, t in top.roles.items():  # commit: install repaired roles
            patched[t.i] = r
        return patched
