
### GSE/symbolic/operators.py

 def evaluate_tree(expr: Operand):
    """Walk an Expression tree, evaluating every Op into a Predicate.

    Returns:
        Either an unchanged leaf (Atom, Phrase, Negation of leaf) or a
        Predicate (for Op nodes). Nested Ops are evaluated recursively:
        each Op's args are evaluated before the Op itself, so the result
        is a tree of Predicates with Expression leaves.
    """
    if isinstance(expr, Op):
        # Recurse into args first so nested Ops become Predicates before
        # the parent dispatch sees them.
        evaluated_args = [evaluate_tree(a) for a in expr.args]
        return evaluate(replace(expr, args=evaluated_args))
    if isinstance(expr, Negation):
        # Preserve the sign around WHATEVER the operand evaluates to — including a
        # Predicate (a negated event/type-assertion, "X does not harm Y"). The old
        # guard kept the wrapper only around leaves/Ops and dropped it for
        # Predicates, silently losing clausal negation; emit_contract already
        # turns a Negation(Predicate) into {"op": "NOT", ...}.
        return Negation(operand=evaluate_tree(expr.operand))
    return expr

### GSE/symbolic/emit.py

 def _leaf_str(node: Any) -> str:
    """Render an entity-like leaf to its surface lemma string (contract v1).

    Lossless over possessor + modifier so "Macduff's friend" / "the barking
    dog" survive as strings rather than collapsing to the bare head.
    """
    name = type(node).__name__
    if name == "Atom":
        return node.lemma
    if name == "Phrase":
        return " ".join(a.lemma for a in node.atoms)
    if name == "Entity":
        # A demi-word renders as its whole span ("lady macbeth").
        if getattr(node, "span", ()):
            return " ".join(node.span)
        s = node.head.lemma
        if getattr(node, "modifier", None) is not None:
            s = f"{_leaf_str(node.modifier)} {s}"
        if getattr(node, "possessor", None) is not None:
            s = f"{_leaf_str(node.possessor)}'s {s}"
        return s
    # Fallback: a primitive value already (str/int) or an unknown leaf.
    return node if isinstance(node, str) else str(node)

 def _degree_features(node: Any) -> list[dict]:
    """Retain operand degree without changing the contract's leaf schema."""
    name = type(node).__name__
    if name == "Atom":
        degree = node.degree
        return [{"target": node.lemma, "scale": degree["scale"], "level": degree["level"]}] if degree else []
    if name == "Phrase":
        return [record for atom in node.atoms for record in _degree_features(atom)]
    if name == "Entity":
        return _degree_features(node.head) + _degree_features(node.modifier)
    if name == "Coordination":
        return [record for member in node.members for record in _degree_features(member)] + _degree_features(
            node.modifier
        )
    if name == "Negation":
        return _degree_features(node.operand)
    return []

 def emit(node: Any) -> Any:
    """Walk an evaluated node into its §5 envelope (or a leaf string).

    Predicates become ``{op, args, features}``; entity-like leaves become
    surface strings; ``Negation`` and ``Coordination`` get their own op
    envelopes. Total over the node set so a partially-evaluated tree never
    raises — an un-reduced ``Op`` falls through to its operation token.
    """
    name = type(node).__name__

    spec = _PRED_SPEC.get(name)
    if spec is not None:
        op, fields, feats = spec
        # Skip operand fields that are None (e.g. an intransitive Event's patient)
        # OR that render to a BLANK leaf. An empty-string operand is a malformed
        # contract — a sentence-initial "So" with no explicit cause, an infinitive
        # with no controller — and a blank token crashes the consumer's WordNet
        # stemmer (NPE-ing the whole sentence). Dropping it reduces arity, which the
        # bridge's arity guards absorb. General over constructions, not a per-word patch.
        args = []
        degrees = []
        for f in fields:
            v = getattr(node, f)
            if v is None:
                continue
            ev = emit(v)
            if isinstance(ev, str) and not ev.strip():
                continue
            degrees.extend({"argument": len(args), **record} for record in _degree_features(v))
            args.append(ev)
        # Likewise drop blank feature values (e.g. a Control with an empty verb).
        features = {
            k: getattr(node, k)
            for k in feats
            if not (isinstance(getattr(node, k), str) and not getattr(node, k).strip())
        }
        # Latent themes (the role-split's secondary args, e.g. Event.themes) ride in features
        # as surface strings — preserved + revivable, but NOT promoted into the default read.
        # Generic over predicates (only Event has any today); absent ⇒ byte-identical contract.
        themes = getattr(node, "themes", ())
        if themes:
            features["themes"] = [_leaf_str(t) for t in themes]
        # The event's modal primes ("might" → MAYBE, #66): a consumer reads the event as possible or necessary, not
        # as a fact. Absent for a plain clause, so its contract is byte-identical.
        modal = getattr(node, "modal", ())
        if modal:
            features["modal"] = list(modal)
        duration = getattr(node, "duration", None)
        if duration is not None:
            features["duration"] = asdict(duration)
        if degrees:
            features["degree"] = degrees
        return {"op": op, "args": args, "features": features}

    if name == "Negation":
        return {"op": "NOT", "args": [emit(node.operand)], "features": {}}

    if name == "Coordination":
        features: Dict[str, Any] = {"conjunction": node.conjunction}
        if getattr(node, "modifier", None) is not None:
            features["modifier"] = _leaf_str(node.modifier)
        return {
            "op": "COORD",
            "args": [emit(m) for m in node.members],
            "features": features,
        }

    if name == "Op":
        # Un-reduced operator (shouldn't appear post-evaluate_tree; stay total).
        degrees = [
            {"argument": index, **record}
            for index, argument in enumerate(node.args)
            for record in _degree_features(argument)
        ]
        op_features: Dict[str, Any] = {"degree": degrees} if degrees else {}
        if node.duration is not None:
            op_features["duration"] = asdict(node.duration)
        return {
            "op": node.operation,
            "args": [emit(a) for a in node.args],
            "features": op_features,
        }

    # A reference-resolved Entity → v2 entity-ref. (Possessor folds into the
    # surface lemma string; the ref's identity is the head's entity_id.)
    if name == "Entity" and getattr(node, "entity_id", None) is not None:
        # Appositive type-inheritance is folded in HERE, at serialization — after coreference and agent
        # selection are fixed — so a described proper noun ("Arjun, a warrior") carries its evidenced
        # type without that thread perturbing the upstream pipeline (which would flip the agent).
        thread = node.type_thread or getattr(node, "apposition_thread", ())
        return {
            "entity_id": node.entity_id,
            "lemma": _leaf_str(node),
            "type_thread": list(thread),
        }

    # Entity (unresolved) / Atom / Phrase / bare value → leaf string (v1).
    return _leaf_str(node)

 def _has_entity_ref(payload: Any) -> bool:
    """True if the emitted payload contains any v2 entity-ref."""
    if isinstance(payload, dict):
        if "entity_id" in payload:
            return True
        return any(_has_entity_ref(v) for v in payload.values())
    if isinstance(payload, list):
        return any(_has_entity_ref(v) for v in payload)
    return False

 def emit_contract(
    node: Any,
    version: str | None = None,
    *,
    include_semantics: bool = False,
    source_text: str | None = None,
    relation_primitives=None,
) -> Dict[str, Any]:
    """Wrap :func:`emit` with the contract version envelope.

    One sentence → one predicate tree → one contract dict. The version is
    inferred from the payload (``v2`` if any entity-ref is present, else
    ``v1``), so the Genesis bridge knows whether ``args`` leaves are strings or
    ``{entity_id, lemma, type_thread}``. Pass ``version`` to override.

    ``include_semantics`` adds the versioned shared claim decisions beside the
    gold predicate envelope. The default Genesis-facing payload is unchanged.
    """
    payload = emit(node)
    if version is None:
        version = CONTRACT_VERSION_V2 if _has_entity_ref(payload) else CONTRACT_VERSION
    contract = {"contract_version": version, "predicate": payload}
    degrees = _degree_features(node)
    if degrees:
        contract["degree"] = degrees
    if include_semantics:
        from GSE.symbolic.claims import claim_key, commitment, polarity, scope_signature
        from GSE.symbolic.propositions import propositions

        contract["claim_semantics"] = {
            "version": "GSE.claim-semantics/1",
            "claims": [
                {
                    "kind": item.kind,
                    "commitment": commitment(item),
                    "polarity": asdict(polarity(item)),
                    "scope_signature": scope_signature(item),
                    "comparison": asdict(claim_key(item, relation_primitives)),
                }
                for item in propositions(node, source_text=source_text)
            ],
        }
    return contract

 def emit_json(node: Any, indent: int = 2) -> str:
    """Serialize the contract envelope to JSON."""
    return json.dumps(emit_contract(node), indent=indent)

### GSE/symbolic/serialization.py

 class SerializationError(ValueError):
    """Raised when a dict's ``_kind`` is missing or unknown."""

 def _with_duration(data: Dict[str, Any], duration: Duration | None) -> Dict[str, Any]:
    if duration is not None:
        data["duration"] = asdict(duration)
    return data

 def _read_duration(data: Dict[str, Any]) -> Duration | None:
    if "duration" not in data:
        return None
    value = data["duration"]
    if not isinstance(value, dict) or set(value) != {"extent", "relation"}:
        raise SerializationError("INVALID_DURATION")
    try:
        duration = Duration(extent=value["extent"], relation=value["relation"])
    except ValueError as error:
        raise SerializationError("INVALID_DURATION") from error
    operation = data.get("operation")
    is_temporal = data.get("_kind") == "Temporal" or operation == "TEMPORAL"
    if is_temporal == (duration.relation == "during"):
        raise SerializationError("INVALID_DURATION_SCOPE")
    if data.get("_kind") == "Op" and operation not in ("EVENT", "CONTROL", "TYPE_ASSERT", "TEMPORAL"):
        raise SerializationError("INVALID_DURATION_SCOPE")
    if data.get("_kind") == "Temporal" and data.get("conjunction", duration.relation) != duration.relation:
        raise SerializationError("INVALID_DURATION_SCOPE")
    return duration

 def to_dict(node: Node) -> Dict[str, Any]:
    """Serialize an Expression / Entity / Predicate tree to a JSON-safe dict.

    Every node carries a ``_kind`` discriminator so ``from_dict`` can
    reconstruct without external type information.
    """
    if isinstance(node, Atom):
        d = {
            "_kind": "Atom",
            "lemma": node.lemma,
            "word_primitives": dict(node.word_primitives),
            "role": node.role,
            "position": node.position,
            "pos": node.pos,
        }
        # Later Atom fields: emit only when set, so payloads without them stay byte-identical (#4).
        if node.number is not None:
            d["number"] = node.number
        if node.graded:
            d["graded"] = node.graded
        if node.apposition is not None:
            d["apposition"] = node.apposition
        if node.degree:
            d["degree"] = dict(node.degree)
        if node.degree_modifier:
            d["degree_modifier"] = True
        return d
    if isinstance(node, Phrase):
        return {
            "_kind": "Phrase",
            "atoms": [to_dict(a) for a in node.atoms],
        }
    if isinstance(node, Negation):
        return {
            "_kind": "Negation",
            "operand": to_dict(node.operand),
        }
    if isinstance(node, Op):
        out = {
            "_kind": "Op",
            "primitive": node.primitive,
            "operation": node.operation,
            "arity": node.arity,
            "args": [to_dict(a) for a in node.args],
        }
        if node.modal:  # an EVENT's modal primes (#66); absent for a plain clause, so its dict is unchanged
            out["modal"] = list(node.modal)
        return _with_duration(out, node.duration)
    if isinstance(node, Entity):
        d = {
            "_kind": "Entity",
            "head": to_dict(node.head),
            "possessor": to_dict(node.possessor) if node.possessor else None,
            "role": node.role,
            "modifier": to_dict(node.modifier) if node.modifier else None,
        }
        # Reference-resolution fields (M2): emit only when set, so pre-resolution
        # Entity payloads stay byte-identical to before.
        if node.entity_id is not None:
            d["entity_id"] = node.entity_id
        if node.type_thread:
            d["type_thread"] = list(node.type_thread)
        if node.span:
            d["span"] = list(node.span)
        if node.apposition_thread:
            d["apposition_thread"] = list(node.apposition_thread)
        return d
    if isinstance(node, Comparison):
        return {
            "_kind": "Comparison",
            "lhs": to_dict(node.lhs),
            "rhs": to_dict(node.rhs),
            "sign": node.sign,
            "axis": node.axis,
        }
    if isinstance(node, Equality):
        return {
            "_kind": "Equality",
            "lhs": to_dict(node.lhs),
            "rhs": to_dict(node.rhs),
            "axis": node.axis,
        }
    if isinstance(node, TypeQuery):
        return {"_kind": "TypeQuery", "entity": to_dict(node.entity)}
    if isinstance(node, DegreeQuery):
        return {
            "_kind": "DegreeQuery",
            "entity": to_dict(node.entity),
            "axis": node.axis,
        }
    if isinstance(node, MinimalSufficiency):
        return {
            "_kind": "MinimalSufficiency",
            "threshold": to_dict(node.threshold),
            "purpose": to_dict(node.purpose),
        }
    if isinstance(node, SetRestriction):
        return {
            "_kind": "SetRestriction",
            "member": to_dict(node.member),
            "predicate": to_dict(node.predicate),
        }
    if isinstance(node, BoundaryCase):
        return {
            "_kind": "BoundaryCase",
            "entity": to_dict(node.entity),
            "predicate": to_dict(node.predicate),
            "note": node.note,
        }
    if isinstance(node, Event):
        d = {
            "_kind": "Event",
            "verb": node.verb,
            "agent": to_dict(node.agent),
            "patient": to_dict(node.patient) if node.patient is not None else None,
        }
        if node.modal:  # the modal primes (#66); absent for a plain clause, so its dict is unchanged
            d["modal"] = list(node.modal)
        # The latent secondary args are preserved, never destroyed (#4); emitted only when present.
        if node.themes:
            d["themes"] = [to_dict(t) for t in node.themes]
        return _with_duration(d, node.duration)
    if isinstance(node, Contrast):
        return {
            "_kind": "Contrast",
            "left": to_dict(node.left),
            "right": to_dict(node.right),
        }
    if isinstance(node, ClauseCoordination):
        return {
            "_kind": "ClauseCoordination",
            "left": to_dict(node.left),
            "right": to_dict(node.right),
            "conjunction": node.conjunction,
        }
    if isinstance(node, Causation):
        return {
            "_kind": "Causation",
            "cause": to_dict(node.cause),
            "effect": to_dict(node.effect),
            "conjunction": node.conjunction,
        }
    if isinstance(node, Conditional):
        return {
            "_kind": "Conditional",
            "antecedent": to_dict(node.antecedent),
            "consequent": to_dict(node.consequent),
            "conjunction": node.conjunction,
        }
    if isinstance(node, Temporal):
        return _with_duration(
            {
                "_kind": "Temporal",
                "setting": to_dict(node.setting),
                "event": to_dict(node.event),
                "conjunction": node.conjunction,
            },
            node.duration,
        )
    if isinstance(node, TypeAssertion):
        d = {
            "_kind": "TypeAssertion",
            "entity": to_dict(node.entity),
            "kind": to_dict(node.kind),
        }
        if node.modal:  # the modal primes (#66); absent otherwise, so the dict is unchanged
            d["modal"] = list(node.modal)
        return _with_duration(d, node.duration)
    if isinstance(node, RelativeRestriction):
        return {
            "_kind": "RelativeRestriction",
            "head": to_dict(node.head),
            "restriction": to_dict(node.restriction),
        }
    if isinstance(node, Control):
        d = {
            "_kind": "Control",
            "controller": to_dict(node.controller),
            "inner": to_dict(node.inner),
            "verb": node.verb,
            "subject": to_dict(node.subject) if node.subject is not None else None,
        }
        if node.modal:  # the modal primes (#66); absent otherwise, so the dict is unchanged
            d["modal"] = list(node.modal)
        return _with_duration(d, node.duration)
    if isinstance(node, Coordination):
        return {
            "_kind": "Coordination",
            "members": [to_dict(m) for m in node.members],
            "conjunction": node.conjunction,
            "modifier": to_dict(node.modifier) if node.modifier else None,
        }
    raise SerializationError(f"Unknown node type: {type(node).__name__}")

 def to_json(node: Node, indent: int = 2) -> str:
    """Serialize a node tree to a JSON string."""
    return json.dumps(to_dict(node), indent=indent)

 def _require_kind(d: Dict[str, Any]) -> str:
    kind = d.get("_kind")
    if kind is None:
        raise SerializationError("Dict missing '_kind' discriminator")
    return kind

 def from_dict(d: Dict[str, Any]) -> Node:
    """Reconstruct a node tree from a ``to_dict`` result."""
    kind = _require_kind(d)
    if kind == "Atom":
        return Atom(
            lemma=d["lemma"],
            word_primitives=dict(d.get("word_primitives") or {}),
            role=d.get("role"),
            position=d.get("position", 0),
            pos=d.get("pos"),
            number=d.get("number"),
            graded=d.get("graded", False),
            apposition=d.get("apposition"),
            degree=dict(d.get("degree") or {}),
            degree_modifier=d.get("degree_modifier", False),
        )
    if kind == "Phrase":
        return Phrase(atoms=[from_dict(x) for x in d["atoms"]])
    if kind == "Negation":
        return Negation(operand=from_dict(d["operand"]))
    if kind == "Op":
        return Op(
            primitive=d["primitive"],
            operation=d["operation"],
            arity=d["arity"],
            args=[from_dict(x) for x in d["args"]],
            modal=tuple(d.get("modal") or ()),
            duration=_read_duration(d),
        )
    if kind == "Entity":
        return Entity(
            head=from_dict(d["head"]),
            possessor=from_dict(d["possessor"]) if d.get("possessor") else None,
            role=d.get("role"),
            modifier=from_dict(d["modifier"]) if d.get("modifier") else None,
            entity_id=d.get("entity_id"),
            type_thread=tuple(d.get("type_thread") or ()),
            span=tuple(d.get("span") or ()),
            apposition_thread=tuple(d.get("apposition_thread") or ()),
        )
    if kind == "Comparison":
        return Comparison(
            lhs=from_dict(d["lhs"]),
            rhs=from_dict(d["rhs"]),
            sign=d.get("sign", +1),
            axis=d.get("axis"),
        )
    if kind == "Equality":
        return Equality(
            lhs=from_dict(d["lhs"]),
            rhs=from_dict(d["rhs"]),
            axis=d.get("axis"),
        )
    if kind == "TypeQuery":
        return TypeQuery(entity=from_dict(d["entity"]))
    if kind == "DegreeQuery":
        return DegreeQuery(entity=from_dict(d["entity"]), axis=d.get("axis"))
    if kind == "MinimalSufficiency":
        return MinimalSufficiency(
            threshold=from_dict(d["threshold"]),
            purpose=from_dict(d["purpose"]),
        )
    if kind == "SetRestriction":
        return SetRestriction(
            member=from_dict(d["member"]),
            predicate=from_dict(d["predicate"]),
        )
    if kind == "BoundaryCase":
        # ``note`` has a default so deserializing older payloads stays safe.
        return BoundaryCase(
            entity=from_dict(d["entity"]),
            predicate=from_dict(d["predicate"]),
            note=d.get("note", "deferred"),
        )
    if kind == "Event":
        return Event(
            verb=d["verb"],
            agent=from_dict(d["agent"]),
            patient=from_dict(d["patient"]) if d.get("patient") else None,
            themes=tuple(from_dict(t) for t in d.get("themes") or ()),
            modal=tuple(d.get("modal") or ()),
            duration=_read_duration(d),
        )
    if kind == "Contrast":
        return Contrast(left=from_dict(d["left"]), right=from_dict(d["right"]))
    if kind == "ClauseCoordination":
        return ClauseCoordination(
            left=from_dict(d["left"]),
            right=from_dict(d["right"]),
            conjunction=d.get("conjunction", "and"),
        )
    if kind == "Causation":
        return Causation(
            cause=from_dict(d["cause"]),
            effect=from_dict(d["effect"]),
            conjunction=d.get("conjunction", "so"),
        )
    if kind == "Conditional":
        return Conditional(
            antecedent=from_dict(d["antecedent"]),
            consequent=from_dict(d["consequent"]),
            conjunction=d.get("conjunction", "if"),
        )
    if kind == "Temporal":
        duration = _read_duration(d)
        return Temporal(
            setting=from_dict(d["setting"]),
            event=from_dict(d["event"]),
            conjunction=d.get("conjunction", duration.relation if duration else "when"),
            duration=duration,
        )
    if kind == "TypeAssertion":
        return TypeAssertion(
            entity=from_dict(d["entity"]),
            kind=from_dict(d["kind"]),
            modal=tuple(d.get("modal") or ()),
            duration=_read_duration(d),
        )
    if kind == "RelativeRestriction":
        return RelativeRestriction(
            head=from_dict(d["head"]),
            restriction=from_dict(d["restriction"]),
        )
    if kind == "Control":
        return Control(
            controller=from_dict(d["controller"]),
            inner=from_dict(d["inner"]),
            verb=d.get("verb", ""),
            subject=from_dict(d["subject"]) if d.get("subject") else None,
            modal=tuple(d.get("modal") or ()),
            duration=_read_duration(d),
        )
    if kind == "Coordination":
        return Coordination(
            members=tuple(from_dict(m) for m in d["members"]),
            conjunction=d.get("conjunction", "and"),
            modifier=from_dict(d["modifier"]) if d.get("modifier") else None,
        )
    raise SerializationError(f"Unknown _kind: {kind!r}")

 def from_json(s: str) -> Node:
    """Deserialize a JSON string back into a node tree."""
    return from_dict(json.loads(s))

### tests/test_symbolic_resolution.py

 def encoder():
    return GSEEncoder()

 def _atom(lemma: str, pos: str = "NOUN") -> Atom:
    return Atom(lemma=lemma, word_primitives={}, position=0, pos=pos)

 class TestPhraseCollapse:
    def test_single_noun_in_phrase_becomes_entity(self):
        # "the dog" → Phrase([the(DET), dog(NOUN)]) → Entity(head=dog)
        phrase = Phrase(atoms=[_atom("the", "DET"), _atom("dog", "NOUN")])
        result = resolve(phrase)
        assert isinstance(result, Entity)
        assert result.head.lemma == "dog"

    def test_function_words_filtered(self):
        # "the big dog" → keep "big" only if it's the entity head?
        # ADJ is predicate-ish; for v1 the entity head is the rightmost NOUN/PROPN.
        phrase = Phrase(
            atoms=[
                _atom("the", "DET"),
                _atom("big", "ADJ"),
                _atom("dog", "NOUN"),
            ]
        )
        result = resolve(phrase)
        assert isinstance(result, Entity)
        assert result.head.lemma == "dog"

    def test_lone_entity_atom_promoted(self):
        # Bare Atom that's a NOUN/PROPN gets wrapped in Entity by resolve
        a = _atom("rex", "PROPN")
        result = resolve(a)
        assert isinstance(result, Entity)
        assert result.head.lemma == "rex"

    def test_non_entity_atom_left_unchanged(self):
        # ADJ doesn't get wrapped — only NOUN/PROPN/PRON do
        a = _atom("happy", "ADJ")
        result = resolve(a)
        assert isinstance(result, Atom)  # left as-is

    def test_empty_phrase_stays_phrase(self):
        result = resolve(Phrase(atoms=[]))
        assert isinstance(result, Phrase)
        assert result.atoms == []

 class TestModifierPreservation:
    """v2 fix: ADJ/ADV atoms from the source Phrase survive as Entity.modifier."""

    def test_adj_in_phrase_becomes_entity_modifier(self):
        # "the tall dog" → Entity(head=dog, modifier=tall)
        phrase = Phrase(
            atoms=[
                _atom("the", "DET"),
                _atom("tall", "ADJ"),
                _atom("dog", "NOUN"),
            ]
        )
        result = resolve(phrase)
        assert isinstance(result, Entity)
        assert result.head.lemma == "dog"
        assert result.modifier is not None
        assert result.modifier.lemma == "tall"

    def test_no_adj_means_no_modifier(self):
        phrase = Phrase(atoms=[_atom("the", "DET"), _atom("dog", "NOUN")])
        result = resolve(phrase)
        assert isinstance(result, Entity)
        assert result.modifier is None

    def test_adv_also_captured(self):
        phrase = Phrase(atoms=[_atom("the", "DET"), _atom("quickly", "ADV"), _atom("dog", "NOUN")])
        result = resolve(phrase)
        assert isinstance(result, Entity)
        assert result.modifier is not None
        assert result.modifier.lemma == "quickly"

 class TestPossessiveGrouping:
    def test_propn_possessive_noun_nests(self):
        # "Mike's dog" → Entity(head=dog, possessor=Entity(head=Mike))
        phrase = Phrase(
            atoms=[
                _atom("mike", "PROPN"),
                Atom(lemma="'s", word_primitives={}, position=1, pos="PART"),
                _atom("dog", "NOUN"),
            ]
        )
        result = resolve(phrase)
        assert isinstance(result, Entity)
        assert result.head.lemma == "dog"
        assert result.possessor is not None
        assert result.possessor.head.lemma == "mike"

    def test_no_possessive_no_nesting(self):
        # "Mike Rex" (a meaningless juxtaposition) shouldn't produce a
        # possessor — just falls back to taking the last entity
        phrase = Phrase(atoms=[_atom("mike", "PROPN"), _atom("rex", "PROPN")])
        result = resolve(phrase)
        assert isinstance(result, Entity)
        assert result.head.lemma == "rex"
        assert result.possessor is None

 class TestPronounBinding:
    def test_he_bound_to_most_recent_propn(self):
        # Construct an Op with two args: first is "Mike", second is "he"
        # (a pronoun Entity). Resolve should bind "he" → Mike.
        mike_entity = Entity(head=_atom("mike", "PROPN"))
        he_entity = Entity(head=_atom("he", "PRON"))
        op = Op(primitive="COMP_BECAUSE", operation="CAUSAL_SOURCE", arity=2, args=[mike_entity, he_entity])
        result = resolve(op)
        assert isinstance(result, Op)
        # The "he" entity should now point to Mike's head
        assert result.args[1].head.lemma == "mike"

    def test_unbound_pronoun_left_alone(self):
        # No antecedent before the pronoun — leave it as-is
        he_entity = Entity(head=_atom("he", "PRON"))
        result = resolve(he_entity)
        assert isinstance(result, Entity)
        assert result.head.lemma == "he"

    def test_resolution_uses_most_recent_not_first(self):
        # "Mike", "Rex", "he" — "he" should bind to Rex (most recent)
        mike = Entity(head=_atom("mike", "PROPN"))
        rex = Entity(head=_atom("rex", "PROPN"))
        he = Entity(head=_atom("he", "PRON"))
        op = Op(
            primitive="COMP_SO",
            operation="CONSEQUENCE",
            arity=2,
            args=[
                Phrase(atoms=[])
                if False
                else Op(  # nested op to put Mike+Rex in same flow
                    primitive="COMP_BUT", operation="CONTRAST", arity=2, args=[mike, rex]
                ),
                he,
            ],
        )
        result = resolve(op)
        # Walking left-to-right: Mike seen first, then Rex, then he → he becomes Rex
        # Find the "he" slot (right arg of outer Op)
        he_resolved = result.args[1]
        assert isinstance(he_resolved, Entity)
        assert he_resolved.head.lemma == "rex"

 class TestEndToEndResolution:
    def test_simple_sentence_entities_recovered(self, encoder):
        trace = encoder.encode("Mike is taller than Rex")
        expr = resolve(from_trace(trace))
        # After resolution, both args of the Op should be Entities
        assert isinstance(expr, Op)
        lhs = expr.args[0]
        rhs = expr.args[1]
        # LHS may have been collapsed from a Phrase containing Mike + is + taller;
        # the Entity head should be Mike (the PROPN)
        assert _find_entity_lemma(lhs, "mike")
        assert _find_entity_lemma(rhs, "rex")

    def test_possessive_in_sentence_grouped(self, encoder):
        trace = encoder.encode("Mike's dog ran fast")
        expr = resolve(from_trace(trace))
        # No COMP_* operator — top-level should be a Phrase or Entity
        # containing "dog" as entity head with Mike as possessor
        assert _contains_possessive_entity(expr, head="dog", possessor="mike")

    def test_pronoun_bound_in_causal_sentence(self, encoder):
        trace = encoder.encode("Mike left because he was happy")
        expr = resolve(from_trace(trace))
        # The "he" pronoun should be bound to Mike. Check by walking the
        # AST and verifying no "he" lemma appears in any Entity head.
        assert not _contains_entity_lemma(expr, "he"), f"Pronoun 'he' was not resolved to Mike: {expr!r}"

    def test_resolution_is_idempotent(self, encoder):
        trace = encoder.encode("Mike is taller than Rex")
        once = resolve(from_trace(trace))
        twice = resolve(once)
        # Same shape, same lemmas — Entity nodes pass through unchanged
        assert _structure_equal(once, twice)

 def _find_entity_lemma(expr, lemma):
    """True if some Entity in the tree has this lemma at head or possessor."""
    if isinstance(expr, Entity):
        if expr.head.lemma == lemma:
            return True
        if expr.possessor is not None and _find_entity_lemma(expr.possessor, lemma):
            return True
        return False
    if isinstance(expr, Op):
        return any(_find_entity_lemma(a, lemma) for a in expr.args)
    if isinstance(expr, Phrase):
        return any(a.lemma == lemma for a in expr.atoms)
    if isinstance(expr, Atom):
        return expr.lemma == lemma
    return False

 def _contains_possessive_entity(expr, head, possessor):
    """Search the tree for Entity(head=head, possessor=Entity(head=possessor))."""
    if isinstance(expr, Entity):
        if expr.head.lemma == head and expr.possessor is not None and expr.possessor.head.lemma == possessor:
            return True
        if expr.possessor is not None:
            return _contains_possessive_entity(expr.possessor, head, possessor)
        return False
    if isinstance(expr, Op):
        return any(_contains_possessive_entity(a, head, possessor) for a in expr.args)
    if isinstance(expr, Phrase):
        # Phrase didn't get collapsed — search atoms
        return False
    return False

 def _contains_entity_lemma(expr, lemma):
    """True if some Entity in the tree has this exact lemma at its head."""
    if isinstance(expr, Entity):
        if expr.head.lemma == lemma:
            return True
        if expr.possessor is not None and _contains_entity_lemma(expr.possessor, lemma):
            return True
        return False
    if isinstance(expr, Op):
        return any(_contains_entity_lemma(a, lemma) for a in expr.args)
    if isinstance(expr, Phrase):
        return any(a.lemma == lemma and a.pos == "PRON" for a in expr.atoms)
    return False

 def _structure_equal(a, b):
    """Shape + lemma equality (ignores pre-Entity Phrase identity)."""
    if type(a) is not type(b):
        return False
    if isinstance(a, Atom):
        return a.lemma == b.lemma
    if isinstance(a, Entity):
        if a.head.lemma != b.head.lemma:
            return False
        if (a.possessor is None) != (b.possessor is None):
            return False
        if a.possessor is not None:
            return _structure_equal(a.possessor, b.possessor)
        return True
    if isinstance(a, Op):
        return (
            a.operation == b.operation
            and len(a.args) == len(b.args)
            and all(_structure_equal(x, y) for x, y in zip(a.args, b.args))
        )
    return False

### GSE/api/encoder.py

### GSE/symbolic/expression.py

 def _atom_from_token(token: TokenTrace, role: Optional[str] = None) -> Atom:
    """Build a single Atom from a TokenTrace."""
    # Recover grammatical number for nouns: the lemmatizer strips plurality (nobles →
    # noble), but the surface is still on the trace token, so a surface ≠ lemma noun is
    # plural. (Pronoun number is read from a table in the coref binder, not here.)
    number = None
    graded = False
    pos = token.pos or None
    surface = getattr(token, "token", "") or ""
    if pos in ("NOUN", "PROPN"):
        number = "plur" if surface.lower() != (token.lemma or "").lower() else "sing"
    elif pos == "ADJ":
        # comparative/superlative ("fattest"/"older") → surface differs from base lemma
        graded = surface.lower() != (token.lemma or "").lower()
    return Atom(
        lemma=token.lemma,
        word_primitives=dict(token.word_primitives),
        role=role,
        position=token.position,
        pos=pos,
        number=number,
        graded=graded,
        degree=dict(token.degree),
        degree_modifier=bool(token.degree_modifier),
    )

 def _try_copula_type_assertion(tokens: Sequence[TokenTrace], signs: Optional[Signs] = None) -> Optional[Expression]:
    """Synthesize a TYPE_ASSERT ``Op`` from a copula "X is a Y" / "X is ADJ" clause.

    The encoder tags the subject (SYN_SUBJ), the copula "be" (SYN_PRED), and the
    predicate complement (SYN_COMPL) but emits no COMP_* operator for "is", so no
    predicate would otherwise be produced. When the full pattern is present with a
    nominal OR adjective complement (:data:`_COMPLEMENT_POS`), build
    ``Op("TYPE_ASSERT", args=[subject_span, complement_span])``; resolve() collapses
    each span into an Entity. Only reached when the clause has NO operator (so
    "X is taller than Y" stays a Comparison via COMP_THAN). A predicate adjective is
    the same binding as a predicate nominal — the entity takes on the complement's
    decomposition. Returns ``None`` when the pattern does not hold.
    """
    copula = next(
        (t for t in tokens if _COPULA_PREDICATE in t.sent_primitives and t.lemma == _COPULA_LEMMA),
        None,
    )
    if copula is None:
        return None
    # SYN_SUBJ marks the subject in a main clause. In a subordinate clause
    # ("…because Doran is loyal to Maeve") the encoder may tag that subject
    # SYN_OBJ instead, so also accept any entity token before the copula — the
    # same positional subject the spans below already build from. Without this
    # the subordinate copula bails here and collapses to a demi-word nominal.
    has_subject = any(_COPULA_SUBJECT in t.sent_primitives for t in tokens) or any(
        t.position < copula.position and t.pos in _PP_OBJECT_POS for t in tokens
    )
    has_complement = any(_COPULA_COMPLEMENT in t.sent_primitives and t.pos in _COMPLEMENT_POS for t in tokens)
    if not (has_subject and has_complement):
        return None

    # PASSIVE / progressive "be": a content VERB after the copula ("was taken",
    # "are decaying", "was viewed as …") is an EVENT — the surface subject is a
    # participant in an action — NOT a type assertion "X IS take". Without this bail
    # the participle is swept into the TYPE_ASSERT complement (line ~290) and the whole
    # event is destroyed (a major source of the "destroyed structure" residual: every
    # passive collapsed to a non-event). Bail so _try_event recovers the event. True
    # copulas ("X is a king", "X is callous", "loyal to Y") have no post-copula VERB
    # and are untouched. (GSE-native structural fix, 2026-06-24.)
    if any(
        t.position > copula.position
        and t.pos == "VERB"
        and t.lemma != _COPULA_LEMMA
        and not getattr(t, "is_operator", False)
        for t in tokens
    ):
        return None

    # Negated type assertion ("X is not a Y"): drop the marker, wrap in Negation — when the sign lands on this
    # assertion's own content, not on an intensifier ("not very good" stays GOOD, one step down) or on another verb.
    negated = _takes_sign(tokens, _sign_owners(tokens) if signs is None else signs)
    subject_atoms = [
        _atom_from_token(t) for t in tokens if t.position < copula.position and t.lemma not in _NEGATION_LEMMAS
    ]
    if not subject_atoms:
        return None

    # Relational predicate adjective — "X is ADJ ADP Y" ("loyal to Y", "angry
    # at Y"). The PP complement makes this a RELATION between X and the PP's
    # object, not the bare property attribution decision A handles: folding
    # "loyal to Corwin" into one kind nominal drops both the preposition and Y,
    # and (as a `because` cause clause) silently defeats rule learning. Build an
    # EVENT keyed on the adjective so ADJ(X, Y) survives with both arguments.
    after = [t for t in tokens if t.position > copula.position and t.lemma not in _NEGATION_LEMMAS and t.pos != "PUNCT"]
    # A native spatial PP is a relation, not a kind nominal. Reuse the
    # existing relation/event roleframe so resolution, queries, claim identity
    # and emission all retain the actual preposition and its two arguments.
    if after and after[0].pos == "ADP":
        encoding = get_preposition_encoding(after[0].lemma) or {}
        anchor = after[1:]
        if encoding.get("spatial_type") and anchor and any(t.pos in _PP_OBJECT_POS for t in anchor):
            relation = Op(
                primitive=after[0].lemma,
                operation="EVENT",
                arity=2,
                args=[Phrase(atoms=subject_atoms), Phrase(atoms=[_atom_from_token(t) for t in anchor])],
            )
            return Negation(operand=relation) if negated else relation
    adj_i = next((i for i, t in enumerate(after) if t.pos == "ADJ"), None)
    if adj_i is not None:
        rest = after[adj_i + 1 :]
        if rest and rest[0].pos == "ADP":
            pp_object = [t for t in rest[1:] if t.pos in _PP_OBJECT_POS]
            if pp_object:
                event = Op(
                    primitive=after[adj_i].lemma,
                    operation="EVENT",
                    arity=2,
                    args=[
                        Phrase(atoms=subject_atoms),
                        Phrase(atoms=[_atom_from_token(t) for t in pp_object]),
                    ],
                )
                return Negation(operand=event) if negated else event

    complement_atoms = [
        _atom_from_token(t) for t in tokens if t.position > copula.position and t.lemma not in _NEGATION_LEMMAS
    ]
    if not complement_atoms:
        return None
    assertion = Op(
        primitive="COPULA",
        operation="TYPE_ASSERT",
        arity=2,
        args=[Phrase(atoms=subject_atoms), Phrase(atoms=complement_atoms)],
    )
    return Negation(operand=assertion) if negated else assertion

 def _try_event(
    tokens: Sequence[TokenTrace], shared_subject: Optional[Sequence] = None, signs: Optional[Signs] = None
) -> Optional[Expression]:
    """Synthesize an EVENT ``Op`` from a plain verb clause "X verbs Y".

    The base case the operator set was missing: a clause with an ordinary content
    verb (not the copula "be", not a COMP_* operator token) and no other
    operator. Mirrors :func:`_try_copula_type_assertion` — the verb is detected by
    POS (so it works for sub-clause verbs that aren't the sentence ROOT, e.g. the
    ``became`` of "…because Duncan became happy"); subject = tokens before it,
    object/complement = tokens after. Returns ``None`` when no content verb is
    present, so callers fall through to the default phrase build.

    The verb lemma rides on ``Op.primitive``; ``operators.event`` reads it back.
    """
    verb = _select_clause_verb(tokens)
    if verb is None:
        return None
    # Clausal negation ("X does not harm Y"): NOT is a sign-direction argument
    # (sentence_architecture.md), so drop the marker from the argument spans and
    # wrap the synthesized EVENT in a Negation — the same node the in-span path
    # (_build_arg_expression) and the emitter already understand. Only a sign that
    # lands on this event's own verb or participants: "I think this doesn't work"
    # does not negate think, and "He left not because…" negates the because.
    negated = _takes_sign(tokens, _sign_owners(tokens) if signs is None else signs, verb.position)
    _ordered = sorted(tokens, key=lambda t: t.position)

    def _prep_governed(tok) -> bool:
        """Is ``tok`` the object of a preposition? Walk back over its own determiner/adjective
        premodifiers (only — NOT other nominals, so a fronted PP's object is not confused with
        the following subject head); if the governing token is a preposition, ``tok`` is a PP
        oblique. Catches a FRONTED adverbial before the subject ("In the daytime I ran" →
        daytime governed, I not) — the subject-side twin of the post-verb object/oblique split,
        so a fronted PP no longer blobs into the subject ("daytime i"). Text-agnostic.

        EXCEPTION — a genitive/territorial ``of``-postmodifier of a preceding NAME/head-NOUN
        ("Richard of Gloucester", "Duncan of Scotland", "the son of Duncan") is PART of that
        nominal, not a fronted PP: its object stays with the subject rather than being peeled off
        as a SYN_OBL (which `event()` then mis-reads as a `theme`). Restricted to ``of`` (the
        genitive connector) so an adverbial PP after the subject head ("Macbeth in his rage …")
        stays an oblique. This is PRE-verb only; a real imputed-act complement ("accuses Y OF
        treason") is post-verb and split by the object/oblique boundary below, so it is untouched."""
        for t in reversed([x for x in _ordered if x.position < tok.position]):
            if t.pos in ("DET", "ADJ"):
                continue
            if t.pos != "ADP":
                return False
            if t.lemma == "of":
                for u in reversed([x for x in _ordered if x.position < t.position]):
                    if u.pos in ("DET", "ADJ"):
                        continue
                    return u.pos not in ("PROPN", "NOUN")  # head noun before "of" -> postmodifier -> keep
            return True
        return False

    appositive = _appositive_positions(tokens, verb)  # NAME, description, → keep the name (Haemon)
    leading_adjunct = _leading_adjunct_positions(tokens, verb)  # "Angered by X, the king …" → keep the king
    subject_tokens = [
        t
        for t in tokens
        if t.position < verb.position
        and t.pos != "PUNCT"
        and t.lemma not in _NEGATION_LEMMAS
        and not _prep_governed(t)
        and t.position not in appositive
        and t.position not in leading_adjunct
    ]
    # A nominalized-adjective subject ("A giant attacks", "A stranger helps") is the NP head used as a
    # noun; promote it so it grounds as the agent instead of being dropped as a bare adjective atom.
    subject_atoms = _promote_nominalized_adjective_subject(
        subject_tokens, [_atom_from_token(t) for t in subject_tokens]
    )
    # Appositive type-inheritance (hint only — the thread is filled at the grounding annotate seam): when
    # the subject is a NAME described by an appositive ("Arjun, a warrior" / "Haemon, Creon's son"), carry
    # the description's head noun onto the kept proper-noun atom. The name stays the agent (this does not
    # touch subject selection); grounding later types it from what the TEXT says when the name itself can't
    # be placed. The apposition head is the LAST noun of the dropped appositive span.
    if appositive:
        _appos_nouns = [
            t
            for t in sorted(tokens, key=lambda t: t.position)
            if t.position in appositive and t.pos in ("NOUN", "PROPN")
        ]
        if _appos_nouns:
            _ah = _appos_nouns[-1].lemma
            subject_atoms = [replace(a, apposition=_ah) if a.pos == "PROPN" else a for a in subject_atoms]
    fronted_obliques = [
        _atom_from_token(t, "SYN_OBL")
        for t in tokens
        if t.position < verb.position and t.pos != "PUNCT" and t.lemma not in _NEGATION_LEMMAS and _prep_governed(t)
    ]
    # Direct object vs PP obliques. The clause's direct object is the post-verb nominal
    # span UP TO the first preposition; tokens from the first preposition on are PP
    # obliques ("for months", "with this result", "to Macbeth"). Without this split the
    # object accretes every trailing PP nominal into one blobbed entity (the demi-word
    # span — "penny she month this result"). The obliques are RESOLVED as a typed
    # SYN_OBL constituent rather than merged or discarded; the narrative spine's
    # set-operation keeps them off the protagonist backbone. (Text-agnostic: the boundary
    # is the preposition POS, not any story-specific word.)
    post_verb = [
        t for t in tokens if t.position > verb.position and t.pos != "PUNCT" and t.lemma not in _NEGATION_LEMMAS
    ]
    first_prep = next((idx for idx, t in enumerate(post_verb) if t.pos == "ADP"), None)
    obj_tokens = post_verb if first_prep is None else post_verb[:first_prep]
    obl_tokens = [] if first_prep is None else post_verb[first_prep:]
    object_atoms = [_atom_from_token(t) for t in obj_tokens]
    oblique_atoms = fronted_obliques + [_atom_from_token(t, "SYN_OBL") for t in obl_tokens]
    if not subject_atoms:
        # VP-coordination with an elided shared subject ("Bertran [betrayed Aldric] and
        # [murdered him]") — inherit the prior conjunct's subject so the 2nd event survives
        # instead of collapsing to its bare object. Only fires when the clause has no subject.
        if not shared_subject:
            return None
        subject_atoms = list(shared_subject)
    args: List[Operand] = [Phrase(atoms=subject_atoms)]
    if object_atoms:
        args.append(Phrase(atoms=object_atoms))
        # Carry obliques only BEHIND a real object, so a bare PP after an intransitive
        # ("stood by the window") never slides into the patient slot (args[1]).
        if oblique_atoms:
            args.append(Phrase(atoms=oblique_atoms))
    # A modal auxiliary before the verb ("might", "can", "must") qualifies the event, keyed on its primes (#66).
    modal = modal_primes([t.word_primitives for t in tokens if t.position < verb.position and t.pos == "AUX"])
    event = Op(primitive=verb.lemma, operation="EVENT", arity=len(args), args=args, modal=modal)
    return Negation(operand=event) if negated else event

 def _clause_core(tokens, shared_subject, signs):
    """Build the recoverable clause before a qualifying operator is attached."""
    content, duration = split_duration(tokens)
    if duration is not None and split_duration(content)[1] is None:
        qualified = _clause_core(content, shared_subject, signs)
        core, negations = _unwrap_negations(qualified)
        if isinstance(core, Op) and core.operation in {"EVENT", "TYPE_ASSERT"}:
            return _rewrap_negations(replace(core, duration=duration), negations)
    temporal = _nominal_temporal_attachment(tokens)
    if temporal is not None:
        content, linker, anchor, operation = temporal
        return Op(
            primitive=linker.lemma.upper() if operation == "TEMPORAL" else linker.lemma,
            operation=operation,
            arity=2,
            args=[_clause_core(content, shared_subject, signs), Phrase(atoms=[_atom_from_token(t) for t in anchor])],
        )
    copula = _try_copula_type_assertion(tokens, signs)
    if copula is not None:
        return _with_clause_modal(copula, tokens)
    event = _try_event(tokens, shared_subject=shared_subject, signs=signs)
    if event is not None:
        return event
    atoms = [_atom_from_token(t) for t in tokens if t.lemma not in _NEGATION_LEMMAS or t.pos in {"NOUN", "PRON"}]
    core = atoms[0] if len(atoms) == 1 else Phrase(atoms=atoms)
    return Negation(operand=core) if _takes_sign(tokens, signs) else core

 def _build_relative_restriction(
    emb: ClauseSpan,
    tokens: Sequence[TokenTrace],
    operators: Sequence[OperatorTrace],
    operator_positions: Sequence[int],
    signs: Optional[Signs] = None,
) -> Expression:
    """Build a relative clause's restriction with the antecedent bound into the
    relativizer's gap (``emb.gap_role``, from the encoder).

    "Macbeth who trusted the witches" → EVENT(trust; Macbeth, witches) [subject
    gap]; "the king whom Macbeth murdered" → EVENT(murder; Macbeth, king) [object
    gap]. Falls back to the plain build when the gap role is unknown or the clause
    has no content verb (e.g. the copular relative "who was the king", already
    handled correctly by the default path). The relative's own negation negates
    its event ("the cells that never changed"), never the matrix.
    """
    signs = _sign_owners(tokens) if signs is None else signs
    inner_tokens = [t for t in tokens if emb.token_start <= t.position < emb.token_end and not _is_relativizer(t)]
    verb = next(
        (t for t in inner_tokens if t.pos == "VERB" and t.lemma != _COPULA_LEMMA and not t.is_operator),
        None,
    )
    if verb is None or emb.gap_role not in ("subject", "object") or emb.attaches_to_token is None:
        return _build_clause_expr(emb, tokens, operators, operator_positions, drop_relativizers=True, signs=signs)

    inner_tokens, duration = split_duration(inner_tokens)
    antecedent = _atom_from_token(tokens[emb.attaches_to_token])
    # A negation is the event's sign, never one of its participants.
    participants = [t for t in inner_tokens if t.lemma not in _NEGATION_LEMMAS]
    before = [_atom_from_token(t) for t in participants if t.position < verb.position]
    after = [_atom_from_token(t) for t in participants if t.position > verb.position]
    if emb.gap_role == "object":
        agent_atoms, patient_atoms = before, [antecedent]
    else:  # subject gap — antecedent is the agent
        agent_atoms, patient_atoms = [antecedent], after

    if not agent_atoms:
        return _build_clause_expr(emb, tokens, operators, operator_positions, drop_relativizers=True, signs=signs)
    args: List[Operand] = [Phrase(atoms=agent_atoms)]
    if patient_atoms:
        args.append(Phrase(atoms=patient_atoms))
    modal = modal_primes([t.word_primitives for t in inner_tokens if t.position < verb.position and t.pos == "AUX"])
    event = Op(primitive=verb.lemma, operation="EVENT", arity=len(args), args=args, modal=modal, duration=duration)
