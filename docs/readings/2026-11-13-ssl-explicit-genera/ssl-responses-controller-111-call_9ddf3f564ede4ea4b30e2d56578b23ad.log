SOURCE GSE/curation/lexicon_builder/residual.py def _scaffold(
    resolution: Resolution, relations: tuple[Relation, ...], context: dict[str, str] | None, bank: str
) -> dict:
    """Snapshot the actual closure, retaining rule dispositions and proof data.

    All domains and proofs are context, not requested output. Approved tables
    are preserved even when skipped or locally excepted; only ACTIVE tables
    constrain this definition. Candidate tables never become model authority.
    """
    if type(relations) is not tuple or any(not isinstance(rule, Relation) for rule in relations):
        raise ValueError("invalid_request_relations")
    context = {} if context is None else context
    if type(context) is not dict or any(type(k) is not str or type(v) is not str for k, v in context.items()):
        raise ValueError("invalid_request_context")
    by_id = {}
    for rule in relations:
        rule.__post_init__()
        if rule.rule_id in by_id or not set(rule.banks + rule.absent_evidence) <= resolution.domains.keys():
            raise ValueError("invalid_request_relations")
        by_id[rule.rule_id] = rule
    active, excepted, skipped, referenced = set(), set(), {}, set()
    for receipt in resolution.trace:
        ids = set(receipt.get("rule_ids", ()))
        if "rule_id" in receipt:
            ids.add(receipt["rule_id"])
        referenced.update(ids)
        if receipt["kind"] in {"JOINT_CHECK", "SOLVER_LIMIT"}:
            active.update(ids)
        elif receipt["kind"] == "CONDITIONAL_EXCEPTION":
            excepted.update(ids)
        elif receipt["kind"] == "RELATION_SKIPPED":
            skipped[receipt["rule_id"]] = receipt["reason"]
        elif receipt["kind"] == "EVIDENCE_GUARD" and receipt["status"] == "BLOCKED":
            skipped[receipt["rule_id"]] = receipt["reason"]
    if not referenced <= by_id.keys():
        raise ValueError("missing_request_relation_context")
    connected = {bank}
    approved = tuple(rule for rule in relations if rule.approved)
    while True:
        expanded = connected | {
            name
            for rule in approved
            if connected.intersection(rule.banks + rule.absent_evidence)
            for name in rule.banks + rule.absent_evidence
        }
        if expanded == connected:
            break
        connected = expanded
    records = []
    for rule in sorted(approved, key=lambda item: item.rule_id):
        if rule.rule_id in excepted:
            disposition, reason = "EXCEPTED_FOR_THIS_DEFINITION", "CONDITIONAL_EXCEPTION"
        elif rule.rule_id in skipped:
            disposition, reason = "BLOCKED", skipped[rule.rule_id]
        elif rule.rule_id in active:
            disposition, reason = "ACTIVE", "SYMBOLIC_CLOSURE"
        else:
            raise ValueError("missing_request_rule_proof")
        guard_matches = all(context.get(key) == value for key, value in rule.guards)
        if (disposition == "ACTIVE" and not guard_matches) or (reason == "GUARD_MISMATCH" and guard_matches):
            raise ValueError("inconsistent_request_guard_context")
        records.append(
            {
                **asdict(rule),
                "disposition": disposition,
                "reason": reason,
                "requested_component": bool(connected.intersection(rule.banks)),
            }
        )
    return _json_copy(
        {
            "format": "GSE.symbolic-scaffold/1",
            "context": dict(sorted(context.items())),
            "domains": {name: sorted(values) for name, values in sorted(resolution.domains.items())},
            "approved_relations": records,
            "proof_trace": resolution.trace,
            "relation_semantics": "ONLY_ACTIVE_TABLES_CONSTRAIN_THIS_DEFINITION",
            "proof_semantics": "SYMBOLIC_JUSTIFICATION_NOT_ADDITIONAL_MODEL_OUTPUT",
        }
    )
SOURCE GSE/curation/lexicon_builder/foundation.py def validate_lexical_guards(relations) -> tuple[str, ...]:
    """Refuse unsupported scope schemas, including for empty build populations."""
    requested = set()
    for relation in relations:
        for key, value in relation.guards:
            if not valid_lexical_guard(key, value):
                raise ValueError("UNSUPPORTED_LEXICAL_GUARD")
            for prefix in WORDNET_ANCESTRY_GUARD_PREFIXES:
                if key.startswith(prefix):
                    requested.add(key.removeprefix(prefix))
    return tuple(sorted(requested))
SOURCE GSE/curation/lexicon_builder/foundation.py def native_frame_source(definition, observation) -> str | None:
    """Return the native sense group for an exact WordNet or Wiktionary witness."""
    source = _field(observation, "source")
    features = _field(observation, "features")
    if source == "wordnet_hierarchy":
        if _exact_wordnet_ancestry(definition, observation) and _attested_wordnet_lemma(definition, observation):
            return "wordnet:" + features["synset_name"]
        return None
    entry_id = _field(definition, "entry_id")
    if (
        source != "wiktionary"
        or _field(observation, "family") != "wiktionary"
        or _field(observation, "scope") != "lexical"
        or _field(observation, "entry_id") != entry_id
        or not isinstance(features, dict)
        or current_id(features.get("identity_scheme")) != "GSE.wiktionary-native-leaf/1"
        or any(features.get(field) != _field(definition, field) for field in ("entry_id", "lemma", "pos", "definition"))
    ):
        return None
    sense = features.get("native_sense")
    native_id, word = features.get("native_id"), features.get("word")
    if (
        not isinstance(sense, dict)
        or sense.get("glosses") != [features["definition"]]
        or any(key in sense for key in ("alt_of", "form_of"))
        or not isinstance(sense.get("tags", []), list)
        or any(tag in ("figuratively", "figurative", "metaphorical") for tag in sense.get("tags", []))
        or not isinstance(native_id, str)
        or not native_id
        or not isinstance(word, str)
        or not word
    ):
        return None
    from .evidence import _record_id

    if _field(observation, "record_id") != _record_id("wiktionary", word, features):
        return None
    return "wiktionary:" + native_id
SOURCE GSE/curation/lexicon_builder/foundation.py def lexical_context(definition, observations, relations) -> dict[str, str]:
    """Add only requested predicates supported by exact native witnesses.

    Accept typed Definition/Observation objects or their serialized dictionaries.
    Missing witnesses remain absent, never false or a bank zero. With no source
    guards, the result is byte-for-byte equivalent to the old POS-only context;
    unrelated source context cannot perturb historical model request identities.
    """
    context = definition_context(_field(definition, "pos"))
    requested = validate_lexical_guards(relations)
    native_lemma_requested = any(key == "wordnet_native_lemma" for rule in relations for key, _ in rule.guards)
    frame_guards = {key for rule in relations for key, _ in rule.guards if key.startswith(NATIVE_FRAME_PREFIX)}
    gloss = _field(definition, "definition")
    if frame_guards and context.get("pos") == "noun" and isinstance(gloss, str):
        matched = frame_guards.intersection(NATIVE_FRAME_PREFIX + frame for frame in native_noun_frames(gloss))
        if matched and any(native_frame_source(definition, row) for row in observations):
            context.update(dict.fromkeys(sorted(matched), "true"))
    anatomy_guards = {
        key for rule in relations for key, _ in rule.guards if key.startswith(WIKTIONARY_ANATOMY_FRAME_PREFIX)
    }
    if anatomy_guards and context.get("pos") == "noun" and isinstance(gloss, str):
        for observation in observations:
            if _field(observation, "source") != "wiktionary" or not native_frame_source(definition, observation):
                continue
            frame = wiktionary_anatomy_frame(gloss, "noun", _field(observation, "features")["native_sense"])
            if frame is not None and WIKTIONARY_ANATOMY_FRAME_PREFIX + frame in anatomy_guards:
                context[WIKTIONARY_ANATOMY_FRAME_PREFIX + frame] = "true"
    if requested or native_lemma_requested:
        ancestors = set()
        synsets = set()
        for observation in observations:
            witnessed = _exact_wordnet_ancestry(definition, observation)
            ancestors.update(witnessed)
            if witnessed:
                synsets.add(_field(observation, "features")["synset_name"])
            if native_lemma_requested and witnessed and _attested_wordnet_lemma(definition, observation):
                context["wordnet_native_lemma"] = "true"
        if ancestors:
            for relation in relations:
                for key, _ in relation.guards:
                    if (
                        key.startswith(_ANCESTOR_PREFIX)
                        and key.removeprefix(_ANCESTOR_PREFIX) in ancestors
                        or key.startswith(WORDNET_OUTSIDE_ANCESTOR_PREFIX)
                        and key.removeprefix(WORDNET_OUTSIDE_ANCESTOR_PREFIX) not in ancestors
                        or key.startswith(WORDNET_OTHER_SYNSET_PREFIX)
                        and len(synsets) == 1
                        and key.removeprefix(WORDNET_OTHER_SYNSET_PREFIX) not in synsets
                    ):
                        context[key] = "true"
    for relation in relations:
        exclusions = [key for key, _ in relation.guards if key.startswith(EXCEPTION_GUARD_PREFIX)]
        if exclusions and all(context.get(key) == value for key, value in relation.guards if key not in exclusions):
            identity = _field(definition, "entry_id")
            if not isinstance(identity, str) or not identity:
                continue
            context.update(
                {key: "false" if identity == key.removeprefix(EXCEPTION_GUARD_PREFIX) else "true" for key in exclusions}
            )
    return context
SOURCE GSE/curation/lexicon_builder/model_protocol.py def protocol_contract() -> dict:
    """Return independent protocol data, including the pinned polarity map."""
    import copy

    return {
        "format": PROTOCOL_VERSION,
        "operation": "LEXICAL_COMPONENT_ENTAILMENT",
        "scope": "OWN_DEFINITION",
        "definition_text": {
            "content": "/input/definition/definition",
            "identity": "/input/definition/entry_id",
            "expansion_witness": "/input/definition_content",
        },
        "excluded_scope": ["WORLD_ASSOCIATION", "ARGUMENT_IDENTITY", "EXAMPLE_CONTENT"],
        "codebook": {
            "-1": "DEFINITIONAL_NEGATIVE_POLE",
            "0": "JUSTIFIED_ORTHOGONALITY",
            "1": "DEFINITIONAL_POSITIVE_POLE",
            "null": "UNRESOLVED",
        },
        "negative_poles": {**dict(BIPOLAR_PAIRS), "WANT": "NOT_WANT"},
        "output_fields": "REQUESTED_BANK_ONLY",
        "known_values": "IMMUTABLE",
        "symbolic_context": "APPROVED_RULES_WITH_GUARDS_DISPOSITIONS_DOMAINS_AND_PROOF",
        "scaffold_view": SCAFFOLD_VIEW_FORMAT,
        "candidate_evidence": "IDENTITY_LINK_AND_SCOPE_REQUIRED_NOT_AUTOMATIC_ASSIGNMENT",
        "coordinates": {bank: coordinate_contract(bank) for bank in BANKS},
        "evidence_view": EVIDENCE_VIEW_FORMAT,
        "candidate_links": candidate_links_contract(),
        "examples": copy.deepcopy(EXAMPLES),
    }
