      "arguments": "{\"command\":\"/Users/rohanvinaik/Projects/SquishOS/ops/agents/bin/owned-run --label coverage-guard-and-scope-demand -- .venv/bin/python - <<'PY'\\nimport sqlite3,json,hashlib,time\\nfrom collections import Counter,defaultdict\\nfrom pathlib import Path\\nfrom datetime import datetime,timezone\\nfrom GSE.curation.lexicon_builder.completion import _priority_source\\nfrom GSE.curation.lexicon_builder.specification import frequency_buckets,normalized_spelling\\nr=Path('docs/readings/2026-11-13-ssl-explicit-genera'); c=sqlite3.connect('file:data/lexicon_builder/2026-11-12/ssl-explicit-genera/checkpoint-foundation.db?mode=ro',uri=True); c.execute('BEGIN'); _,freq=_priority_source('zipf',None); names=[x[0] for x in c.execute('SELECT DISTINCT lemma FROM lexemes')]; buckets=frequency_buckets(names,freq); common=set(json.loads((r/'ssl-api-runtime-token-demand.json').read_text())['common_forms']); guards=defaultdict(Counter); guard_by_bucket=defaultdict(lambda:defaultdict(Counter)); examples={}; matched=0\\nfor eid,lemma,trace in c.execute(\\\"SELECT d.entry_id,l.lemma,d.trace FROM definition_states d JOIN lexemes l ON l.id=d.lexeme_id WHERE l.pos IN ('adj','adjective','a','s')\\\"):\\n for row in json.loads(trace):\\n  if row.get('kind')!='EVIDENCE_GUARD':continue\\n  rid=row['rule_id']; key=row['status']+':'+row.get('reason',''); guards[rid][key]+=1; guards[rid]['definitions']+=1\\n  for group in [buckets[normalized_spelling(lemma)]]+(['runtime_common_forms'] if normalized_spelling(lemma) in common else []):guard_by_bucket[group][rid][key]+=1\\n  if rid not in examples:examples[rid]={'entry_id':eid,'lemma':lemma,'complete_guard_receipt':row}\\nsource=defaultdict(Counter); source_banks=defaultdict(lambda:defaultdict(Counter)); query='SELECT DISTINCT o.source,o.family,o.scope,o.entry_id,l.lemma,d.domains FROM source_observations o JOIN definition_states d ON d.entry_id=o.entry_id JOIN lexemes l ON l.id=d.lexeme_id WHERE o.entry_id IS NOT NULL'\\nfor src,family,scope,eid,lemma,raw in c.execute(query):\\n dom=json.loads(raw); label='|'.join([src,family,scope]); sp=normalized_spelling(lemma)\\n for group in ['lexicon',buckets[sp]]+(['runtime_common_forms'] if sp in common else []):\\n  k=group+'|'+label; source[k]['definitions']+=1; source[k]['filled_banks']+=sum(len(x)==1 for x in dom.values()); source[k]['unresolved_banks']+=sum(len(x)>1 for x in dom.values())\\n  for b,d in dom.items():source_banks[k][b]['filled' if len(d)==1 else 'unresolved' if d else 'conflict']+=1\\npronouns=[]\\nfor eid,domains,payload in c.execute(\\\"SELECT d.entry_id,d.domains,o.payload FROM source_observations o JOIN definition_states d ON d.entry_id=o.entry_id WHERE o.source='gse_closed_class'\\\"):\\n o=json.loads(payload); f=o['features']\\n if f.get('catalog')=='pronoun':\\n  gram=f.get('grammatical_features',{}).get('gram',{}); p=gram.get('person')\\n  if p in [1,2]:pronouns.append({'entry_id':eid,'native_record_id':o['record_id'],'grammar':gram,'I':json.loads(domains)['I'],'YOU':json.loads(domains)['YOU'],'status':'REVIEWED_NARROW_SOURCE_PROJECTION' if eid in ['gse_closed_class:pronoun:i','gse_closed_class:pronoun:you'] else 'OUTSIDE_REVIEWED_CASE_NUMBER_GUARD_NOT_PERMISSION'})\\nc.close(); out={'format':'GSE.ssl-api-coverage-source-scope/1','created_utc':datetime.now(timezone.utc).isoformat(),'database_pin':json.loads((r/'ssl-api-coverage-demand.json').read_text())['database'],'demand_semantics':'Exact source/entry attachments only, distinct source-family-scope-entry; these strata overlap and must not be summed. No candidate-linked or association observation is promoted to sign authority.','by_source_family_scope':source,'by_source_family_scope_bank':source_banks,'absence_guards':guards,'absence_guards_by_bucket':guard_by_bucket,'absence_guard_examples':examples,'native_person_case_number_scope':pronouns,'semantic_findings':['Current native dictionary projections and local admitted relation support show zero unreflected marginal narrowing in scanned exact witnesses (separate law-reach artifact).','A BLOCKED absence guard is justified abstention, not missing-zero integration. Full unclassified native text blocks the default.','First/second-person oblique/plural catalog variants lie outside current reviewed sufficient guard; no sign inferred from omitted fields.']}; (r/'ssl-api-coverage-source-scope.json').write_text(json.dumps(out,indent=2,sort_keys=True)+'\\\\n'); print(json.dumps({'absence_guards':guards,'absence_guards_top500':guard_by_bucket['1-500'],'absence_guards_501_1500':guard_by_bucket['501-1500'],'person_scope':pronouns,'common_source_demand':{k:v for k,v in source.items() if k.startswith('runtime_common_forms|')}},indent=2))\\nPY\",\"cwd\":\"/Users/rohanvinaik/Projects/GSE\",\"timeout_seconds\":300}",
