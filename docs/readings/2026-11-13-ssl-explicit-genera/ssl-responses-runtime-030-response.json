      "arguments": "{\"patch\":\"*** Begin Patch\\n*** Update File: /Users/rohanvinaik/Projects/GSE/scripts/audit_lexicon_sentences.py\\n@@\\n         if name == \\\"full_replay\\\" and (\\n@@\\n             raise ValueError(\\\"CHECKPOINT_FULL_REPLAY_INCOMPLETE\\\")\\n+        if name == \\\"two_sided_semantic_audit\\\" and (\\n+            set(receipt.get(\\\"audited_forms\\\", [])) != set(demand[\\\"common_forms\\\"])\\n+            or receipt.get(\\\"known_wrong\\\") != 0 or receipt.get(\\\"missing_required\\\") != 0\\n+            or any(receipt.get(\\\"checks\\\", {}).get(key) != \\\"PASSED\\\" for key in\\n+                   (\\\"positive\\\", \\\"must_not\\\", \\\"missing_sign\\\", \\\"source_warrants\\\", \\\"morphology\\\", \\\"pos_roles\\\",\\n+                    \\\"tail_strata\\\", \\\"genre_strata\\\"))\\n+        ):\\n+            raise ValueError(\\\"CHECKPOINT_TWO_SIDED_AUDIT_INCOMPLETE\\\")\\n     return workload\\n*** Update File: /Users/rohanvinaik/Projects/GSE/tests/test_lexicon_builder_grammatical_definitions.py\\n@@\\n def test_pronoun_selection_does_not_replace_explicit_noun_identity(encoder):\\n@@\\n     assert encoder.lexical_lookup(\\\"he\\\", entry_id=\\\"fixture:noun:he\\\")[\\\"primitives\\\"] == {\\\"SOMETHING\\\": 1}\\n+\\n+\\n+@pytest.mark.parametrize(\\\"text\\\", [\\n+    \\\"The chemical symbol He denotes helium.\\\",\\n+    \\\"The surname He is common.\\\",\\n+    \\\"The letter I is printed.\\\",\\n+])\\n+def test_native_nominal_name_role_challenges_parser_pronoun(encoder, text):\\n+    token = next(t for t in encoder.encode(text).tokens if t.token in {\\\"He\\\", \\\"I\\\"})\\n+    assert token.pos == \\\"PRON\\\"  # the parser label is NOT patched to force a result\\n+    assert token.lexical_evidence[\\\"selection_status\\\"] == \\\"CONFLICT\\\"\\n+    assert token.lexical_evidence[\\\"selected_record\\\"] is None\\n+    assert not token.lexical_evidence[\\\"sense_resolved\\\"]\\n+    assert token.word_primitives == {}\\n+