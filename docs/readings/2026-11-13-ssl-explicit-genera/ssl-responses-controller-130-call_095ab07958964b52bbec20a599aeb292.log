def _authorities(conn):
    anchors = _optional_metadata(conn, "anchors", {})
    if not isinstance(anchors, dict):
        raise ValueError("INVALID_ASSERTION_AUTHORITIES")
    anchor_records = {}
    for entry_id, records in anchors.items():
        if not _identity(entry_id) or not isinstance(records, list):
            raise ValueError("INVALID_ANCHOR_AUTHORITY")
        anchor_records[entry_id] = _assertions([(i, _canonical(record)) for i, record in enumerate(records)])
    return anchor_records, read_model_receipts(conn)

UNIT GSE/curation/lexicon_builder/validation.py _replay 
def _replay(conn: sqlite3.Connection, relations: tuple[Relation, ...], *, catalog_links: dict | None = None) -> dict:
    mismatches: list[dict] = []

    def mismatch(entry_id, code, **details):
        mismatches.append({"entry_id": entry_id if _identity(entry_id) else None, "code": code, **_diagnostic(details)})

    from .foundation import representation_contract

    convention = _optional_metadata(conn, "convention_version", None)
    representation_verification = "LEGACY_NOT_DECLARED"
    if convention is not None:
        expected_contract = representation_contract()
        if (
            identity_form(convention) != identity_form(expected_contract["version"])
            or identity_form(_optional_metadata(conn, "representation_contract", None))
            != identity_form(expected_contract)
            or identity_form(_optional_metadata(conn, "want_polarity", None))
            != identity_form(expected_contract["want_polarity"])
        ):
            mismatch(None, "REPRESENTATION_CONTRACT_MISMATCH")
            representation_verification = "MISMATCH"
        else:
            representation_verification = "VERIFIED"

    identities = conn.execute("SELECT entry_id,lexeme_id FROM definition_states").fetchall()
    entry_counts = Counter(row[0] for row in identities)
    state_counts = Counter(row[1] for row in identities)
    anchors, models = _authorities(conn)
    from .rule_history import read_history, replay_archives

    rule_history = read_history(conn, relations)
    archived_entries = {
        record["definition"]["entry_id"]
        for event in (rule_history["events"] if rule_history else ())
        for record in event["archived"]
    }
    for entry_id in (set(anchors) | set(models)) - entry_counts.keys():
        mismatch(entry_id, "ORPHAN_ASSERTION_AUTHORITY")
    native, relevant, bank_relevance = _observations(conn, entry_counts, mismatch, set(models) | archived_entries)
    replay_archives(conn, rule_history, native, relevant, anchors)
    _unresolved_integrity(conn, mismatch)
    _candidates_integrity(conn, native, mismatch)
    for entry_id, count in entry_counts.items():
        if not _identity(entry_id):
            mismatch(entry_id, "INVALID_DEFINITION_ID")
        if count != 1:
            mismatch(entry_id, "DUPLICATE_DEFINITION_STATE", rows=count)
    for entry_id, lexeme_id in identities:
        if type(lexeme_id) is not int or lexeme_id <= 0:
            mismatch(entry_id, "INVALID_LEXEME_ID")
        elif state_counts[lexeme_id] != 1:
            mismatch(entry_id, "AMBIGUOUS_LEXEME_LINK", lexeme_id=lexeme_id)

    lexemes: dict[int, sqlite3.Row] = {}
    duplicate_lexemes = set()
    for row in conn.execute("SELECT id,lemma,pos,sense_id,gloss,source,validation_status FROM lexemes"):
        if row["id"] in lexemes:
            duplicate_lexemes.add(row["id"])
            mismatch(row["sense_id"], "DUPLICATE_LEXEME_ID", lexeme_id=row["id"])
        lexemes[row["id"]] = row
        if row["id"] not in state_counts:
            mismatch(row["sense_id"], "LEXEME_WITHOUT_DEFINITION_STATE", lexeme_id=row["id"])

    evidence: dict[str, list[tuple[int, str]]] = defaultdict(list)
    for row in conn.execute("SELECT entry_id,ordinal,payload FROM builder_assertions"):
        if row["entry_id"] not in entry_counts:
            mismatch(row["entry_id"], "ORPHAN_ASSERTION", ordinal=row["ordinal"])
        evidence[row["entry_id"]].append((row["ordinal"], row["payload"]))
    restriction_evidence = defaultdict(list)
    restriction_table = conn.execute(
        "SELECT name FROM sqlite_master WHERE type='table' AND name='builder_domain_restrictions'"
    ).fetchone()
    restriction_format = _optional_metadata(conn, "domain_restrictions_format", None)
    if restriction_table is None:
        if restriction_format is not None:
            raise ValueError("MISSING_DOMAIN_RESTRICTIONS_TABLE")
    else:
        if current_id(restriction_format) != DOMAIN_RESTRICTIONS_VERSION:
            raise ValueError("UNSUPPORTED_DOMAIN_RESTRICTIONS_FORMAT")
        for row in conn.execute("SELECT entry_id,ordinal,payload FROM builder_domain_restrictions"):
            if row["entry_id"] not in entry_counts:
                mismatch(row["entry_id"], "ORPHAN_DOMAIN_RESTRICTION", ordinal=row["ordinal"])
            restriction_evidence[row["entry_id"]].append((row["ordinal"], row["payload"]))
    projections: dict[int, list[tuple[str, int]]] = defaultdict(list)
    for row in conn.execute("SELECT lexeme_id,primitive,value FROM primitive_values"):
        if row["lexeme_id"] not in state_counts:
            mismatch(None, "ORPHAN_PUBLISHED_ASSIGNMENT", lexeme_id=row["lexeme_id"], bank=row["primitive"])
        projections[row["lexeme_id"]].append((row["primitive"], row["value"]))

    validated = set()
    outcomes: Counter = Counter()
    inference_counts: Counter = Counter()
    for row in conn.execute("SELECT * FROM definition_states ORDER BY entry_id,lexeme_id"):
        entry_id, lexeme_id = row["entry_id"], row["lexeme_id"]
        if not _identity(entry_id) or entry_counts[entry_id] != 1 or state_counts[lexeme_id] != 1:
            continue
        if type(lexeme_id) is not int or lexeme_id <= 0 or lexeme_id in duplicate_lexemes:
            continue
        lexeme = lexemes.get(lexeme_id)
        if lexeme is None:
            mismatch(entry_id, "DEFINITION_WITHOUT_LEXEME", lexeme_id=lexeme_id)
            continue
        start = len(mismatches)
        if lexeme["sense_id"] != entry_id:
            mismatch(entry_id, "DEFINITION_IDENTITY_MISMATCH", stored_sense_id=lexeme["sense_id"])
        if not _identity(lexeme["lemma"]) or not _identity(lexeme["pos"]):
            mismatch(entry_id, "INVALID_LEXICAL_IDENTITY")
            continue
        if current_id(lexeme["source"]) != VERSION:
            mismatch(entry_id, "LEXEME_FORMAT_MISMATCH")
        try:
            assertions = _assertions(evidence[entry_id])
            domain_restrictions = _domain_restrictions(restriction_evidence[entry_id])
            _restriction_provenance(entry_id, domain_restrictions, native)
            definition = Definition(entry_id, lexeme["lemma"], lexeme["pos"], lexeme["gloss"])
            evidence_banks = tuple(sorted(bank_relevance.get(entry_id, ())))
            _provenance(
                entry_id,
                assertions,
                definition,
                relations,
                native,
                relevant,
                anchors,
                models,
                conn,
                evidence_banks,
                domain_restrictions,
                rule_history=rule_history,
            )
            saved_domains = _domains(_read_json(row["domains"]))
            published = _published(projections[lexeme_id])
            hierarchy = _read_json(row["hierarchy"])
            saved_trace = _read_json(row["trace"])
            saved_conflicts = _read_json(row["conflicts"])
            if row["code"] not in {"RESOLVED", "PARTIAL", "CONFLICT"}:
                raise ValueError("INVALID_STORED_RESOLUTION_CODE")
            if not isinstance(hierarchy, dict):
                raise ValueError("INVALID_HIERARCHY")
            if not isinstance(saved_trace, list) or any(not isinstance(record, dict) for record in saved_trace):
                raise ValueError("INVALID_TRACE")
            if not isinstance(saved_conflicts, list) or any(not isinstance(record, dict) for record in saved_conflicts):
                raise ValueError("INVALID_CONFLICT_RECORDS")
            resolution = resolve_dictionary(
                BANKS,
                assertions,
                relations,
                _stored_context(conn, definition, relations),
                evidence_banks=evidence_banks,
                domain_restrictions=domain_restrictions,
            )
        except (ValueError, TypeError) as error:
            mismatch(entry_id, "MALFORMED_ENTRY", reason=str(error))
            continue
        outcomes[resolution.code] += 1
        scope = next(record for record in resolution.trace if record["kind"] == "INFERENCE_SCOPE")
        inference_counts["entries_replayed"] += 1
        inference_counts["entries_complete_search"] += int(scope["complete_search"])
        limited_components = sum(record["kind"] == "SOLVER_LIMIT" for record in resolution.trace)
        inference_counts["entries_solver_limited"] += int(limited_components > 0)
        inference_counts["components_solver_limited"] += limited_components
        inference_counts["components_joint_checked"] += sum(
            record["kind"] == "JOINT_CHECK" for record in resolution.trace
        )
        if resolution.code != row["code"]:
            mismatch(entry_id, "RESOLUTION_CODE_MISMATCH", stored=row["code"], replayed=resolution.code)
        if resolution.domains != saved_domains:
            mismatch(
                entry_id,
                "DOMAIN_MISMATCH",
                banks=sorted(bank for bank in BANKS if resolution.domains[bank] != saved_domains[bank]),
            )
        expected = {} if resolution.code == "CONFLICT" else resolution.assignments
        if published != expected:
            mismatch(entry_id, "PUBLISHED_ASSIGNMENT_MISMATCH", stored=published, replayed=expected)
        if (row["code"] == "CONFLICT" or resolution.code == "CONFLICT") and published:
            mismatch(entry_id, "CONFLICT_PUBLISHED_ASSIGNMENTS")
        expected_status = {"CONFLICT": "rejected", "PARTIAL": "partial", "RESOLVED": "validated"}[resolution.code]
        if lexeme["validation_status"] != expected_status:
            mismatch(entry_id, "LEXEME_STATUS_MISMATCH", stored=lexeme["validation_status"], replayed=expected_status)
        for bank, level in hierarchy.items():
            if bank not in BANKS or type(level) is not int:
                mismatch(entry_id, "INVALID_HIERARCHY_TARGET", bank=bank)
            elif resolution.code == "CONFLICT" or resolution.assignments.get(bank) not in {-1, 1}:
                mismatch(entry_id, "HIERARCHY_WITHOUT_NONZERO_BASE", bank=bank)
        if _canonical(identity_form(saved_trace)) != _canonical(identity_form(resolution.trace)):
            mismatch(entry_id, "TRACE_MISMATCH")
        if _canonical(identity_form(saved_conflicts)) != _canonical(identity_form(resolution.conflicts)):
            mismatch(entry_id, "CONFLICT_RECEIPT_MISMATCH")
        if len(mismatches) == start:
            validated.add(entry_id)
    # Explicit link replacement rebuilds this derived cache from the replayed
    # state below. Requiring the old cache to match first prevents repairing a
    # stale catalogue. Every authoritative input and dictionary check above is
    # still required; ordinary replay continues to verify the saved cache.
    catalog_verification = "REPLACEMENT_NOT_VALIDATED"
    if catalog_links is None:
        catalog_verification = _catalog_integrity(
            conn, anchors, relations, lexemes, mismatch, models, evidence, restriction_evidence, native, bank_relevance
        )
    mismatches.sort(key=lambda item: _canonical(item))
    validated.difference_update(item["entry_id"] for item in mismatches)
    report = {
        "format": "GSE.lexicon-replay-report/1",
        "code": "REPLAY_MISMATCH" if mismatches else "REPLAY_VALIDATED",
        "gold": "NOT_CHECKED",
        "inference_scope": "GENERALIZED_ARC_CONSISTENCY_AND_BOUNDED_JOINT_SUPPORT",
        "complete_search": (
            bool(identities)
            and len(validated) == len(identities)
            and inference_counts["entries_complete_search"] == len(identities)
        ),
        "inference_counts": dict(sorted(inference_counts.items())),
        "metadata_verification": {
            "representation_contract": representation_verification,
            "catalog": catalog_verification,
            "catalog_definition_source_ids": "NOT_PERSISTED",
            "source_diagnostics": "STRUCTURE_AND_COUNTS_CHECKED",
            "domain_restrictions": "SOURCE_PROVENANCE_AND_REPLAY_CHECKED"
            if restriction_table
            else "LEGACY_NO_RESTRICTIONS",
            "candidate_evidence": "STRUCTURE_COUNTS_AND_SOURCE_PROVENANCE_CHECKED",
            "candidate_antecedent_population_counts": "NOT_RECOMPUTED",
            "candidate_weights": "SUMS_CHECKED_ORIGINAL_WEIGHTS_NOT_PERSISTED",
            "build_report": "NOT_CHECKED",
        },
        "entries_checked": len(identities),
        "entries_validated": len(validated),
        "entries_mismatched": len({item["entry_id"] for item in mismatches if item["entry_id"] is not None}),
        "replayed_outcomes": dict(sorted(outcomes.items())),
        "mismatch_counts": dict(sorted(Counter(item["code"] for item in mismatches).items())),
        "mismatches": mismatches,
    }
    if catalog_links is not None and not mismatches:
        # Reuse the one source-observation pass and its validated authority maps.
        # This proposal changes no saved semantics and excludes model assertions.
        report["proposed_catalog"] = _native_catalog(
            anchors,
            relations,
            lexemes,
            catalog_links,
            models,
            evidence,
            restriction_evidence,
            native,
            bank_relevance,
            conn=conn,
        )
        report["metadata_verification"]["catalog"] = "RECOMPUTED_REPLACEMENT_FROM_VALIDATED_STATE"
    return report

WHOLE GSE/curation/lexicon_builder/rule_history.py 
"""Immutable rule versions and original model authority across migrations."""

from __future__ import annotations

import hashlib
from dataclasses import asdict

from GSE.namespace import current_id, identity_form

from .storage import _json

TABLES = {
    "rule_versions": "version TEXT PRIMARY KEY NOT NULL,payload TEXT NOT NULL",
    "model_rule_versions": (
        "request_id TEXT NOT NULL,entry_id TEXT NOT NULL,version TEXT NOT NULL,receipt_sha256 TEXT NOT NULL,"
        "PRIMARY KEY (request_id,receipt_sha256)"
    ),
    "rule_migrations": "event_id TEXT PRIMARY KEY NOT NULL,payload TEXT NOT NULL",
}


def digest(value):
    return hashlib.sha256(_json(identity_form(value)).encode()).hexdigest()


def receipt_binding_key(receipt):
    """A repeated typed question can produce distinct, independently bound rulings."""
    return receipt["request_id"], digest(receipt)


def relation_records(relations):
    # The canonical JSON round trip fixes tuple/list interchange without changing order.
    import json

    return json.loads(_json([asdict(rule) for rule in relations]))


def install_history(conn):
    """Install append-only tables within the caller's transaction; never commit."""
    primary_key = tuple(row[1] for row in conn.execute("PRAGMA table_info(model_rule_versions)") if row[5])
    if primary_key == ("request_id",):
        conn.execute("ALTER TABLE model_rule_versions RENAME TO model_rule_versions_legacy")
        conn.execute(f"CREATE TABLE model_rule_versions ({TABLES['model_rule_versions']})")
        conn.execute("INSERT INTO model_rule_versions SELECT * FROM model_rule_versions_legacy")
        conn.execute("DROP TABLE model_rule_versions_legacy")
    elif primary_key not in {(), ("request_id", "receipt_sha256")}:
        raise ValueError("INVALID_MODEL_RULE_VERSION_SCHEMA")
    for table, columns in TABLES.items():
        conn.execute(f"CREATE TABLE IF NOT EXISTS {table} ({columns})")
        keys = {
            "model_rule_versions": ("request_id", "receipt_sha256"),
            "rule_versions": ("version",),
            "rule_migrations": ("event_id",),
        }[table]
        equality = " AND ".join(f"{key}=NEW.{key}" for key in keys)
        for suffix, clause in (
            ("update", "BEFORE UPDATE"),
            ("delete", "BEFORE DELETE"),
            ("replace", "BEFORE INSERT"),
        ):
            condition = f" WHEN EXISTS (SELECT 1 FROM {table} WHERE {equality})" if suffix == "replace" else ""
            conn.execute(
                f"CREATE TRIGGER IF NOT EXISTS {table}_no_{suffix} {clause} ON {table}{condition} "
                "BEGIN SELECT RAISE(ABORT,'RULE_HISTORY_APPEND_ONLY'); END"
            )


def read_history(conn, current):
    """Verify hashes and indexes before any historical request gets authority."""
    from .foundation import EXCEPTION_GUARD_PREFIX
    from .rule_admission import verify_admission
    from .validation import _metadata, _read_json, _relations

    tables = {row[0] for row in conn.execute("SELECT name FROM sqlite_master WHERE type='table'")}
    present = set(TABLES) & tables
    marker = conn.execute("SELECT value FROM builder_metadata WHERE key='rule_version'").fetchone()
    if not present:
        if marker:
            raise ValueError("MISSING_RULE_HISTORY")
        if any(key.startswith(EXCEPTION_GUARD_PREFIX) for rule in current for key, _ in rule.guards):
            raise ValueError("UNREVIEWED_DEFINITION_EXCEPTION")
        return None
    if present != set(TABLES) or marker is None:
        raise ValueError("INCOMPLETE_RULE_HISTORY")
    versions = {}
    for version, payload in conn.execute("SELECT version,payload FROM rule_versions"):
        raw = _read_json(payload)
        if digest(raw) != version:
            raise ValueError("RULE_VERSION_HASH_MISMATCH")
        versions[version] = _relations(raw)
    version = digest(relation_records(current))
    if _metadata(conn, "rule_version") != version or version not in versions:
        raise ValueError("CURRENT_RULE_VERSION_MISMATCH")
    bindings = {}
    for request, entry, original, receipt_hash in conn.execute("SELECT * FROM model_rule_versions"):
        key = (request, receipt_hash)
        if original not in versions or len(receipt_hash) != 64 or key in bindings:
            raise ValueError("INVALID_MODEL_RULE_VERSION")
        bindings[key] = (entry, original)
    from .rule_revisions import reviewed_model_withdrawals, revision_relations

    events = {}
    for event_id, payload in conn.execute("SELECT event_id,payload FROM rule_migrations"):
        event = _read_json(payload)
        if digest(event) != event_id or current_id(event.get("format")) not in {
            "GSE.rule-migration-event/1",
            "GSE.rule-migration-event/2",
        }:
            raise ValueError("RULE_MIGRATION_HASH_MISMATCH")
        if event.get("from_version") not in versions or event.get("to_version") not in versions:
            raise ValueError("RULE_MIGRATION_VERSION_MISSING")
        if not isinstance(event.get("archived"), list):
            raise ValueError("INVALID_RULE_MIGRATION_ARCHIVE")
        before = versions[event["from_version"]]
        if current_id(event["format"]) == "GSE.rule-migration-event/1":
            verify_admission(event["admission"])
            if event["admission"]["warrant"].get("required_exception_ids") or event["admission"]["warrant"].get(
                "required_reservation_ids"
            ):
                raise ValueError("RULE_REQUIRES_JOINT_EXCEPTION_REVIEW")
            if event["admission"]["baseline_version"] != event["from_version"]:
                raise ValueError("RULE_MIGRATION_ADMISSION_DELTA_MISMATCH")
            expected = relation_records(before) + [event["admission"]["relation"]]
        else:
            if "previous_event" not in event:
                raise ValueError("RULE_MIGRATION_CHAIN_INVALID")
            expected = relation_records(revision_relations(conn, before, event["revision"]))
            archived = [receipt for record in event["archived"] for receipt in record["receipts"]]
            reviewed_model_withdrawals(event["revision"]["exceptions"], archived)
        if digest(expected) != event["to_version"]:
            raise ValueError("RULE_MIGRATION_ADMISSION_DELTA_MISMATCH")
        events[event_id] = event
    if not events:
        raise ValueError("MISSING_RULE_MIGRATION_EVENT")
    ordered = _event_chain(events, versions, version)
    root = versions[events[ordered[0]]["from_version"]]
    if any(key.startswith(EXCEPTION_GUARD_PREFIX) for rule in root for key, _ in rule.guards):
        raise ValueError("UNREVIEWED_DEFINITION_EXCEPTION")
    _binding_inventory(conn, bindings, [events[key] for key in ordered], tables)
    return {
        "versions": versions,
        "bindings": bindings,
        "events": [events[key] for key in ordered],
        "head": ordered[-1],
        "allow_revisions": any(current_id(events[key]["format"]) == "GSE.rule-migration-event/2" for key in ordered),
    }


def _event_chain(events, versions, current):
    """Legacy additions chain by version; revisions chain by event identity."""
    legacy = {}
    destinations = set()
    successors = {}
    for key, event in events.items():
        old, new = event["from_version"], event["to_version"]
        if old == new:
            raise ValueError("RULE_MIGRATION_CHAIN_INVALID")
        if current_id(event["format"]) == "GSE.rule-migration-event/1":
            if old in legacy or new in destinations:
                raise ValueError("RULE_MIGRATION_CHAIN_INVALID")
            legacy[old] = key
            destinations.add(new)
        else:
            parent = event["previous_event"]
            if parent is not None and (type(parent) is not str or parent not in events):
                raise ValueError("RULE_MIGRATION_CHAIN_INVALID")
            if parent in successors:
                raise ValueError("RULE_MIGRATION_CHAIN_INVALID")
            successors[parent] = key
    ordered, reached = [], set()
    if legacy:
        roots = set(legacy) - destinations
        if len(roots) != 1:
            raise ValueError("RULE_MIGRATION_CHAIN_INVALID")
        version = next(iter(roots))
        reached.add(version)
        while version in legacy:
            key = legacy[version]
            version = events[key]["to_version"]
            if version in reached:
                raise ValueError("RULE_MIGRATION_CHAIN_INVALID")
            reached.add(version)
            ordered.append(key)
        if len(ordered) != len(legacy):
            raise ValueError("RULE_MIGRATION_CHAIN_INVALID")
    elif None in successors:
        version = events[successors[None]]["from_version"]
        reached.add(version)
    else:
        raise ValueError("RULE_MIGRATION_CHAIN_INVALID")
    parent = ordered[-1] if ordered else None
    seen = set(ordered)
    while parent in successors:
        key = successors[parent]
        event = events[key]
        if key in seen or event["from_version"] != version:
            raise ValueError("RULE_MIGRATION_CHAIN_INVALID")
        version = event["to_version"]
        reached.add(version)
        ordered.append(key)
        seen.add(key)
        parent = key
    if version != current or reached != set(versions) or len(ordered) != len(events):
        raise ValueError("RULE_MIGRATION_CHAIN_INVALID")
    return ordered


def _binding_inventory(conn, bindings, events, tables):
    """Every historical binding must have exactly one active or archived receipt."""
    from .model_receipts import read_model_receipts
    from .validation import _read_json

    observed, unbound_requests = set(), set()

    def include(receipt):
        key = receipt_binding_key(receipt)
        if key not in bindings:
            unbound_requests.add(key[0])
            return
        if key in observed:
            raise ValueError("DUPLICATE_HISTORICAL_MODEL_RECEIPT")
        entry, _ = bindings[key]
        if receipt["entry_id"] != entry:
            raise ValueError("MODEL_RULE_BINDING_MISMATCH")
        observed.add(key)

    for receipts in read_model_receipts(conn).values():
        for receipt in receipts:
            include(receipt)
    for event in events:
        for archived in event["archived"]:
            for receipt in archived["receipts"]:
                include(receipt)
    if "model_reconsideration_archive" in tables:
        for event_id, payload in conn.execute("SELECT event_id,payload FROM model_reconsideration_archive"):
            archived = _read_json(payload)
            if digest(archived) != event_id:
                raise ValueError("RECONSIDERATION_ARCHIVE_HASH_MISMATCH")
            for row in archived["archived_receipts"]:
                include(row["receipt"])
    missing = set(bindings) - observed
    if any(request in unbound_requests for request, _ in missing):
        raise ValueError("MODEL_RULE_BINDING_MISMATCH")
    if missing:
        raise ValueError("MISSING_HISTORICAL_MODEL_RECEIPT")


def receipt_relations(receipt, current, context, history, *, definition=None, observations=()):
    """Replay a retained answer at its original rules outside changed scopes."""
    if history is None:
        return current
    binding = history["bindings"].get(receipt_binding_key(receipt))
    if binding is None:
        return current
    entry, version = binding
    if entry != receipt["entry_id"]:
        raise ValueError("MODEL_RULE_BINDING_MISMATCH")
    original = history["versions"][version]
    from .foundation import lexical_context
    from .rule_revisions import rule_changes, touches_scope

    removed, added = rule_changes(original, current)
    if not history.get("allow_revisions"):
        by_id = {rule.rule_id: rule for rule in current}
        if any(by_id.get(rule.rule_id) != rule for rule in original):
            raise ValueError("NONADDITIVE_RULE_HISTORY")
    if not removed and not added:
        return original
    if definition is None:
        if removed:
            raise ValueError("NONADDITIVE_RULE_HISTORY")
        affected = touches_scope(added, context)
    else:
        affected = (
            bool(removed)
            and touches_scope(removed, lexical_context(definition, observations, original))
            or bool(added)
            and touches_scope(added, lexical_context(definition, observations, current))
        )
    if affected:
        raise ValueError("HISTORICAL_MODEL_CONTEXT_AFFECTED")
    return original


def replay_archives(conn, history, native, relevant, anchors):
    """Replay archived model chains against their original rules and evidence."""
    if history is None:
        return
    from .engine import Assertion, DomainRestriction
    from .evidence import Definition
    from .validation import _provenance, _restriction_provenance

    seen = set()
    for event in history["events"]:
        relations = history["versions"][event["from_version"]]
        for archived in event["archived"]:
            definition = Definition(**archived["definition"])
            entry = definition.entry_id
            assertions = tuple(Assertion(**raw) for raw in archived["assertions"])
            restrictions = tuple(
                DomainRestriction(
                    raw["bank"],
                    tuple(raw["allowed_values"]),
                    raw["source"],
                    raw["record_id"],
                    raw["family"],
                    raw["scope"],
                )
                for raw in archived["restrictions"]
            )
            receipts = archived["receipts"]
            keys = {receipt_binding_key(row) for row in receipts}
            if not receipts or len(keys) != len(receipts) or keys & seen:
                raise ValueError("INVALID_RULE_MIGRATION_RECEIPT_CHAIN")
            prefix = archived.get("retained_prefix", [])
            if type(prefix) is not list or any(
                receipt_binding_key(row) not in history["bindings"] or row["entry_id"] != entry for row in prefix
            ):
                raise ValueError("INVALID_RULE_MIGRATION_RETAINED_PREFIX")
            seen.update(keys)
            _restriction_provenance(entry, restrictions, native)
            _provenance(
                entry,
                assertions,
                definition,
                relations,
                native,
                relevant,
                anchors,
                {entry: prefix + receipts},
                conn,
                tuple(archived["evidence_banks"]),
                restrictions,
                rule_history=history,
            )

