W/'candidate.db')\n if candidate_sha!=writer['after_sha256']:raise ValueError('INTEGRATED_GATE_CANDIDATE_HEAD_CHANGED')\n binding={'lexicon_sha256':candidate_sha,'source_head':subprocess.check_output(['git','rev-parse','HEAD'],text=True).strip(),'source_freeze_pins':list(pins.values()),'tracked_gate_input_pins':inventory,'runtime_freeze_receipt_sha256':sha(N/'ssl-api-runtime-result.json'),'builder_freeze_receipt_sha256':sha(N/'ssl-api-controller-source-freeze.json')}\n save(phase,{'code':'INTEGRATED_REPOSITORY_GATE_RUNNING','updated_utc':now(),**binding})\n command=['bash','scripts/ci_local.sh']; log=N/'ssl-api-controller-integrated-gate-output.log'\n with log.open('x') as stream:\n  completed=subprocess.run(command,cwd=ROOT,stdout=stream,stderr=subprocess.STDOUT,timeout=10800)\n verify(pins.values())\n changed=[f for f,v in inventory.items() if not (ROOT/f).is_file() or sha(ROOT/f)!=v]\n if changed:raise ValueError('GATE_INPUTS_CHANGED_DURING_EXECUTION:'+repr(changed))\n currentb=read(N/'ssl-api-runtime-result.json')\n if currentb.get('source_edits_finished') is not True or currentb.get('status')!='CODE_FREEZE_READY':raise ValueError('RUNTIME_UNFROZEN_DURING_GATE')\n result={'format':'GSE.checkpoint-repository-gate/1','code':'REPOSITORY_GATE_PASSED' if completed.returncode==0 else 'REPOSITORY_GATE_FAILED','command':command,'exit_code':completed.returncode,'finished_utc':now(),'log':str(log),'log_sha256':sha(log),**binding,'activation_performed':False,'usable_checkpoint_accepted':False}\n save(N/'ssl-api-controller-integrated-gate.json',result);save(phase,result)\n save(N/'ssl-api-controller-integrated-gate-exit.json',{'exit_code':completed.returncode,'finished_utc':now()})\n if completed.returncode:raise SystemExit(completed.returncode)\nexcept BaseException as error:\n if not (N/'ssl-api-controller-integrated-gate-exit.json').exists():\n  save(phase,{'code':'INTEGRATED_GATE_STOPPED','updated_utc':now(),'error_type':type(error).__name__,'error':str(error),'activation_performed':False})\n  save(N/'ssl-api-controller-integrated-gate-exit.json',{'exit_code':1,'finished_utc':now(),'error_type':type(error).__name__,'error':str(error)})\n traceback.print_exc();raise\n",
