### GSE/curation/lexicon_builder/source_enrichment.py
"""Add verified native context to a new candidate without changing any bank.

Old model decisions bind their exact native observations. This boundary refuses
affected active or rule-migration-archived chains: reconsideration is a separate
operation, never an incidental side effect of adding source context.
"""

from __future__ import annotations

import hashlib
import json
import os
import sqlite3
import tempfile
from collections import defaultdict
from contextlib import closing
from dataclasses import asdict
from pathlib import Path

from GSE.namespace import current_id, identity_form

from .evidence import Observation
from .interchange import read_json
from .model_receipts import read_model_receipts
from .storage import _json, store_observations
from .validation import validate_build

FORMAT = "GSE.source-enrichment-input/1"


def _digest(value):
    return hashlib.sha256(_json(identity_form(value)).encode("utf-8")).hexdigest()


def _file_digest(path):
    with Path(path).open("rb") as handle:
        return hashlib.file_digest(handle, "sha256").hexdigest()


def _identifier(value):
    return '"' + value.replace('"', '""') + '"'


def _inventory(conn, added_ids=frozenset()):
    """Fingerprint every schema object and table row, excluding only additions."""
    schema = [tuple(row) for row in conn.execute("SELECT type,name,tbl_name,sql FROM sqlite_master ORDER BY type,name")]
    tables = {}
    for kind, name, _, _ in schema:
        if kind != "table":
            continue
        columns = [row[1] for row in conn.execute(f"PRAGMA table_info({_identifier(name)})")]
        order = ",".join(_identifier(column) for column in columns)
        count, digest = 0, hashlib.sha256()
        record_index = columns.index("record_id") if name == "source_observations" else None
        for row in conn.execute(f"SELECT * FROM {_identifier(name)} ORDER BY {order}"):
            if record_index is not None and row[record_index] in added_ids:
                continue
            encoded = _json(
                [{"sqlite_blob_hex": value.hex()} if isinstance(value, bytes) else value for value in row]
            ).encode("utf-8")
            digest.update(len(encoded).to_bytes(8, "big"))
            digest.update(encoded)
            count += 1
        tables[name] = {"rows": count, "sha256": digest.hexdigest()}
    return {"schema_sha256": _digest(schema), "tables": tables}


def _definition(conn, entry):
    row = conn.execute(
        "SELECT d.entry_id,l.lemma,l.pos,l.gloss FROM definition_states d "
        "JOIN lexemes l ON l.id=d.lexeme_id WHERE d.entry_id=?",
        (entry,),
    ).fetchone()
    if row is None:
        raise ValueError("ENRICHMENT_DEFINITION_NOT_FOUND")
    return dict(zip(("entry_id", "lemma", "pos", "definition"), row, strict=True))


def _observations(value):
    if type(value) is not dict or set(value) != {"format", "observations"} or current_id(value["format"]) != FORMAT:
        raise ValueError("INVALID_SOURCE_ENRICHMENT_INPUT")
    if type(value["observations"]) is not list or not value["observations"]:
        raise ValueError("SOURCE_ENRICHMENT_REQUIRES_OBSERVATIONS")
    records = []
    for raw in value["observations"]:
        if (
            type(raw) is not dict
            or set(raw) != {"entry_id", "source", "record_id", "family", "features", "scope", "candidate_entry_ids"}
            or type(raw["candidate_entry_ids"]) is not list
        ):
            raise ValueError("INVALID_SOURCE_ENRICHMENT_OBSERVATION")
        observation = Observation(
            entry_id=raw["entry_id"],
            source=raw["source"],
            record_id=raw["record_id"],
            family=raw["family"],
            features=raw["features"],
            scope=raw["scope"],
            candidate_entry_ids=tuple(raw["candidate_entry_ids"]),
        )
        if observation.entry_id is None or observation.candidate_entry_ids != (observation.entry_id,):
            raise ValueError("ENRICHMENT_REQUIRES_EXACT_DEFINITION")
        if observation.scope != "lexical":
            raise ValueError("ENRICHMENT_REQUIRES_LEXICAL_CONTEXT")
        records.append(observation)
    if len({record.record_id for record in records}) != len(records):
        raise ValueError("DUPLICATE_ENRICHMENT_OBSERVATION")
    return tuple(records)


def _construct(conn, observation):
    """Validate structure and bind it to the candidate's original native root."""
    definition = _definition(conn, observation.entry_id)
    if observation.source == "wiktionary":
        from .evidence import native_reference_observation

        packet = observation.features.get("native_reference")
        expected = native_reference_observation(packet)
        root = packet["source_entry"]
        if any(root[key] != definition[key] for key in definition):
            raise ValueError("ENRICHMENT_NATIVE_ROOT_DEFINITION_MISMATCH")
        matches = [
            json.loads(row[0])
            for row in conn.execute(
                "SELECT payload FROM source_observations WHERE entry_id=? AND source='wiktionary'",
                (observation.entry_id,),
            )
        ]
        if not any(_json(identity_form(record["features"])) == _json(identity_form(root)) for record in matches):
            raise ValueError("ENRICHMENT_ORIGINAL_NATIVE_ROOT_MISSING")
    elif observation.source == "wordnet_hierarchy":
        from .wordnet_identity import wordnet_identity_observation

        packet = observation.features.get("definition_identity")
        expected = wordnet_identity_observation(packet, definition)
        row = conn.execute(
            "SELECT payload FROM source_observations WHERE record_id=? AND entry_id=? AND source='wordnet_hierarchy'",
            (observation.entry_id, observation.entry_id),
        ).fetchone()
        if row is None:
            raise ValueError("ENRICHMENT_ORIGINAL_NATIVE_ROOT_MISSING")
        native = json.loads(row[0])["features"]
        if any(native.get(key) != definition[key] for key in ("lemma", "pos", "definition")):
            raise ValueError("ENRICHMENT_NATIVE_ROOT_DEFINITION_MISMATCH")
        if native.get("synset_name") != packet["native_synset"]["name"]:
            raise ValueError("ENRICHMENT_NATIVE_ROOT_SYNSET_MISMATCH")
        if any(native.get(key) != packet["native_synset"][key] for key in ("lemma_names", "lexname")):
            raise ValueError("ENRICHMENT_NATIVE_ROOT_WITNESS_MISMATCH")
        if "defining_ancestry" in packet:
            paths = native.get("hypernym_paths")
            if (
                type(paths) is not list
                or any(type(path) is not list or any(type(name) is not str for name in path) for path in paths)
                or sorted(map(_json, paths)) != sorted(map(_json, packet["defining_ancestry"]["paths"]))
            ):
                raise ValueError("ENRICHMENT_NATIVE_ROOT_ANCESTRY_MISMATCH")
    else:
        raise ValueError("UNSUPPORTED_SOURCE_ENRICHMENT")
    if _json(identity_form(asdict(expected))) != _json(identity_form(asdict(observation))):
        raise ValueError("ENRICHMENT_OBSERVATION_CONSTRUCTOR_MISMATCH")
    return definition


def _verify_wiktionary(observations, source):
    if not observations:
        return
    if source is None:
        raise ValueError("ENRICHMENT_WIKTIONARY_SOURCE_REQUIRED")
    from GSE.curation.external_sources.wiktionary import WiktionaryParser

    from .evidence import native_reference_observation

    parser = WiktionaryParser(data_path=Path(source))
    if not parser.load():
        raise ValueError("ENRICHMENT_WIKTIONARY_SOURCE_UNAVAILABLE")
    roots = {_json(record.features["native_reference"]["source_entry"]) for record in observations}
    words = tuple(sorted({record.features["native_reference"]["source_entry"]["word"] for record in observations}))
    entries = tuple(entry for entry in parser.get_definition_entries(words) if _json(asdict(entry)) in roots)
    if {_json(asdict(entry)) for entry in entries} != roots:
        raise ValueError("ENRICHMENT_WIKTIONARY_SOURCE_ROOT_MISMATCH")
    verified = {
        _json(asdict(native_reference_observation(dict(packet))))
        for packet in parser.get_definition_references(entries)
    }
    if any(_json(asdict(record)) not in verified for record in observations):
        raise ValueError("ENRICHMENT_WIKTIONARY_SOURCE_REFERENCE_MISMATCH")


def _verify_wordnet(observations, definitions):
    if not observations:
        return
    from nltk.corpus import wordnet

    from GSE.curation.external_sources.wordnet_hierarchy import WordNetHierarchyParser

    from .wordnet_identity import (
        DEFINING_CONTEXT_FORMAT,
        wordnet_defining_context,
        wordnet_identity_evidence,
        wordnet_identity_observation,
    )

    # Refuse unavailable local data before the legacy parser can download it.
    try:
        wordnet.ensure_loaded()
    except LookupError as error:
        raise ValueError("ENRICHMENT_LOCAL_WORDNET_UNAVAILABLE") from error
    parser = WordNetHierarchyParser()
    if not parser.load():
        raise ValueError("ENRICHMENT_LOCAL_WORDNET_UNAVAILABLE")
    for record in observations:
        definition = definitions[record.entry_id]
        packet = record.features["definition_identity"]
        synset = wordnet.synset(packet["native_synset"]["name"])
        constructor = (
            wordnet_defining_context
            if current_id(packet["format"]) == DEFINING_CONTEXT_FORMAT
            else wordnet_identity_evidence
        )
        fresh = constructor(parser, definition["lemma"], synset, pos=definition["pos"])
        if _json(identity_form(asdict(wordnet_identity_observation(fresh, definition)))) != _json(
            identity_form(asdict(record))
        ):
            raise ValueError("ENRICHMENT_WORDNET_SOURCE_IDENTITY_MISMATCH")


def _refuse_bound_receipts(conn, entries):
    if set(read_model_receipts(conn)) & entries:
        raise ValueError("ENRICHMENT_REQUIRES_MODEL_RECONSIDERATION")
    if conn.execute("SELECT 1 FROM sqlite_master WHERE type='table' AND name='rule_migrations'").fetchone():
        for (payload,) in conn.execute("SELECT payload FROM rule_migrations"):
            event = json.loads(payload)
            if any(record["definition"]["entry_id"] in entries for record in event["archived"]):
                raise ValueError("ENRICHMENT_RULE_ARCHIVE_CONTEXT_BOUND")


def enrich_sources(source, output, input_path, *, wiktionary_source=None):
    """Create a separate replayed successor containing only new native context."""
    from GSE.lexicon_resource import ACTIVE_POINTER, resolve_lexicon_path

    source = Path(source).expanduser().resolve()
    requested = Path(output).expanduser().absolute()
    if requested.is_symlink() or requested.exists():
        raise ValueError("ENRICHMENT_OUTPUT_MUST_BE_NEW")
    output = requested.resolve()
    if not source.is_file():
        raise ValueError("BUILD_NOT_FOUND")
    if output.suffix != ".db":
        raise ValueError("ENRICHMENT_OUTPUT_REQUIRES_DATABASE_PATH")
    active = resolve_lexicon_path().resolve()
    if source == active or active.exists() and source.samefile(active) or output == active:
        raise ValueError("ENRICHMENT_CANDIDATE_MUST_NOT_BE_ACTIVE")
    if output == source or output == Path(input_path).resolve():
        raise ValueError("ENRICHMENT_PATH_COLLISION")
    pointer = ACTIVE_POINTER.read_bytes() if ACTIVE_POINTER.exists() else None
    raw = read_json(input_path)
    records = _observations(raw)
    source_hash = _file_digest(source)
    fd, name = tempfile.mkstemp(prefix=".gse-enrichment-", suffix=".db", dir=output.parent)
    os.close(fd)
    temporary = Path(name)
    try:
        with closing(sqlite3.connect(source.as_uri() + "?mode=ro", uri=True)) as original:
            revision = original.execute("PRAGMA data_version").fetchone()[0]
            original.execute("BEGIN")
            with closing(sqlite3.connect(temporary)) as conn:
                original.backup(conn)
            snapshot_hash = _file_digest(temporary)
            preflight = validate_build(temporary)
            if preflight["code"] != "REPLAY_VALIDATED" or not preflight["complete_search"]:
                raise ValueError("ENRICHMENT_REQUIRES_COMPLETE_REPLAY")
            with closing(sqlite3.connect(temporary)) as conn:
                definitions = {record.entry_id: _construct(conn, record) for record in records}
                _refuse_bound_receipts(conn, set(definitions))
                for record in records:
                    if conn.execute(
                        "SELECT 1 FROM source_observations WHERE record_id=?", (record.record_id,)
                    ).fetchone():
                        raise ValueError("ENRICHMENT_OBSERVATION_ALREADY_PRESENT")
                _verify_wiktionary(tuple(r for r in records if r.source == "wiktionary"), wiktionary_source)
                _verify_wordnet(tuple(r for r in records if r.source == "wordnet_hierarchy"), definitions)
                before = _inventory(conn)
                with conn:
                    store_observations(conn, records)
                after = _inventory(conn, frozenset(record.record_id for record in records))
                if before != after:
                    raise ValueError("ENRICHMENT_CHANGED_EXISTING_STATE")
            postflight = validate_build(temporary)
            if postflight["code"] != "REPLAY_VALIDATED" or not postflight["complete_search"]:
                raise ValueError("ENRICHMENT_POST_REPLAY_FAILED:" + _json(postflight.get("mismatch_counts")))
            original.rollback()
            if original.execute("PRAGMA data_version").fetchone()[0] != revision or _file_digest(source) != source_hash:
                raise ValueError("ENRICHMENT_SOURCE_CHANGED")
            if pointer != (ACTIVE_POINTER.read_bytes() if ACTIVE_POINTER.exists() else None):
                raise ValueError("ENRICHMENT_ACTIVE_POINTER_CHANGED")
            report = {
                "format": "GSE.source-enrichment/1",
                "code": "ENRICHED_CANDIDATE",
                "source": str(source),
                "candidate": str(output),
                "source_file_sha256": source_hash,
                "source_snapshot_sha256": snapshot_hash,
                "candidate_sha256": _file_digest(temporary),
                "input_sha256": _digest(raw),
                "added_observations": [asdict(record) for record in records],
                "added_records": len(records),
                "affected_entries": sorted(definitions),
                "preexisting_state": before,
                "preexisting_state_unchanged": True,
                "preflight": preflight,
                "postflight": postflight,
                "model_calls": 0,
                "bank_changes": 0,
                "activation_performed": False,
                "active_pointer_unchanged": True,
            }
            # Same-filesystem exclusive install: no existing path can be replaced.
            os.link(temporary, output)
            return report
    finally:
        temporary.unlink(missing_ok=True)


def _refresh_unweighted_discovery(conn):
    """Rebuild native diagnostics after a source assertion changes."""
    from .completion import _set_metadata
    from .discovery import BankObservation, discover_relations
    from .storage import store_candidates
    from .validation import _metadata

    if conn.execute("SELECT 1 FROM candidate_evidence WHERE json_extract(payload,'$.weight') != 1 LIMIT 1").fetchone():
        raise ValueError("SOURCE_REVISION_REQUIRES_ORIGINAL_DISCOVERY_WEIGHTS")
    observations = tuple(
        BankObservation(entry, bank, value, source, record_id, family, scope=scope)
        for entry, bank, value, source, record_id, family, scope in conn.execute(
            """SELECT a.entry_id, json_extract(a.payload,'$.bank'),
                      json_extract(a.payload,'$.value'), o.source, o.record_id, o.family, o.scope
               FROM builder_assertions a JOIN source_observations o
                 ON o.record_id=json_extract(a.payload,'$.record_id')
                AND o.source=json_extract(a.payload,'$.source')
                AND o.entry_id=a.entry_id
               WHERE o.scope='lexical' AND o.family NOT IN ('model','derived')
                 AND o.source NOT LIKE 'model:%' AND o.source NOT LIKE 'rule:%' AND o.source NOT LIKE 'derived:%'"""
        )
    )
    candidates = discover_relations(observations, cross_source=True)
    conn.execute("DELETE FROM candidate_evidence")
    conn.execute("DELETE FROM candidate_relations")
    summary = store_candidates(conn, candidates)
    _set_metadata(conn, "candidate_relations", summary)
    report = _metadata(conn, "last_report")
    report["candidate_relations"] = summary["records"]
    _set_metadata(conn, "last_report", report)
    return summary


def revise_source_candidate(candidate, output, baseline, apply_revision, *, format_tag, metadata_key):
    """Replay a reviewed source transition on a private copy of a pinned baseline."""
    from GSE.lexicon_resource import ACTIVE_POINTER, resolve_lexicon_path

    from .completion import _refresh_coverage, _set_metadata
    from .sqlite_snapshot import copy_database

    candidate = Path(candidate).resolve(strict=True)
    output = Path(output).absolute()
    if output.exists() or output.is_symlink() or output.suffix != ".db":
        raise ValueError("SOURCE_REVISION_OUTPUT_MUST_BE_NEW_DATABASE")
    output = output.resolve()
    active = resolve_lexicon_path().resolve()
    if output == active or output == candidate:
        raise ValueError("SOURCE_REVISION_REQUIRES_SEPARATE_CANDIDATE")
    replay = baseline["replay"]
    source_hash = _file_digest(candidate)
    pointer_hash = _file_digest(ACTIVE_POINTER)
    if (
        source_hash != baseline["candidate_sha256"]
        or pointer_hash != baseline["active_pointer_sha256"]
        or replay["code"] != "REPLAY_VALIDATED"
        or not replay["complete_search"]
        or replay["entries_mismatched"]
        or replay["entries_validated"] != replay["entries_checked"]
    ):
        raise ValueError("SOURCE_REVISION_REQUIRES_PINNED_REPLAY")
    with tempfile.TemporaryDirectory(prefix=".gse-source-revision-", dir=output.parent) as directory:
        snapshot = Path(directory) / "snapshot.db"
        copy_database(candidate, snapshot)
        with closing(sqlite3.connect(snapshot.as_uri() + "?mode=rw", uri=True)) as conn:
            conn.row_factory = sqlite3.Row
            with conn:
                changes = apply_revision(conn)
                discovery = _refresh_unweighted_discovery(conn)
                coverage = _refresh_coverage(conn)
                _set_metadata(
                    conn,
                    metadata_key,
                    {"format": format_tag, "baseline_sha256": source_hash, "changes": changes},
                )
        replayed = validate_build(snapshot)
        if (
            replayed["code"] != "REPLAY_VALIDATED"
            or not replayed["complete_search"]
            or replayed["entries_checked"] != replay["entries_checked"]
            or replayed["entries_mismatched"]
        ):
            raise ValueError("SOURCE_REVISION_REPLAY_FAILED:" + _json(replayed["mismatch_counts"]))
        if _file_digest(candidate) != source_hash or _file_digest(ACTIVE_POINTER) != pointer_hash:
            raise ValueError("SOURCE_REVISION_INPUT_CHANGED")
        candidate_hash = _file_digest(snapshot)
        os.link(snapshot, output)
    return {
        "format": format_tag,
        "code": "SOURCE_PROJECTION_REVISED_AND_REPLAYED",
        "candidate": str(output),
        "candidate_sha256": candidate_hash,
        "baseline_sha256": source_hash,
        "active_pointer_sha256": pointer_hash,
        "activation_performed": False,
        "changes": changes,
        "discovery": discovery,
        "coverage": coverage["cells"],
        "replay": replayed,
    }


def wiktionary_projection_scope(conn, bank, *, pending_only=False):
    """Collect the exact native noun records for a supported source projection."""
    from .evidence import Definition, wiktionary_definition_projection

    scope = defaultdict(list)
    for identity, lemma, gloss, raw in conn.execute(
        """SELECT d.entry_id, l.lemma, l.gloss, o.payload
           FROM definition_states d JOIN lexemes l ON l.id=d.lexeme_id
           JOIN source_observations o ON o.entry_id=d.entry_id
           WHERE l.pos='noun' AND o.source='wiktionary' AND o.family='wiktionary' AND o.scope='lexical'
             AND json_array_length(o.payload,'$.features.native_sense.glosses')=1
             AND (? != 'BODY' OR EXISTS (
                 SELECT 1 FROM json_each(o.payload,'$.features.native_sense.topics') WHERE value='anatomy'
             ))
             AND (NOT ? OR NOT EXISTS (
                 SELECT 1 FROM builder_assertions a WHERE a.entry_id=d.entry_id
                   AND json_extract(a.payload,'$.source')='wiktionary'
                   AND json_extract(a.payload,'$.bank')=?
                   AND json_extract(a.payload,'$.record_id')=o.record_id
             ))
           ORDER BY d.entry_id,o.record_id""",
        (bank, pending_only, bank),
    ):
        source = json.loads(raw)
        definition = Definition(identity, lemma, "noun", gloss, (source["record_id"],))
        if wiktionary_definition_projection(definition, source["features"]).get(bank) == 1:
            scope[identity].append(source)
    return scope


def forecast_wiktionary_projection(conn, scope, bank, *, apply=False):
    """Reclose the exact scope with native evidence and reject an unsafe transition."""
    from .completion import _contexts, _entry, _prepare_context_index
    from .engine import Assertion
    from .foundation import BANKS, lexical_context
    from .resolution import resolve_dictionary
    from .rule_history import digest
    from .storage import store_entry
    from .validation import _metadata, _relations

    _refuse_bound_receipts(conn, set(scope))
    for table in ("model_rule_versions", "model_reconsideration_archive"):
        if conn.execute(
            f"SELECT 1 FROM {table} WHERE entry_id IN (SELECT value FROM json_each(?)) LIMIT 1",
            (json.dumps(list(scope)),),
        ).fetchone():
            raise ValueError("WIKTIONARY_HISTORICAL_MODEL_CONTEXT_BOUND")
    _prepare_context_index(conn)
    observations, relevance = _contexts(conn, tuple(scope), indexed=True)
    relations = _relations(_metadata(conn, "relations"))
    changes = []
    for entry_id, sources in scope.items():
        definition, assertions, restrictions, hierarchy = _entry(conn, entry_id)
        [raw] = conn.execute("SELECT domains FROM definition_states WHERE entry_id=?", (entry_id,)).fetchone()
        old = json.loads(raw)
        additions = tuple(Assertion(bank, 1, "wiktionary", source["record_id"], "wiktionary") for source in sources)
        if any(a in assertions for a in additions) or 1 not in old[bank]:
            raise ValueError("WIKTIONARY_PROJECTION_REQUIRES_REVIEW:" + entry_id)
        state = resolve_dictionary(
            BANKS,
            assertions + additions,
            relations,
            lexical_context(definition, observations[entry_id], relations),
            evidence_banks=tuple(sorted(relevance[entry_id])),
            domain_restrictions=restrictions,
        )
        new = {name: sorted(values) for name, values in state.domains.items()}
        if (
            state.code == "CONFLICT"
            or any(row["kind"] in {"SOLVER_LIMIT", "CONDITIONAL_EXCEPTION"} for row in state.trace)
            or new[bank] != [1]
            or any(not set(new[name]).issubset(old[name]) for name in BANKS)
        ):
            raise ValueError("WIKTIONARY_CLOSURE_REQUIRES_REVIEW:" + entry_id)
        changes.append(
            {
                "entry_id": entry_id,
                "source_sha256": [digest(source) for source in sources],
                "assertions": [asdict(assertion) for assertion in additions],
                "domains": [
                    {"bank": name, "before": old[name], "after": new[name]} for name in BANKS if old[name] != new[name]
                ],
            }
        )
        if apply:
            store_entry(conn, definition, state, assertions + additions, hierarchy, domain_restrictions=restrictions)
    return changes


### GSE/curation/lexicon_builder/foundation.py
"""Versioned representation conventions, separate from corpus-discovered rules.

These are the founder-approved projection laws, not a claim that NSM's full
prime explications have already been compiled. Additional justified relations
and hand-reviewed definition anchors enter through the build manifest.
"""

import hashlib
import json
import re
from itertools import product
from pathlib import Path
from urllib.parse import quote

from GSE.curation.schema import ALL_PRIMITIVES, BIPOLAR_PAIRS
from GSE.namespace import current_id

from .definition_frames import (
    NATIVE_FRAME_PREFIX,
    NATIVE_NOUN_FRAMES,
    WIKTIONARY_ANATOMY_FRAME_PREFIX,
    WIKTIONARY_ANATOMY_FRAMES,
    native_noun_frames,
    wiktionary_anatomy_frame,
)
from .engine import Assertion, Relation
from .interchange import read_json

FOUNDER_SOURCE = "docs/program/LEXICON_FOUNDER_WORDS_2026-10-24.md"
DESIGN_SOURCE = "docs/program/LEXICON_CONSTRUCTION_DESIGN.md"
CONVENTION_VERSION = "GSE.lexicon-conventions/2026-10-29"
WANT_POLARITY = {-1: "NOT_WANT", 0: "ORTHOGONAL_TO_WANTING", 1: "WANT"}
ORDINAL_INTENSITY = {"VERY": 1, "EXTREMELY": 2}
NEGATIVE_POLES = {negative: positive for positive, negative in BIPOLAR_PAIRS}
BANKS = tuple(p for p in ALL_PRIMITIVES if p not in NEGATIVE_POLES and p not in {"NUMBER", "HIER_PLUS", "HIER_MINUS"})
POS_NAMES = {
    "n": "noun",
    "v": "verb",
    "a": "adjective",
    "s": "adjective",
    "r": "adverb",
    "adj": "adjective",
    "adv": "adverb",
}


def representation_contract() -> dict:
    """Pin supported ordinal laws and fingerprint the lexical basis explicitly.

    Other historical ordinal tables are not silently promoted to authority.
    A conflicting runtime mapping requires an explicit representation migration.
    """
    from GSE.primitives_v2 import get_hierarchy_encoding

    for modifier, level in ORDINAL_INTENSITY.items():
        if get_hierarchy_encoding(modifier) != ("INTENSITY", level, abs(level)):
            raise ValueError("ORDINAL_REPRESENTATION_DRIFT")
    return {
        "version": CONVENTION_VERSION,
        "basis": list(BANKS),
        "basis_sha256": hashlib.sha256(json.dumps(BANKS, separators=(",", ":")).encode()).hexdigest(),
        "want_polarity": {str(k): v for k, v in WANT_POLARITY.items()},
        "ordinal_intensity": dict(ORDINAL_INTENSITY),
        "ordinal_source": DESIGN_SOURCE + "#ordinal-stability",
        "other_ordinal_levels": "EXPLICIT_JUSTIFIED_MANIFEST_ONLY",
    }


def definition_context(pos: str) -> dict[str, str]:
    """Keep unknown POS unknown; only explicit lexical types activate a law."""
    normalized = pos.lower()
    return {"pos": POS_NAMES.get(normalized, normalized)}


_WORDNET_SYNSET = re.compile(r"[^\s:]+\.[nvasr]\.(?:0[1-9]|[1-9][0-9]+)\Z")
_ANCESTOR_PREFIX = "wordnet_ancestor:"


EXCEPTION_GUARD_PREFIX = "except_entry:"
WORDNET_OUTSIDE_ANCESTOR_PREFIX = "wordnet_outside_ancestor:"
WORDNET_OTHER_SYNSET_PREFIX = "wordnet_other_than_synset:"
WORDNET_ANCESTRY_GUARD_PREFIXES = (
    _ANCESTOR_PREFIX,
    WORDNET_OUTSIDE_ANCESTOR_PREFIX,
    WORDNET_OTHER_SYNSET_PREFIX,
)


def valid_lexical_guard(key, value) -> bool:
    """Recognize lexical scope predicates, never bank values or inferred signs."""
    if not isinstance(key, str) or not isinstance(value, str):
        return False
    if key == "pos":
        return bool(value.strip())
    if key == "wordnet_native_lemma":
        return value == "true"
    if key.startswith(NATIVE_FRAME_PREFIX):
        return value == "true" and key.removeprefix(NATIVE_FRAME_PREFIX) in NATIVE_NOUN_FRAMES
    if key.startswith(WIKTIONARY_ANATOMY_FRAME_PREFIX):
        return value == "true" and key.removeprefix(WIKTIONARY_ANATOMY_FRAME_PREFIX) in WIKTIONARY_ANATOMY_FRAMES
    if key.startswith(EXCEPTION_GUARD_PREFIX):
        identity = key.removeprefix(EXCEPTION_GUARD_PREFIX)
        return bool(identity) and not any(char.isspace() for char in identity) and value == "true"
    return value == "true" and any(
        key.startswith(prefix) and _WORDNET_SYNSET.fullmatch(key.removeprefix(prefix)) is not None
        for prefix in WORDNET_ANCESTRY_GUARD_PREFIXES
    )


def validate_lexical_guards(relations) -> tuple[str, ...]:
    """Refuse unsupported scope schemas, including for empty build populations."""
    requested = set()
    for relation in relations:
        for key, value in relation.guards:
            if not valid_lexical_guard(key, value):
                raise ValueError("UNSUPPORTED_LEXICAL_GUARD")
            for prefix in WORDNET_ANCESTRY_GUARD_PREFIXES:
                if key.startswith(prefix):
                    requested.add(key.removeprefix(prefix))
    return tuple(sorted(requested))


def _field(record, name):
    return record.get(name) if isinstance(record, dict) else getattr(record, name, None)


def _exact_wordnet_ancestry(definition, observation) -> frozenset[str]:
    """Read a complete exact native witness; malformed/mismatched data abstains.

    Native paths include the synset itself. Aliases are not guessed: both the
    definition identity and each path must name the recorded canonical synset.
    Candidate links and association observations supply no membership authority.
    """
    entry_id = _field(definition, "entry_id")
    if (
        _field(observation, "source") != "wordnet_hierarchy"
        or _field(observation, "scope") != "lexical"
        or _field(observation, "entry_id") != entry_id
        or _field(observation, "record_id") != entry_id
    ):
        return frozenset()
    features = _field(observation, "features")
    if not isinstance(features, dict):
        return frozenset()
    lemma, pos, gloss = (_field(definition, name) for name in ("lemma", "pos", "definition"))
    synset = features.get("synset_name")
    native_pos = features.get("pos")
    if (
        not isinstance(synset, str)
        or _WORDNET_SYNSET.fullmatch(synset) is None
        or not isinstance(lemma, str)
        or not isinstance(pos, str)
        or not isinstance(native_pos, str)
        or not isinstance(gloss, str)
        or not gloss.strip()
        or features.get("lemma") != lemma
        or features.get("definition") != gloss
        or entry_id != f"wordnet:{quote(lemma, safe='')}:{quote(synset, safe='')}"
        or definition_context(native_pos) != definition_context(pos)
        or definition_context(synset.rsplit(".", 2)[1]) != definition_context(pos)
    ):
        return frozenset()
    paths = features.get("hypernym_paths")
    if not isinstance(paths, (list, tuple)) or not paths:
        return frozenset()
    ancestors = set()
    for path in paths:
        if (
            not isinstance(path, (list, tuple))
            or not path
            or any(not isinstance(node, str) or _WORDNET_SYNSET.fullmatch(node) is None for node in path)
            or path[-1] != synset
            or len(set(path)) != len(path)
            or any(node.rsplit(".", 2)[1] != synset.rsplit(".", 2)[1] for node in path)
        ):
            return frozenset()
        ancestors.update(path)
    return frozenset(ancestors)


def _attested_wordnet_lemma(definition, observation) -> bool:
    """Test the native spelling after an exact WordNet identity check."""
    names = _field(observation, "features").get("lemma_names")
    return (
        isinstance(names, (list, tuple))
        and bool(names)
        and all(isinstance(name, str) and name.strip() for name in names)
        and _field(definition, "lemma").casefold().replace("_", " ")
        in {name.casefold().replace("_", " ") for name in names}
    )


def native_frame_source(definition, observation) -> str | None:
    """Return the native sense group for an exact WordNet or Wiktionary witness."""
    source = _field(observation, "source")
    features = _field(observation, "features")
    if source == "wordnet_hierarchy":
        if _exact_wordnet_ancestry(definition, observation) and _attested_wordnet_lemma(definition, observation):
            return "wordnet:" + features["synset_name"]
        return None
    entry_id = _field(definition, "entry_id")
    if (
        source != "wiktionary"
        or _field(observation, "family") != "wiktionary"
        or _field(observation, "scope") != "lexical"
        or _field(observation, "entry_id") != entry_id
        or not isinstance(features, dict)
        or current_id(features.get("identity_scheme")) != "GSE.wiktionary-native-leaf/1"
        or any(features.get(field) != _field(definition, field) for field in ("entry_id", "lemma", "pos", "definition"))
    ):
        return None
    sense = features.get("native_sense")
    native_id, word = features.get("native_id"), features.get("word")
    if (
        not isinstance(sense, dict)
        or sense.get("glosses") != [features["definition"]]
        or any(key in sense for key in ("alt_of", "form_of"))
        or not isinstance(sense.get("tags", []), list)
        or any(tag in ("figuratively", "figurative", "metaphorical") for tag in sense.get("tags", []))
        or not isinstance(native_id, str)
        or not native_id
        or not isinstance(word, str)
        or not word
    ):
        return None
    from .evidence import _record_id

    if _field(observation, "record_id") != _record_id("wiktionary", word, features):
        return None
    return "wiktionary:" + native_id


def lexical_context(definition, observations, relations) -> dict[str, str]:
    """Add only requested predicates supported by exact native witnesses.

    Accept typed Definition/Observation objects or their serialized dictionaries.
    Missing witnesses remain absent, never false or a bank zero. With no source
    guards, the result is byte-for-byte equivalent to the old POS-only context;
    unrelated source context cannot perturb historical model request identities.
    """
    context = definition_context(_field(definition, "pos"))
    requested = validate_lexical_guards(relations)
    native_lemma_requested = any(key == "wordnet_native_lemma" for rule in relations for key, _ in rule.guards)
    frame_guards = {key for rule in relations for key, _ in rule.guards if key.startswith(NATIVE_FRAME_PREFIX)}
    gloss = _field(definition, "definition")
    if frame_guards and context.get("pos") == "noun" and isinstance(gloss, str):
        matched = frame_guards.intersection(NATIVE_FRAME_PREFIX + frame for frame in native_noun_frames(gloss))
        if matched and any(native_frame_source(definition, row) for row in observations):
            context.update(dict.fromkeys(sorted(matched), "true"))
    anatomy_guards = {
        key for rule in relations for key, _ in rule.guards if key.startswith(WIKTIONARY_ANATOMY_FRAME_PREFIX)
    }
    if anatomy_guards and context.get("pos") == "noun" and isinstance(gloss, str):
        for observation in observations:
            if _field(observation, "source") != "wiktionary" or not native_frame_source(definition, observation):
                continue
            frame = wiktionary_anatomy_frame(gloss, "noun", _field(observation, "features")["native_sense"])
            if frame is not None and WIKTIONARY_ANATOMY_FRAME_PREFIX + frame in anatomy_guards:
                context[WIKTIONARY_ANATOMY_FRAME_PREFIX + frame] = "true"
    if requested or native_lemma_requested:
        ancestors = set()
        synsets = set()
        for observation in observations:
            witnessed = _exact_wordnet_ancestry(definition, observation)
            ancestors.update(witnessed)
            if witnessed:
                synsets.add(_field(observation, "features")["synset_name"])
            if native_lemma_requested and witnessed and _attested_wordnet_lemma(definition, observation):
                context["wordnet_native_lemma"] = "true"
        if ancestors:
            for relation in relations:
                for key, _ in relation.guards:
                    if (
                        key.startswith(_ANCESTOR_PREFIX)
                        and key.removeprefix(_ANCESTOR_PREFIX) in ancestors
                        or key.startswith(WORDNET_OUTSIDE_ANCESTOR_PREFIX)
                        and key.removeprefix(WORDNET_OUTSIDE_ANCESTOR_PREFIX) not in ancestors
                        or key.startswith(WORDNET_OTHER_SYNSET_PREFIX)
                        and len(synsets) == 1
                        and key.removeprefix(WORDNET_OTHER_SYNSET_PREFIX) not in synsets
                    ):
                        context[key] = "true"
    for relation in relations:
        exclusions = [key for key, _ in relation.guards if key.startswith(EXCEPTION_GUARD_PREFIX)]
        if exclusions and all(context.get(key) == value for key, value in relation.guards if key not in exclusions):
            identity = _field(definition, "entry_id")
            if not isinstance(identity, str) or not identity:
                continue
            context.update(
                {key: "false" if identity == key.removeprefix(EXCEPTION_GUARD_PREFIX) else "true" for key in exclusions}
            )
    return context


def projection_relations() -> tuple[Relation, ...]:
    """Compile the approved own-word projection rules, with their scope guards."""
    foundational = (
        Relation(
            "founder:noun-own-evaluation",
            ("GOOD",),
            ((0,),),
            (FOUNDER_SOURCE + "#F057",),
            "foundational",
            True,
            (("pos", "noun"),),
        ),
        Relation(
            "founder:adjective-not-object",
            ("SOMETHING",),
            ((0,),),
            (FOUNDER_SOURCE + "#F057",),
            "foundational",
            True,
            (("pos", "adjective"),),
        ),
        Relation(
            "founder:adverb-not-object",
            ("SOMETHING",),
            ((0,),),
            (FOUNDER_SOURCE + "#F057",),
            "foundational",
            True,
            (("pos", "adverb"),),
        ),
    )
    categories = (
        ("I", "SOMEONE", (1,), ()),
        ("YOU", "SOMEONE", (1,), ()),
        ("BODY", "SOMETHING", (1,), (("pos", "noun"),)),
        ("ONE", "QUANTITY", (1,), ()),
        ("TWO", "QUANTITY", (1,), ()),
        ("MOVE", "HAPPEN", (1,), ()),
        ("DO", "HAPPEN", (1,), ()),
        ("CAUSE", "HAPPEN", (1,), ()),
        ("THEN", "WHEN", (-1, 1), ()),
        ("BEFORE", "WHEN", (-1, 1), ()),
        ("LONG_TIME", "WHEN", (-1, 1), ()),
        ("MOMENT", "WHEN", (1,), ()),
        ("ABOVE", "WHERE", (-1, 1), ()),
        ("FAR", "WHERE", (-1, 1), ()),
        ("OUTSIDE", "WHERE", (-1, 1), ()),
        ("TOWARD", "WHERE", (-1, 1), ()),
        ("HERE", "WHERE", (1,), ()),
        ("SIDE", "WHERE", (1,), ()),
    )
    category_relations = tuple(
        Relation(
            f"founder:category:{specific.lower()}-{general.lower()}",
            (specific, general),
            tuple((a, b) for a, b in product((-1, 0, 1), repeat=2) if a not in active or b == 1),
            (DESIGN_SOURCE + "#category-content",),
            "conditional",
            True,
            guards,
        )
        for specific, general, active, guards in categories
    )
    absence_relations = tuple(
        Relation(
            f"founder:absence:{source.lower()}-{target.lower()}",
            (source, target),
            tuple((a, b) for a, b in product((-1, 0, 1), repeat=2) if a == 0 or b == 0),
            (DESIGN_SOURCE + "#evidence-conditioned-absence",),
            "conditional",
            True,
            (("pos", "adjective"),),
            absent_evidence=(target,),
        )
        for source, target in (("GOOD", "BIG"), ("BIG", "GOOD"))
    )
    return foundational + category_relations + absence_relations


def load_manifest(path: str | Path | None) -> tuple[tuple[Relation, ...], dict[str, tuple[Assertion, ...]], dict]:
    """Load explicit approved rules/anchors and NUMBER metadata, never infer approval.

    Anchors are keyed by dictionary entry ID, not spelling. Each assertion must
    name its source and record. A manifest cannot mint additional coordinates.
    """
    if path is None:
        return (), {}, {}
    raw = read_json(path)
    if not isinstance(raw, dict) or current_id(raw.get("format")) != "GSE.lexicon-rules/1":
        raise ValueError("INVALID_RULE_MANIFEST")
    if set(raw) - {"format", "relations", "anchors", "hierarchy", "definitions", "prime_entries"}:
        raise ValueError("UNKNOWN_MANIFEST_FIELD")
    if not isinstance(raw.get("relations", []), list) or not isinstance(raw.get("anchors", {}), dict):
        raise ValueError("INVALID_RULE_MANIFEST")
    for entry_id, records in raw.get("anchors", {}).items():
        if not isinstance(entry_id, str) or not entry_id.strip() or not isinstance(records, list):
            raise ValueError("INVALID_ANCHORS")
    relations = []
    for record in raw.get("relations", []):
        required = {"rule_id", "banks", "allowed_rows", "provenance"}
        if (
            not isinstance(record, dict)
            or not required <= record.keys()
            or set(record) - required - {"authority", "approved", "guards", "absent_evidence"}
        ):
            raise ValueError("INVALID_RELATION_RECORD")
        for key in ("banks", "provenance", "allowed_rows", "guards", "absent_evidence"):
            if not isinstance(record.get(key, []), list):
                raise ValueError("INVALID_RELATION_SEQUENCE")
        if any(not isinstance(row, list) for row in record["allowed_rows"] + record.get("guards", [])):
            raise ValueError("INVALID_RELATION_ROWS")
        record = dict(record)
        for key in ("banks", "provenance"):
            record[key] = tuple(record[key])
        record["allowed_rows"] = tuple(tuple(row) for row in record["allowed_rows"])
        record["guards"] = tuple(tuple(pair) for pair in record.get("guards", []))
        record["absent_evidence"] = tuple(record.get("absent_evidence", []))
        relations.append(Relation(**record))
    try:
        anchors = {
            entry_id: tuple(Assertion(**record) for record in records)
            for entry_id, records in raw.get("anchors", {}).items()
        }
    except TypeError as exc:
        raise ValueError("INVALID_ANCHOR_RECORD") from exc
    hierarchy = raw.get("hierarchy", {})
    if not isinstance(hierarchy, dict):
        raise ValueError("INVALID_HIERARCHY")
    for entry_id, targets in hierarchy.items():
        if not isinstance(entry_id, str) or not isinstance(targets, dict):
            raise ValueError("INVALID_HIERARCHY")
        for bank, level in targets.items():
            if bank not in BANKS or type(level) is not int:
                raise ValueError("INVALID_HIERARCHY_TARGET")
    validate_lexical_guards(relations)
    return tuple(relations), anchors, hierarchy


def load_manifest_extensions(path: str | Path | None):
    """Explicit hand-authored definitions and prime-unit identity bindings.

    Existing source identities must be reused when they denote the same definition;
    neither this boundary nor catalog coverage merges meanings by spelling.
    """
    from .evidence import Definition

    if path is None:
        return (), {}
    raw = read_json(path)
    records = raw.get("definitions", [])
    links = raw.get("prime_entries", {})
    if not isinstance(records, list) or not isinstance(links, dict):
        raise ValueError("INVALID_MANIFEST_DEFINITIONS")
    definitions = []
    for record in records:
        required = {"entry_id", "lemma", "pos", "definition"}
        if not isinstance(record, dict) or not required <= record.keys() or set(record) - required - {"source_ids"}:
            raise ValueError("INVALID_MANIFEST_DEFINITION")
        if not isinstance(record.get("source_ids", []), list):
            raise ValueError("INVALID_MANIFEST_SOURCE_IDS")
        definitions.append(
            Definition(
                record["entry_id"],
                record["lemma"],
                record["pos"],
                record["definition"],
                tuple(record.get("source_ids", [])),
            )
        )
    for unit, entries in links.items():
        if (
            not isinstance(unit, str)
            or not isinstance(entries, list)
            or any(not isinstance(entry, str) or not entry.strip() for entry in entries)
        ):
            raise ValueError("INVALID_PRIME_ENTRIES")
    return tuple(definitions), {unit: tuple(entries) for unit, entries in links.items()}


### GSE/curation/lexicon_builder/storage.py
"""Store explicit values and unresolved domains without a closed-world default.

The ordinary lexemes/primitive_values tables remain the runtime projection.
Construction evidence, definition IDs, domains, and hierarchy have their own
versioned records. A conflicted entry has no published primitive projection.
"""

import json
import sqlite3
from dataclasses import asdict, fields
from pathlib import Path

from GSE.curation.schema import SCHEMA
from GSE.namespace import current_id

VERSION = "GSE.lexicon-builder/1"
DOMAIN_RESTRICTIONS_VERSION = "GSE.domain-restrictions/1"
EXTRA_SCHEMA = """
CREATE TABLE IF NOT EXISTS builder_metadata (key TEXT PRIMARY KEY, value TEXT NOT NULL);
CREATE TABLE IF NOT EXISTS definition_states (
 entry_id TEXT PRIMARY KEY, lexeme_id INTEGER UNIQUE NOT NULL,
 code TEXT NOT NULL, domains TEXT NOT NULL, conflicts TEXT NOT NULL,
 trace TEXT NOT NULL, hierarchy TEXT NOT NULL,
 FOREIGN KEY(lexeme_id) REFERENCES lexemes(id));
CREATE TABLE IF NOT EXISTS source_observations (
 record_id TEXT PRIMARY KEY, entry_id TEXT, source TEXT NOT NULL,
 family TEXT NOT NULL, scope TEXT NOT NULL, payload TEXT NOT NULL);
CREATE TABLE IF NOT EXISTS builder_assertions (
 entry_id TEXT NOT NULL, ordinal INTEGER NOT NULL, payload TEXT NOT NULL,
 PRIMARY KEY(entry_id,ordinal));
CREATE TABLE IF NOT EXISTS builder_domain_restrictions (
 entry_id TEXT NOT NULL, ordinal INTEGER NOT NULL, payload TEXT NOT NULL,
 PRIMARY KEY(entry_id,ordinal));
CREATE TABLE IF NOT EXISTS unresolved_sources (
 ordinal INTEGER PRIMARY KEY, code TEXT NOT NULL, payload TEXT NOT NULL);
CREATE INDEX IF NOT EXISTS idx_unresolved_sources_code ON unresolved_sources(code);
CREATE INDEX IF NOT EXISTS idx_source_observations_entry ON source_observations(entry_id);
CREATE TABLE IF NOT EXISTS candidate_relations (
 rule_id TEXT PRIMARY KEY, summary TEXT NOT NULL);
CREATE TABLE IF NOT EXISTS candidate_evidence (
 rule_id TEXT NOT NULL, category TEXT NOT NULL, ordinal INTEGER NOT NULL, payload TEXT NOT NULL,
 PRIMARY KEY(rule_id,category,ordinal));
CREATE TABLE IF NOT EXISTS sentence_primitive_values (
 lexeme_id INTEGER NOT NULL, primitive TEXT NOT NULL, value INTEGER NOT NULL,
 UNIQUE(lexeme_id,primitive));
"""


def _json(value) -> str:
    return json.dumps(value, sort_keys=True, ensure_ascii=False, allow_nan=False)


def open_build(path: str | Path) -> sqlite3.Connection:
    """Refuse legacy databases; never relabel old default zeros as evidence."""
    conn = sqlite3.connect(path)
    try:
        tables = {r[0] for r in conn.execute("SELECT name FROM sqlite_master WHERE type='table'")}
        if "lexemes" in tables and "builder_metadata" not in tables:
            raise ValueError("LEGACY_DATABASE_REQUIRES_NEW_BUILD_PATH")
        if "builder_metadata" in tables:
            row = conn.execute("SELECT value FROM builder_metadata WHERE key='format'").fetchone()
            if row is None or current_id(json.loads(row[0])) != VERSION:
                raise ValueError("UNSUPPORTED_BUILD_FORMAT")
            restriction_format = conn.execute(
                "SELECT value FROM builder_metadata WHERE key='domain_restrictions_format'"
            ).fetchone()
            if (
                restriction_format is not None
                and current_id(json.loads(restriction_format[0])) != DOMAIN_RESTRICTIONS_VERSION
            ):
                raise ValueError("UNSUPPORTED_DOMAIN_RESTRICTIONS_FORMAT")
        conn.execute("PRAGMA foreign_keys=ON")
        conn.executescript(SCHEMA + EXTRA_SCHEMA)
        columns = {r[1] for r in conn.execute("PRAGMA table_info(lexemes)")}
        for name, declaration in (
            ("comp_primitive", "TEXT"),
            ("comp_arity", "INTEGER DEFAULT 0"),
            ("comp_operation", "TEXT"),
        ):
            if name not in columns:
                conn.execute(f"ALTER TABLE lexemes ADD COLUMN {name} {declaration}")
        conn.execute("INSERT OR REPLACE INTO builder_metadata VALUES ('format',?)", (_json(VERSION),))
        conn.execute(
            "INSERT OR REPLACE INTO builder_metadata VALUES ('domain_restrictions_format',?)",
            (_json(DOMAIN_RESTRICTIONS_VERSION),),
        )
        conn.commit()
        return conn
    except BaseException:
        conn.close()
        raise


def store_entry(conn, definition, resolution, assertions=(), hierarchy=None, *, domain_restrictions=()) -> None:
    """Replace one explicitly identified definition's complete build receipt."""
    hierarchy = hierarchy or {}
    if resolution.code == "CONFLICT":
        hierarchy = {}
    if any(bank not in resolution.assignments or resolution.assignments[bank] == 0 for bank in hierarchy):
        raise ValueError("HIERARCHY_REQUIRES_NONZERO_BASE")
    status = {"CONFLICT": "rejected", "PARTIAL": "partial", "RESOLVED": "validated"}[resolution.code]
    conn.execute(
        """INSERT INTO lexemes(lemma,pos,sense_id,gloss,source,validation_status)
                    VALUES (?,?,?,?,?,?) ON CONFLICT(lemma,pos,sense_id)
                    DO UPDATE SET gloss=excluded.gloss,validation_status=excluded.validation_status""",
        (definition.lemma, definition.pos, definition.entry_id, definition.definition, VERSION, status),
    )
    lexeme_id = conn.execute(
        "SELECT id FROM lexemes WHERE lemma=? AND pos=? AND sense_id=?",
        (definition.lemma, definition.pos, definition.entry_id),
    ).fetchone()[0]
    conn.execute("DELETE FROM primitive_values WHERE lexeme_id=?", (lexeme_id,))
    if resolution.code != "CONFLICT":
        conn.executemany(
            "INSERT INTO primitive_values(lexeme_id,primitive,value,source) VALUES (?,?,?,?)",
            [(lexeme_id, bank, value, VERSION) for bank, value in sorted(resolution.assignments.items())],
        )
    conn.execute(
        "INSERT OR REPLACE INTO definition_states VALUES (?,?,?,?,?,?,?)",
        (
            definition.entry_id,
            lexeme_id,
            resolution.code,
            _json({b: sorted(v) for b, v in resolution.domains.items()}),
            _json(resolution.conflicts),
            _json(resolution.trace),
            _json(hierarchy),
        ),
    )
    conn.execute("DELETE FROM builder_assertions WHERE entry_id=?", (definition.entry_id,))
    conn.executemany(
        "INSERT INTO builder_assertions VALUES (?,?,?)",
        [(definition.entry_id, i, _json(asdict(a))) for i, a in enumerate(assertions)],
    )
    conn.execute("DELETE FROM builder_domain_restrictions WHERE entry_id=?", (definition.entry_id,))
    conn.executemany(
        "INSERT INTO builder_domain_restrictions VALUES (?,?,?)",
        [(definition.entry_id, i, _json(asdict(r))) for i, r in enumerate(domain_restrictions)],
    )


def store_observations(conn, observations) -> None:
    """Keep native records even when their dictionary linkage is unresolved."""
    for observation in observations:
        payload = _json(asdict(observation))
        previous = conn.execute(
            "SELECT payload FROM source_observations WHERE record_id=?", (observation.record_id,)
        ).fetchone()
        if previous is not None and previous[0] != payload:
            raise ValueError("SOURCE_RECORD_ID_COLLISION")
        conn.execute(
            "INSERT OR IGNORE INTO source_observations VALUES (?,?,?,?,?,?)",
            (
                observation.record_id,
                observation.entry_id,
                observation.source,
                observation.family,
                observation.scope,
                payload,
            ),
        )


def store_unresolved(conn, records) -> dict:
    """Store corpus diagnostics as rows, never one corpus-sized JSON value."""
    from collections import Counter

    counts = Counter()
    for index, record in enumerate(records):
        if not isinstance(record, dict) or not isinstance(record.get("code"), str):
            raise ValueError("INVALID_SOURCE_DIAGNOSTIC")
        counts[record["code"]] += 1
        conn.execute("INSERT INTO unresolved_sources VALUES (?,?,?)", (index, record["code"], _json(record)))
    return {"table": "unresolved_sources", "records": sum(counts.values()), "outcomes": dict(counts)}


def store_candidates(conn, candidates) -> dict:
    """Keep each candidate's individual evidence separate from its summary."""
    count = 0
    categories = ("support", "counterexamples", "unknown", "conflicting", "ineligible")
    for candidate in candidates:
        record = {
            field.name: getattr(candidate, field.name) for field in fields(candidate) if field.name not in categories
        }
        record["relation"] = asdict(candidate.relation)
        rule_id = candidate.relation.rule_id
        record["evidence_counts"] = {key: len(getattr(candidate, key)) for key in categories}
        conn.execute("INSERT INTO candidate_relations VALUES (?,?)", (rule_id, _json(record)))
        for key in categories:
            conn.executemany(
                "INSERT INTO candidate_evidence VALUES (?,?,?,?)",
                ((rule_id, key, index, _json(receipt)) for index, receipt in enumerate(getattr(candidate, key))),
            )
        count += 1
    return {"table": "candidate_relations", "evidence_table": "candidate_evidence", "records": count}


def read_entries(conn, lemma: str | None = None, entry_id: str | None = None) -> list[dict]:
    """Return all matching definitions, never pick one by insertion order."""
    conn.row_factory = sqlite3.Row
    query = "SELECT l.*, d.entry_id,d.code,d.domains,d.conflicts,d.trace,d.hierarchy FROM lexemes l JOIN definition_states d ON l.id=d.lexeme_id"
    conditions, values = [], []
    if lemma is not None:
        conditions.append("l.lemma=?")
        values.append(lemma)
    if entry_id is not None:
        conditions.append("d.entry_id=?")
        values.append(entry_id)
    if conditions:
        query += " WHERE " + " AND ".join(conditions)
    result = []
    for row in conn.execute(query + " ORDER BY d.entry_id", values).fetchall():
        record = dict(row)
        for key in ("domains", "conflicts", "trace", "hierarchy"):
            record[key] = json.loads(record[key])
        record["assignments"] = dict(
            conn.execute(
                "SELECT primitive,value FROM primitive_values WHERE lexeme_id=? ORDER BY primitive", (record["id"],)
            ).fetchall()
        )
        result.append(record)
    return result


def runtime_lookup(conn, lemma: str, entry_id: str | None = None) -> dict:
    """A definition selector is identity, never a nearest-vector decision."""
    entries = read_entries(conn, lemma, entry_id)
    if not entries:
        return {"code": "NOT_FOUND", "candidates": [], "selected": None}
    if len(entries) != 1:
        return {"code": "AMBIGUOUS", "candidates": [e["entry_id"] for e in entries], "selected": None}
    entry = entries[0]
    if entry["code"] == "CONFLICT":
        return {"code": "CONFLICT", "candidates": [entry["entry_id"]], "selected": None}
    return {"code": "IDENTIFIED", "candidates": [entry["entry_id"]], "selected": entry}


### docs/readings/2026-11-13-ssl-explicit-genera/ssl_api_checkpoint.py
"""Execute the existing checkpoint path from exact retained local-model journals.

No model service is called here. Fresh local typed answers, when supplied by an
authorized operator, must retain the complete original packet identity. The
historical water/I reply is reused only for its exact request/schema/transport.
This orchestrates the ordinary writer, audit, admission and joint migration;
it is not another lexical constructor and never activates a candidate.
"""

from __future__ import annotations

import argparse
import json
import sqlite3
from contextlib import closing
from copy import deepcopy
from dataclasses import asdict
from pathlib import Path

from GSE.curation.lexicon_builder.completion import complete_dictionary
from GSE.curation.lexicon_builder.epoch import (
    connect,
    exact_delta,
    fingerprint,
    forecast,
    make_questions,
    parse_plan,
    read,
    record,
    reviewed_input,
    scope_rows,
    snapshot_copy,
)
from GSE.curation.lexicon_builder.learning_curriculum import plan_inventory
