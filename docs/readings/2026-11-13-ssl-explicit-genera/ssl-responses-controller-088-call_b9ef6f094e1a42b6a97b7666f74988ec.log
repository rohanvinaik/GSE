    from .evidence import Definition

    anchors, models = _authorities(conn)
    lexemes = {row["id"]: row for row in conn.execute("SELECT * FROM lexemes")}
    links = _optional_metadata(conn, "prime_entries", {})
    if current_id(_metadata(conn, "catalog")["format"]) == "GSE.nsm-catalog-coverage/1":
        definitions = tuple(Definition(r["sense_id"], r["lemma"], r["pos"], r["gloss"]) for r in lexemes.values())
        catalog = catalog_report(anchors, definitions, relations, prime_entries=links)
    else:
        evidence, restrictions = defaultdict(list), defaultdict(list)
        for entry, ordinal, payload in conn.execute("SELECT * FROM builder_assertions"):
            evidence[entry].append((ordinal, payload))
        for entry, ordinal, payload in conn.execute("SELECT * FROM builder_domain_restrictions"):
            restrictions[entry].append((ordinal, payload))
        catalog = _native_catalog(
            anchors, relations, lexemes, links, models, evidence, restrictions, native, bank_relevance, conn=conn
        )
    conn.execute("INSERT OR REPLACE INTO builder_metadata VALUES ('catalog',?)", (_json(catalog),))
    report = _refresh_coverage(conn)
    report.update(foundation_readiness=catalog["readiness"], prime_coverage=catalog["coverage_counts"])
    conn.execute("INSERT OR REPLACE INTO builder_metadata VALUES ('last_report',?)", (_json(report),))
    return report
completion.py def _entry(conn, entry_id):
    row = conn.execute(
        "SELECT l.lemma,l.pos,l.gloss,d.hierarchy FROM definition_states d JOIN lexemes l ON d.lexeme_id=l.id WHERE d.entry_id=?",
        (entry_id,),
    ).fetchone()
    if row is None:
        raise ValueError("COMPLETION_DEFINITION_DISAPPEARED")
    definition = Definition(entry_id, row[0], row[1], row[2])
    assertions = _assertions(
        conn.execute("SELECT ordinal,payload FROM builder_assertions WHERE entry_id=?", (entry_id,)).fetchall()
    )
    restrictions = _domain_restrictions(
        conn.execute("SELECT ordinal,payload FROM builder_domain_restrictions WHERE entry_id=?", (entry_id,)).fetchall()
    )
    return definition, assertions, restrictions, _read_json(row[3])
storage.py def store_entry(conn, definition, resolution, assertions=(), hierarchy=None, *, domain_restrictions=()) -> None:
    """Replace one explicitly identified definition's complete build receipt."""
    hierarchy = hierarchy or {}
    if resolution.code == "CONFLICT":
        hierarchy = {}
    if any(bank not in resolution.assignments or resolution.assignments[bank] == 0 for bank in hierarchy):
        raise ValueError("HIERARCHY_REQUIRES_NONZERO_BASE")
    status = {"CONFLICT": "rejected", "PARTIAL": "partial", "RESOLVED": "validated"}[resolution.code]
    conn.execute(
        """INSERT INTO lexemes(lemma,pos,sense_id,gloss,source,validation_status)
                    VALUES (?,?,?,?,?,?) ON CONFLICT(lemma,pos,sense_id)
                    DO UPDATE SET gloss=excluded.gloss,validation_status=excluded.validation_status""",
        (definition.lemma, definition.pos, definition.entry_id, definition.definition, VERSION, status),
    )
    lexeme_id = conn.execute(
        "SELECT id FROM lexemes WHERE lemma=? AND pos=? AND sense_id=?",
        (definition.lemma, definition.pos, definition.entry_id),
    ).fetchone()[0]
    conn.execute("DELETE FROM primitive_values WHERE lexeme_id=?", (lexeme_id,))
    if resolution.code != "CONFLICT":
        conn.executemany(
            "INSERT INTO primitive_values(lexeme_id,primitive,value,source) VALUES (?,?,?,?)",
            [(lexeme_id, bank, value, VERSION) for bank, value in sorted(resolution.assignments.items())],
        )
    conn.execute(
        "INSERT OR REPLACE INTO definition_states VALUES (?,?,?,?,?,?,?)",
        (
            definition.entry_id,
            lexeme_id,
            resolution.code,
            _json({b: sorted(v) for b, v in resolution.domains.items()}),
            _json(resolution.conflicts),
            _json(resolution.trace),
            _json(hierarchy),
        ),
    )
    conn.execute("DELETE FROM builder_assertions WHERE entry_id=?", (definition.entry_id,))
    conn.executemany(
        "INSERT INTO builder_assertions VALUES (?,?,?)",
        [(definition.entry_id, i, _json(asdict(a))) for i, a in enumerate(assertions)],
    )
    conn.execute("DELETE FROM builder_domain_restrictions WHERE entry_id=?", (definition.entry_id,))
    conn.executemany(
        "INSERT INTO builder_domain_restrictions VALUES (?,?,?)",
        [(definition.entry_id, i, _json(asdict(r))) for i, r in enumerate(domain_restrictions)],
    )
source_enrichment.py def _refresh_unweighted_discovery(conn):
    """Rebuild native diagnostics after a source assertion changes."""
    from .completion import _set_metadata
    from .discovery import BankObservation, discover_relations
    from .storage import store_candidates
    from .validation import _metadata

    if conn.execute("SELECT 1 FROM candidate_evidence WHERE json_extract(payload,'$.weight') != 1 LIMIT 1").fetchone():
        raise ValueError("SOURCE_REVISION_REQUIRES_ORIGINAL_DISCOVERY_WEIGHTS")
    observations = tuple(
        BankObservation(entry, bank, value, source, record_id, family, scope=scope)
        for entry, bank, value, source, record_id, family, scope in conn.execute(
            """SELECT a.entry_id, json_extract(a.payload,'$.bank'),
                      json_extract(a.payload,'$.value'), o.source, o.record_id, o.family, o.scope
               FROM builder_assertions a JOIN source_observations o
                 ON o.record_id=json_extract(a.payload,'$.record_id')
                AND o.source=json_extract(a.payload,'$.source')
                AND o.entry_id=a.entry_id
               WHERE o.scope='lexical' AND o.family NOT IN ('model','derived')
                 AND o.source NOT LIKE 'model:%' AND o.source NOT LIKE 'rule:%' AND o.source NOT LIKE 'derived:%'"""
        )
    )
    candidates = discover_relations(observations, cross_source=True)
    conn.execute("DELETE FROM candidate_evidence")
    conn.execute("DELETE FROM candidate_relations")
    summary = store_candidates(conn, candidates)
    _set_metadata(conn, "candidate_relations", summary)
    report = _metadata(conn, "last_report")
    report["candidate_relations"] = summary["records"]
    _set_metadata(conn, "last_report", report)
    return summary
foundation.py def representation_contract() -> dict:
    """Pin supported ordinal laws and fingerprint the lexical basis explicitly.

    Other historical ordinal tables are not silently promoted to authority.
    A conflicting runtime mapping requires an explicit representation migration.
    """
    from GSE.primitives_v2 import get_hierarchy_encoding

    for modifier, level in ORDINAL_INTENSITY.items():
        if get_hierarchy_encoding(modifier) != ("INTENSITY", level, abs(level)):
            raise ValueError("ORDINAL_REPRESENTATION_DRIFT")
    return {
        "version": CONVENTION_VERSION,
        "basis": list(BANKS),
        "basis_sha256": hashlib.sha256(json.dumps(BANKS, separators=(",", ":")).encode()).hexdigest(),
        "want_polarity": {str(k): v for k, v in WANT_POLARITY.items()},
        "ordinal_intensity": dict(ORDINAL_INTENSITY),
        "ordinal_source": DESIGN_SOURCE + "#ordinal-stability",
        "other_ordinal_levels": "EXPLICIT_JUSTIFIED_MANIFEST_ONLY",
    }
