": 27, "kind": "JOINT_CHECK", "max_joint_assignments": 100000, "provenance": [["founder:category:one-quantity", ["docs/program/LEXICON_CONSTRUCTION_DESIGN.md#category-content"]], ["founder:category:two-quantity", ["docs/program/LEXICON_CONSTRUCTION_DESIGN.md#category-content"]]], "rule_ids": ["founder:category:one-quantity", "founder:category:two-quantity"], "witnesses": 17}, {"complete_search": true, "kind": "INFERENCE_SCOPE", "method": "GENERALIZED_ARC_CONSISTENCY_AND_BOUNDED_JOINT_SUPPORT", "partial_means": "AMBIGUOUS_JOINT_SUPPORTED_DOMAINS", "satisfiability": "SATISFIABLE"}, {"context": {"pos": "nsm_lexical_unit"}, "kind": "EVIDENCE_GUARD", "reason": "GUARD_MISMATCH", "relation": {"absent_evidence": ["GOOD"], "allowed_rows": [[-1, 0], [0, -1], [0, 0], [0, 1], [1, 0]], "approved": true, "authority": "conditional", "banks": ["BIG", "GOOD"], "guards": [["pos", "adjective"]], "provenance": ["docs/program/LEXICON_CONSTRUCTION_DESIGN.md#evidence-conditioned-absence"], "rule_id": "founder:absence:big-good"}, "relevance_basis": "ORDINARY_CLOSURE_BEFORE_ALL_DEFAULTS", "rule_id": "founder:absence:big-good", "status": "BLOCKED", "witnesses": [{"assertions": [], "bank": "GOOD", "baseline_domain": [-1, 0, 1], "baseline_narrowed": false, "baseline_rule_ids": [], "supplied_evidence": true}]}, {"context": {"pos": "nsm_lexical_unit"}, "kind": "EVIDENCE_GUARD", "reason": "GUARD_MISMATCH", "relation": {"absent_evidence": ["BIG"], "allowed_rows": [[-1, 0], [0, -1], [0, 0], [0, 1], [1, 0]], "approved": true, "authority": "conditional", "banks": ["GOOD", "BIG"], "guards": [["pos", "adjective"]], "provenance": ["docs/program/LEXICON_CONSTRUCTION_DESIGN.md#evidence-conditioned-absence"], "rule_id": "founder:absence:good-big"}, "relevance_basis": "ORDINARY_CLOSURE_BEFORE_ALL_DEFAULTS", "rule_id": "founder:absence:good-big", "status": "BLOCKED", "witnesses": [{"assertions": [], "bank": "BIG", "baseline_domain": [-1, 0, 1], "baseline_narrowed": false, "baseline_rule_ids": [], "supplied_e