GSE/symbolic/propositions.py proposition_status def proposition_status(modes: List[str]) -> str:
    """The one code a proposition's scope modes, outermost first, project to (pure, pinned).

    The outermost mode that is not ``"asserted"`` (``negated``, ``conditional``, ``belief`` or ``irrealis``), or
    ``"asserted"`` when there is none. ``"epistemic"`` is transparent: a knowing commits its complement. A
    ``"negated"`` with a believing or knowing scope inside it projects to ``"abstained"``: the negation is the verb's,
    and the content's truth is unknown ("I don't think X", "She doesn't know that X"). A negation inside the content
    is the content's own ("He knows that she did not leave": negated). Lossy by design; see the module docstring.
    """
    for i, mode in enumerate(modes):
        if mode in ("asserted", "epistemic"):
            continue
        if mode == "negated" and any(inner in _ATTITUDE_MODES for inner in modes[i + 1 :]):
            return "abstained"
        return mode
    return "asserted"
GSE/symbolic/claims.py commitment_modes def commitment_modes(modes: tuple[str, ...], *, valid: bool = True, interrogative: bool = False) -> str:
    """Flat scope decision underneath the object adapter.

    post: __return__ in {'committed', 'non_committed', 'abstained', 'in_question', 'unresolved'}
    post: valid or __return__ == 'unresolved'
    post: not (valid and interrogative) or __return__ == 'in_question'
    """
    if not valid:
        return "unresolved"
    if interrogative or any(mode in {"question", "in_question"} for mode in modes):
        return "in_question"
    for index, mode in enumerate(modes):
        if mode == "abstained":
            return "abstained"
        if mode == "negated" and any(inner in _ATTITUDES for inner in modes[index + 1 :]):
            return "abstained"
    if any(mode not in _TRANSPARENT for mode in modes):
        return "non_committed"
    return "committed"
GSE/symbolic/modality.py assertion_mode def assertion_mode(kind: str, verb: str = "", patient_kind: str = "") -> str:
    """How a predicate-tree node asserts its clausal content (#7, pure — pinned).

    Split out of the tree walkers so the decision is total over plain strings and pinnable: a
    walker passes the node's type name, its ``verb`` and its patient's type name, and keeps the
    object handling. Before the split, the knowledge base had no copy of this decision at all and
    the story skeleton held two inline copies of half of it.

    Returns a named code, never a bool, because each mode needs a different remedy:

    * ``"negated"`` — a ``Negation``: its operand holds with inverted polarity, never as stated.
    * ``"conditional"`` — a ``Conditional``: the consequent holds only if the antecedent does;
      neither clause is asserted on its own.
    * ``"belief"`` — an attitude ``Event`` over a clausal complement ("believes that X"): the
      patient is the agent's belief, not a fact; the attitude itself is asserted.
    * ``"epistemic"`` — a knowing ``Event`` over a clausal complement ("knows that X"): the
      patient is committed, as stated; under a negation its truth abstains instead
      (:func:`GSE.symbolic.propositions.proposition_status`).
    * ``"reported"`` — a reporting ``Event`` over a clausal complement ("says that X"):
      the report is asserted; the content is attributed and remains uncommitted.
    * ``"irrealis"`` — a ``Control`` under an irrealis matrix ("refused to bow", "plots to
      kill"): the inner act is negated or unasserted; the matrix itself is asserted.
    * ``"asserted"`` — anything else: its operand content holds as stated.
    """
    if kind == "Negation":
        return "negated"
    if kind == "Conditional":
        return "conditional"
    if kind == "Event" and verb in ATTITUDE_VERBS and patient_kind in _CLAUSAL_COMPLEMENT_KINDS:
        return "belief"
    if kind == "Event" and verb in EPISTEMIC_VERBS and patient_kind in _CLAUSAL_COMPLEMENT_KINDS:
        return "epistemic"
    if kind == "Event" and verb in REPORTING_VERBS and patient_kind in _CLAUSAL_COMPLEMENT_KINDS:
        return "reported"
    if kind == "Control" and verb in IRREALIS_CONTROL_VERBS:
        return "irrealis"
    return "asserted"
