            matched = frozenset(gloss.keys() & cues.keys())
            exact, related = self._derivation_support(sense, gloss, matched, derivations, linked_verbs, type_witness)
            verb_match = any(gloss[word] == cues[word] == "VERB" for word in matched)
            typed = self._matches_construction_type(sense, type_witness, matched, gloss)
            repeated = self._matches_definition_predication(sense, predication)
            if repeated or (not definition_only and (exact or (verb_match and len(matched) >= 2) or related or typed)):
                witnesses[entry_id] = {
                    "gloss_terms": sorted(matched),
                    "exact_derivation": exact,
                    "related_derivation": related,
                    "construction_type": predication if repeated else type_witness if typed or related else None,
                }
        return _unique_native_witness(witnesses)
def _definition_predication(self, position):
        """Read an explicit nominal equivalence with the target as its subject."""
        start, end = self._bounds(position, self.sentence_boundaries)
        preceding = tuple(self.doc[start + 1 : position])
        following = tuple(self.doc[position + 1 : end])
        if (
            (preceding and (len(preceding) != 1 or preceding[0].lemma_ != "the"))
            or len(following) < 4
            or following[0].lemma_ != "be"
            or following[0].pos_ != "AUX"
            or following[1].lemma_ not in {"a", "an", "the"}
            or (end < len(self.doc) and self.doc[end].text == "?")
            or any(t.lemma_ == "or" for t in following)
        ):
            return None
        complement = following[2:]
        # A state's defining condition can contain its own prepositions,
        # predicates and negation. Match that complete native definition;
        # negation of the outer copula never reaches this article-led branch.
        if (
            len(complement) >= 3
            and complement[0].lemma_ == "state"
            and complement[0].pos_ == "NOUN"
            and (
                complement[1].lemma_ == "of"
                or (len(complement) >= 4 and [t.lemma_ for t in complement[1:3]] == ["in", "which"])
            )
            and not any(t.pos_ == "PUNCT" for t in complement)
        ):
            return {
                "kind": "EXPLICIT_DEFINITION_PREDICATION",
                "terms": [t.text.casefold() for t in complement],
                "state_condition": complement[2].text.casefold()
                if len(complement) == 3 and complement[1].lemma_ == "of" and complement[2].pos_ == "NOUN"
                else None,
            }
        if any(t.lemma_ in {"not", "never"} for t in following):
            return None
        # A relative clause can elaborate an already asserted complement.
        relative = next((i for i, t in enumerate(following[2:], 2) if t.lemma_ in {"that", "which"}), len(following))
        nominal = following[2:relative]
        if (
            len(nominal) < 2
            or nominal[-1].pos_ != "NOUN"
            or any(t.pos_ not in {"ADJ", "NOUN"} for t in nominal)
            or (relative < len(following) and not any(t.pos_ == "VERB" for t in following[relative + 1 :]))
        ):
            return None
        return {"kind": "EXPLICIT_DEFINITION_PREDICATION", "terms": [t.text.casefold() for t in nominal]}
def _matches_definition_predication(sense, predication):
        if predication is None:
            return False
        terms = predication["terms"]
        gloss = sense.gloss.casefold().removesuffix(".").split()
        if gloss and gloss[0] in {"a", "an", "the"}:
            gloss = gloss[1:]
        if terms == gloss or "_".join(terms) in sense.names:
            return True
        # An explicitly asserted state genus can identify a unique native
        # reading even when its definition adds a qualifier after the complete
        # condition noun (e.g. inactivity following an interruption).
        return (
            predication.get("state_condition") is not None
            and "state.n.02" in sense.nodes
            and len(gloss) > len(terms)
            and gloss[: len(terms)] == terms
        )

FILE tests/test_runtime_native_identity_controls.py
"""Actual activated resource, native parser and public encoder identity witnesses."""

import pytest

from GSE.api import GSEEncoder


@pytest.fixture(scope="module")
def encoder():
    with GSEEncoder() as instance:
        instance.conn.execute("PRAGMA query_only=ON")
        yield instance


@pytest.mark.parametrize(
    "text",
    [
        "He is an entity.",
        "He is a thing.",
        "He is an organism.",
        "He is an animal.",
        "He is a person.",
        "He is happy.",
        "He studies helium.",
        "He discusses gas.",
        "He is not a gas.",
        "He is an inert gas?",
    ],
)
def test_broad_ancestor_or_unasserted_type_cannot_veto_person_reference(encoder, text):
    token = encoder.encode(text).tokens[0]
    assert token.lexical_evidence["selected_record"]["entry_id"] == "gse_closed_class:pronoun:he"
    assert token.word_primitives == {"SOMEONE": 1}


def test_exact_native_context_is_consumed_not_dropped_after_pos_challenge(encoder):
    token = encoder.encode("He is an inert gas.").tokens[0]
    evidence = token.lexical_evidence
    assert evidence["selected_record"]["entry_id"] == "wordnet:he:helium.n.01"
    assert evidence["reading_eligibility"]["code"] == "CONTEXTUAL_DEFINITION_SELECTED"
    assert evidence["contextual_grounding"]["code"] == "EXACT_WORDNET_SENSE"
    assert token.pos == "NOUN"  # prevents subsequent pronoun recency binding
    assert token.word_primitives == {k: v for k, v in evidence["selected_record"]["assignments"].items() if v}
    assert evidence["domains"] == encoder.lookup_definition("wordnet:he:helium.n.01")["selected"]["domains"]
    assert evidence["domains"]["WANT"] == [-1, 0, 1]


@pytest.mark.parametrize("text", ["The chemical symbol He denotes helium.", "He is a noble gas."])
def test_specific_unsupported_reading_remains_named_abstention_not_person(encoder, text):
    token = next(t for t in encoder.encode(text).tokens if t.token == "He")
    assert token.lexical_evidence["selection_status"] == "CONFLICT"
    assert token.lexical_evidence["selected_record"] is None
    assert token.lexical_evidence["reading_eligibility"]["code"] == "GRAMMATICAL_CONTEXT_CONFLICT"
    assert token.word_primitives == {} and token.word_vec_nnz == 0


@pytest.mark.parametrize(
    "text, lemma, entry, bank",
    [
        ("I want to go home now.", "want", "desire.v.01", "WANT"),
        ("I think he is very smart.", "think", "think.v.01", "THINK"),
        ("I know that the President lied to the people.", "know", "know.v.01", "KNOW"),
        ("You have to be a good observer to see all the details.", "see", "see.v.01", "SEE"),
        ("She feels resentful.", "feel", "feel.v.01", "FEEL"),
        ("He said that he wanted to marry her.", "say", "state.v.01", "SAY"),
        ("What is happening?", "happen", "happen.v.01", "HAPPEN"),
        ("He moved his hand slightly to the right.", "move", "move.v.03", "MOVE"),
    ],
)
def test_native_predicate_constructions_are_reachable_without_first_sense_selection(encoder, text, lemma, entry, bank):
    token = next(t for t in encoder.encode(text).tokens if t.lemma == lemma)
    proof = token.lexical_evidence["contextual_grounding"]
    assert proof["code"] == "EXACT_WORDNET_SENSE"
    assert proof["witness_kind"] == "WORDNET_NATIVE_EXAMPLE_CONSTRUCTION"
    assert proof["native_examples"] and proof["eligible_pos"] == "VERB"
    assert token.lexical_evidence["selected_record"]["entry_id"] == f"wordnet:{lemma}:{entry}"
    assert token.word_primitives[bank] == 1
    assert token.lexical_evidence["domains"]["TOUCH"] == [-1, 0, 1]


@pytest.mark.parametrize(
    "text, lemma",
    [
        ("I want something.", "want"),
        ("I think about something.", "think"),
        ("I hear a sound.", "hear"),
        ("I feel pain.", "feel"),
        ("I want to go home now or stay here.", "want"),
        ("I do not want to go home now.", "want"),
    ],
)
def test_pos_or_partial_native_example_cannot_force_a_predicate_reading(encoder, text, lemma):
    trace = encoder.encode(text)
    token = next(t for t in trace.tokens if t.lemma == lemma)
    assert token.lexical_evidence["selection_status"] == "AMBIGUOUS"
    assert token.lexical_evidence["selected_record"] is None
    assert token.word_primitives == {}


