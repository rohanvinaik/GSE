GSE/curation/lexicon_builder/validation.py def _observations(conn, entries, mismatch, model_entries=()):
    """Stream full validation but retain only narrow lexical provenance records.

    Full feature objects are discarded after each row. Model context retains
    record IDs only for definitions with accepted model receipts, and is loaded
    lazily during those receipts' replay.
    """
    native = {}
    relevant = defaultdict(list)
    bank_relevance = {}
    from .relevance import observation_relevance

    required = {field.name for field in fields(Observation)}
    duplicates = {
        row[0]
        for row in conn.execute("SELECT record_id FROM source_observations GROUP BY record_id HAVING COUNT(*) > 1")
    }
    for row in conn.execute("SELECT * FROM source_observations"):
        entry_id = row["entry_id"]
        try:
            record = _read_json(row["payload"])
            if not isinstance(record, dict) or set(record) != required:
                raise ValueError("INVALID_OBSERVATION_FIELDS")
            if not isinstance(record["candidate_entry_ids"], list):
                raise ValueError("INVALID_OBSERVATION_CANDIDATES")
            observation = Observation(
                entry_id=record["entry_id"],
                source=record["source"],
                record_id=record["record_id"],
                family=record["family"],
                features=record["features"],
                scope=record["scope"],
                candidate_entry_ids=tuple(record["candidate_entry_ids"]),
            )
            banks = observation_relevance(observation)
            if any(
                getattr(observation, key) != row[key] for key in ("entry_id", "record_id", "source", "family", "scope")
            ):
                raise ValueError("OBSERVATION_COLUMN_PAYLOAD_MISMATCH")
            if observation.record_id in duplicates:
                raise ValueError("AMBIGUOUS_OBSERVATION_ID")
            targets = (entry_id,) if entry_id is not None else observation.candidate_entry_ids
            if any(target not in entries for target in targets):
                raise ValueError("ORPHAN_OBSERVATION_DEFINITION")
        except (TypeError, ValueError) as error:
            mismatch(entry_id, "MALFORMED_OBSERVATION", record_id=row["record_id"], reason=str(error))
            continue
        if observation.scope == "lexical":
            native[(observation.source, observation.record_id)] = _NativeReference(
                observation.entry_id, observation.family, observation.scope
            )
        for target in targets:
            previous = bank_relevance.get(target, frozenset())
            if len(previous) < len(BANKS):
                bank_relevance[target] = previous | banks
            if target in model_entries:
                relevant[target].append(observation.record_id)
    return native, relevant, bank_relevance
GSE/curation/lexicon_builder/validation.py def _stored_context(conn, definition, relations):
    return lexical_context(
        definition, _context_observations(conn, definition.entry_id, relations, definition), relations
    )
GSE/curation/lexicon_builder/completion.py def _contexts(conn, selected, *, indexed=False):
    """Retain only selected payloads, with identical ordering on both paths."""
    observations, relevance = defaultdict(list), defaultdict(set)
    wanted = set(selected)
    if not wanted:
        return observations, relevance
    if indexed:
        parameters = ",".join("?" for _ in selected)
        rows = conn.execute(
            f"""SELECT observation.payload FROM source_observations observation
                JOIN (
                    SELECT record_id FROM source_observations WHERE entry_id IN ({parameters})
                    UNION
                    SELECT record_id FROM completion_context_targets WHERE entry_id IN ({parameters})
                ) target ON target.record_id=observation.record_id
                ORDER BY observation.record_id""",
            (*selected, *selected),
        )
    else:
        rows = conn.execute("SELECT payload FROM source_observations ORDER BY record_id")
    for (payload,) in rows:
        raw = _read_json(payload)
        targets = (raw["entry_id"],) if raw["entry_id"] is not None else raw["candidate_entry_ids"]
        matched = wanted.intersection(targets)
        if not matched:
            continue
        observation = Observation(
            raw["entry_id"],
            raw["source"],
            raw["record_id"],
            raw["family"],
            raw["features"],
            raw["scope"],
            tuple(raw["candidate_entry_ids"]),
        )
        relevant = observation_relevance(observation)
        for entry in sorted(matched):
            observations[entry].append(raw)
            relevance[entry].update(relevant)
    return observations, relevance
GSE/curation/lexicon_builder/catalog.py def chart_definition_records() -> tuple[dict, ...]:
    """Primary-source identities for units without a demonstrated native match.

    The full box is contextual evidence, not an explication invented here. A
    lexical unit's POS is deliberately unspecified: an English exponent's POS
    does not prove that every allowable NSM frame has that grammatical type.
    No candidate coordinate or frame participant becomes a bank assertion.
    """
    records = []
    for key, heading, forms, frames in _CHART_BOXES:
        if key in _NATIVE_PRIME_DEFINITIONS:
            continue
        kind = "GRAMMATICAL_CONSTRUCTION" if key in _CHART_CONSTRUCTIONS else "LEXICAL_UNIT"
        records.append(
            {
                "entry_id": f"nsm_chart:v20:{key}",
                "unit_id": f"nsm:v20:{key}",
                "lemma": _CHART_LEMMAS.get(key, key),
                "pos": "nsm_construction" if key in _CHART_CONSTRUCTIONS else "nsm_lexical_unit",
                "definition": f"NSM v20 {kind.lower().replace('_', ' ')} {heading.replace(chr(10), '')}. "
                "The source identifies this elementary meaning through its exponent forms and allowable frames; "
                "these frames are preserved as context, not asserted as the unit's own bank values.",
                "definition_kind": kind,
                "chart_heading": heading,
                "forms": tuple(forms),
                "frame_text": frames,
                "source_reference": dict(SOURCE),
                "chart_notes": CHART_NOTES,
                "frames_are": "COMBINATORIAL_NOT_OWN_WORD_ASSIGNMENTS",
            }
        )
    return tuple(records)
