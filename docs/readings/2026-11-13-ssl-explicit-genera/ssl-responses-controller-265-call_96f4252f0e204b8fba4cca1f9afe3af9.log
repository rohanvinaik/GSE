  "python_source": "\nfrom pathlib import Path\nimport json,time,hashlib,datetime,subprocess,traceback\nROOT=Path.cwd();N=ROOT/'docs/readings/2026-11-13-ssl-explicit-genera';W=ROOT/'data/lexicon_builder/2026-11-12/ssl-explicit-genera/ssl-api-checkpoint'\ndef now():return datetime.datetime.now(datetime.timezone.utc).isoformat()\ndef save(p,x):\n t=p.with_name(p.name+'.tmp');t.write_text(json.dumps(x,indent=2)+'\\n');t.replace(p)\ndef sha(p):\n h=hashlib.sha256()\n with p.open('rb') as f:\n  for b in iter(lambda:f.read(8*1024*1024),b''):h.update(b)\n return h.hexdigest()\ndef read(p):return json.loads(p.read_text())\ndef verify(rows):\n bad=[r['path'] for r in rows if sha(ROOT/r['path'])!=r['sha256']]\n if bad:raise ValueError('SOURCE_FREEZE_PIN_MISMATCH:'+repr(bad))\nphase=N/'ssl-api-controller-integrated-gate-phase.json'\ntry:\n deadline=time.monotonic()+3*3600\n save(phase,{'code':'WAITING_FOR_ACTUAL_RUNTIME_FREEZE_AND_COMPLETED_TEN_COORDINATE_HEAD','updated_utc':now(),'activation_performed':False})\n while True:\n  a=read(N/'ssl-api-controller-source-freeze.json');b=read(N/'ssl-api-runtime-result.json')\n  exitpath=N/'ssl-api-controller-continuation-exit.json'\n  if exitpath.exists() and read(exitpath)['exit_code']!=0:raise ValueError('TEN_COORDINATE_WRITER_FAILED')\n  if a.get('source_edits_finished') is True and b.get('source_edits_finished') is True and b.get('status')=='CODE_FREEZE_READY' and exitpath.exists() and (W/'space-post-prime-child-teaching.json').exists():break\n  if time.monotonic()>deadline:raise TimeoutError('REPAIRED_SOURCE_FREEZE_OR_FINAL_LEXICAL_HEAD_NOT_READY')\n  time.sleep(30)\n pins={r['path']:r for r in a['pins']+b['owned_files']};verify(pins.values())\n names=subprocess.check_output(['git','ls-files','-z','--','*.py','scripts/ci_local.sh','pyproject.toml','uv.lock'],text=True).split('\\0')\n inventory={f:sha(ROOT/f) for f in names if f and (ROOT/f).is_file()}\n writer=read(N/'ssl-api-controller-prime-child-writer.json');candidate_sha=sha(W/'candidate.db')\n if candidate_sha!=writer['after_sha256']:raise ValueError('INTEGRATED_GATE_CANDIDATE_HEAD_CHANGED')\n binding={'lexicon_sha256':candidate_sha,'source_head':subprocess.check_output(['git','rev-parse','HEAD'],text=True).strip(),'source_freeze_pins':list(pins.values()),'tracked_gate_input_pins':inventory,'runtime_freeze_receipt_sha256':sha(N/'ssl-api-runtime-result.json'),'builder_freeze_receipt_sha256':sha(N/'ssl-api-controller-source-freeze.json')}\n save(phase,{'code':'INTEGRATED_REPOSITORY_GATE_RUNNING','updated_utc':now(),**binding})\n command=['bash','scripts/ci_local.sh']; log=N/'ssl-api-controller-integrated-gate-output.log'\n with log.open('x') as stream:\n  completed=subprocess.run(command,cwd=ROOT,stdout=stream,stderr=subprocess.STDOUT,timeout=10800)\n verify(pins.values())\n changed=[f for f,v in inventory.items() if not (ROOT/f).is_file() or sha(ROOT/f)!=v]\n if changed:raise ValueError('GATE_INPUTS_CHANGED_DURING_EXECUTION:'+repr(changed))\n currentb=read(N/'ssl-api-runtime-result.json')\n if currentb.get('source_edits_finished') is not True or currentb.get('status')!='CODE_FREEZE_READY':raise ValueError('RUNTIME_UNFROZEN_DURING_GATE')\n result={'format':'GSE.checkpoint-repository-gate/1','code':'REPOSITORY_GATE_PASSED' if completed.returncode==0 else 'REPOSITORY_GATE_FAILED','command':command,'exit_code':completed.returncode,'finished_utc':now(),'log':str(log),'log_sha256':sha(log),**binding,'activation_performed':False,'usable_checkpoint_accepted':False}\n save(N/'ssl-api-controller-integrated-gate.json',result);save(phase,result)\n save(N/'ssl-api-controller-integrated-gate-exit.json',{'exit_code':completed.returncode,'finished_utc':now()})\n if completed.returncode:raise SystemExit(completed.returncode)\nexcept BaseException as error:\n if not (N/'ssl-api-controller-integrated-gate-exit.json').exists():\n  save(phase,{'code':'INTEGRATED_GATE_STOPPED','updated_utc':now(),'error_type':type(error).__name__,'error':str(error),'activation_performed':False})\n  save(N/'ssl-api-controller-integrated-gate-exit.json',{'exit_code':1,'finished_utc':now(),'error_type':type(error).__name__,'error':str(error)})\n traceback.print_exc();raise\n",
  "source_sha256": "047c6387187b5c0a485e66eb5f417942135de4c535bf4e5b40c123f80fb09cb5",
  "scope": "Wait for genuine repaired runtime freeze and final lexical writer/H, verify pins, execute unchanged bash scripts/ci_local.sh. No lexical writes/service/publication."
}


