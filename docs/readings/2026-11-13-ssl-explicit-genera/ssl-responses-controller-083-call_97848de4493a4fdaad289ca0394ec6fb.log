
### GSE/curation/lexicon_builder/catalog.py
def foundation_prime_links() -> dict[str, tuple[str, ...]]:
    """Return explicit primary-unit identities, never a lemma-selected vector."""
    return {
        f"nsm:v20:{key}": (_NATIVE_PRIME_DEFINITIONS.get(key, f"nsm_chart:v20:{key}"),) for key, _, _, _ in _CHART_BOXES
    }
def chart_definition_records() -> tuple[dict, ...]:
    """Primary-source identities for units without a demonstrated native match.

    The full box is contextual evidence, not an explication invented here. A
    lexical unit's POS is deliberately unspecified: an English exponent's POS
    does not prove that every allowable NSM frame has that grammatical type.
    No candidate coordinate or frame participant becomes a bank assertion.
    """
    records = []
    for key, heading, forms, frames in _CHART_BOXES:
        if key in _NATIVE_PRIME_DEFINITIONS:
            continue
        kind = "GRAMMATICAL_CONSTRUCTION" if key in _CHART_CONSTRUCTIONS else "LEXICAL_UNIT"
        records.append(
            {
                "entry_id": f"nsm_chart:v20:{key}",
                "unit_id": f"nsm:v20:{key}",
                "lemma": _CHART_LEMMAS.get(key, key),
                "pos": "nsm_construction" if key in _CHART_CONSTRUCTIONS else "nsm_lexical_unit",
                "definition": f"NSM v20 {kind.lower().replace('_', ' ')} {heading.replace(chr(10), '')}. "
                "The source identifies this elementary meaning through its exponent forms and allowable frames; "
                "these frames are preserved as context, not asserted as the unit's own bank values.",
                "definition_kind": kind,
                "chart_heading": heading,
                "forms": tuple(forms),
                "frame_text": frames,
                "source_reference": dict(SOURCE),
                "chart_notes": CHART_NOTES,
                "frames_are": "COMBINATORIAL_NOT_OWN_WORD_ASSIGNMENTS",
            }
        )
    return tuple(records)

### GSE/curation/lexicon_builder/evidence.py
def validate_assertion_competence(assertion: Assertion | DomainRestriction) -> None:
    """Enforce native source competence for collected and imported assertions.

    Source scopes name both primitive poles, while assertions use canonical
    banks: BAD therefore permits GOOD with a negative sign, never a separate
    BAD coordinate. Unknown authored dictionary sources have no native scope
    restriction here; their identity, lexical typing and closed-basis checks
    remain the caller's evidence/engine contract.
    """
    if not isinstance(assertion, (Assertion, DomainRestriction)):
        raise ValueError("INVALID_ASSERTION")
    if assertion.source == "wiktionary" and (
        not isinstance(assertion, Assertion) or assertion.value != 1 or assertion.scope != "lexical"
    ):
        raise ValueError("ASSERTION_OUTSIDE_NATIVE_DEFINITION_SCOPE")
    permitted = _native_definition_scope(assertion.source)
    if permitted is None:
        return
    allowed = {
        bank
        for primitive in permitted
        if primitive in PRIMITIVE_REGISTRY
        for bank, _ in (get_canonical_pole(primitive),)
        if bank in BANKS
    }
    if assertion.bank not in allowed:
        raise ValueError("ASSERTION_OUTSIDE_SOURCE_SCOPE")

### GSE/curation/external_sources/nsm_chart.py
"""Primary NSM chart definitions and frames; no inferred bank assignments."""

from __future__ import annotations

import hashlib
from dataclasses import dataclass
from pathlib import Path


@dataclass(frozen=True)
class NSMChartEntry:
    entry_id: str
    unit_id: str
    lemma: str
    pos: str
    definition: str
    definition_kind: str
    chart_heading: str
    forms: tuple[str, ...]
    frame_text: str
    source_reference: dict
    chart_notes: str
    frames_are: str


class NSMChartParser:
    """Expose exact chart units through the ordinary source parser boundary.

    Native equivalents remain native definitions; only the remaining chart
    units are introduced here. Nothing projects participants in a frame into
    its head's lexical vector, and silence never supplies a zero.
    """

    def __init__(self):
        self.entries: dict[str, list[NSMChartEntry]] = {}
        self._loaded = False

    def load(self) -> bool:
        from GSE.curation.lexicon_builder.catalog import SOURCE, chart_definition_records

        path = Path(__file__).resolve().parents[3] / SOURCE["path"]
        if hashlib.sha256(path.read_bytes()).hexdigest() != SOURCE["sha256"]:
            raise ValueError("NSM_CHART_SOURCE_REVISION_MISMATCH")
        entries: dict[str, list[NSMChartEntry]] = {}
        for record in chart_definition_records():
            entry = NSMChartEntry(**record)
            entries.setdefault(entry.lemma, []).append(entry)
        self.entries = entries
        self._loaded = True
        return True

    def get_all_words(self) -> list[str]:
        if not self._loaded:
            self.load()
        return sorted(self.entries)

    def get_entries(self, word: str) -> tuple[NSMChartEntry, ...]:
        if not self._loaded:
            self.load()
        return tuple(self.entries.get(word.lower(), ()))

    def to_primitives_for_entry(self, entry: NSMChartEntry) -> dict[str, int]:
        if not isinstance(entry, NSMChartEntry) or entry not in self.get_entries(entry.lemma):
            raise ValueError("UNKNOWN_NSM_CHART_DEFINITION")
        return {}

    def to_primitives(self, word: str) -> dict[str, int]:
        return {}

