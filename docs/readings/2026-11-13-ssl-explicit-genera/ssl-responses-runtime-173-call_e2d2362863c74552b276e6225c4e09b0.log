
### GSE/symbolic/expression.py
from __future__ import annotations
from dataclasses import dataclass, field, replace
from typing import TYPE_CHECKING, Dict, List, Optional, Sequence, Tuple, Union
from GSE.api.trace import ClauseSpan, OperationTrace, OperatorTrace, TokenTrace
from GSE.lexicon.function_words import get_preposition_encoding
from GSE.primitives_v2 import get_hierarchy_encoding
from GSE.symbolic.duration import Duration, split_duration, temporal_offset
from GSE.symbolic.modality import modal_primes
if TYPE_CHECKING:
    from GSE.symbolic.predicates import Predicate
class Op:
    """A compositional operator from the trace, lifted into the AST.

    Args:
        primitive: the COMP_* name (e.g., ``COMP_THAN``).
        operation: the operation label from COMP_METADATA (e.g.,
            ``SET_DIFF``). This is what B2 dispatches on.
        arity: 1 or 2 — number of arguments the operator consumes.
        args: the lifted argument expressions.
        modal: an EVENT's modal primes, from its clause's auxiliaries ("might" → ``("MAYBE",)``); empty otherwise
            (#66). Every rebuild of an Op carries it.
    """

    primitive: str
    operation: str
    arity: int
    args: List["Operand"]
    modal: tuple = ()
    duration: Duration | None = None
Expression = Union[Atom, Phrase, Negation, Op]
Operand = Union[Atom, Phrase, Negation, "Op", "Predicate"]
_NEGATION_LEMMAS = frozenset({"not", "no", "never", "neither", "nor", "nothing"})
_UPTAKE_PASS_POS = frozenset({"DET"})
_UPTAKE_QUOTATION_MARKS = frozenset({'"', "“", "”", "'", "‘", "’", "``", "''"})
_UPTAKE_GAP_POS = frozenset({"AUX", "PART", "ADP", "SCONJ", "CCONJ", "ADV"})
_COMPARATIVE_RUN_POS = frozenset({"ADJ", "ADV", "NOUN", "NUM", "DET"})
_HIER_MARKS = frozenset({"HIER_PLUS", "HIER_MINUS"})
Signs = Dict[int, Tuple[str, int, str]]
_CORRELATIVE_NEGATIONS = frozenset({"neither", "nor"})
_COPULA_SUBJECT = "SYN_SUBJ"
_COPULA_PREDICATE = "SYN_PRED"
_COPULA_COMPLEMENT = "SYN_COMPL"
_COPULA_LEMMA = "be"
_COMPLEMENT_POS = frozenset({"NOUN", "PROPN", "ADJ"})
_PP_OBJECT_POS = frozenset({"NOUN", "PROPN", "PRON"})
_SUBJECT_POS = {"PROPN", "NOUN", "PRON"}
_RELATIVIZER_LEMMAS = frozenset({"that", "who", "whom", "which", "whose"})

