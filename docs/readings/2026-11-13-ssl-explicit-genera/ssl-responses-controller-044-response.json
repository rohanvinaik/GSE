      "arguments": "{\"command\":\"/Users/rohanvinaik/Projects/SquishOS/ops/agents/bin/owned-run --label ssl-controller-real-entry-adversarial -- env PYTHONPATH=. .venv/bin/python - <<'PY'\\nfrom pathlib import Path\\nfrom contextlib import closing\\nfrom dataclasses import asdict,replace\\nimport runpy,json\\nfrom GSE.curation.lexicon_builder.completion import _entry\\nfrom GSE.curation.lexicon_builder.epoch import connect,read,record,fingerprint,parse_plan\\nfrom GSE.curation.lexicon_builder.residual import BankRequest,complete_bank,_request_id\\nfrom GSE.curation.lexicon_builder.evidence import Definition\\nfrom GSE.curation.lexicon_builder.foundation import BANKS,lexical_context\\nfrom GSE.curation.lexicon_builder.rule_revisions import touches_scope,exception_source\\nfrom GSE.curation.lexicon_builder.specification import measure_resolution,space_delta\\nfrom GSE.curation.lexicon_builder.validation import _metadata,_relations,_stored_context\\nroot=Path('docs/readings/2026-11-13-ssl-explicit-genera');m=runpy.run_path(str(root/'ssl_api_checkpoint.py'));model=m['RetainedTransport']();p=model.packet['questions'][0];raw=p['request'];request=BankRequest(raw['entry_id'],raw['bank'],tuple(raw['allowed_values']),raw['known'],tuple(raw['observations']),p['request_id'],Definition(**raw['definition']),raw['scaffold'],raw['format'])\\nassert request.payload()==raw and request.output_schema()==p['schema']\\nwith closing(connect(m['BASE'])) as conn:\\n definition,assertions,restrictions,_=_entry(conn,request.entry_id);rules=_relations(_metadata(conn,'relations'));context=raw['scaffold']['context']\\n accepted=complete_bank(request,BANKS,assertions,rules,model,context,evidence_banks=tuple(sorted(BANKS)),domain_restrictions=restrictions)\\n assert accepted.code=='ASSIGNED' and accepted.assertion.value==0\\n calls_before=len(model.replayed)\\n changed=replace(request,known={**request.known,'YOU':0})\\n stale=complete_bank(changed,BANKS,assertions,rules,model,context,evidence_banks=tuple(sorted(BANKS)),domain_restrictions=restrictions)\\n assert stale.code=='STALE_REQUEST' and len(model.replayed)==calls_before\\n class WrongBank:\\n  identity=model.identity\\n  def __call__(self,payload,schema):return '{\\\"YOU\\\":0}'\\n wrong=complete_bank(request,BANKS,assertions,rules,WrongBank(),context,evidence_banks=tuple(sorted(BANKS)),domain_restrictions=restrictions)\\n assert wrong.code=='INVALID_OUTPUT'\\n class Null:\\n  identity=model.identity\\n  def __call__(self,payload,schema):return '{\\\"I\\\":null}'\\n unknown=complete_bank(request,BANKS,assertions,rules,Null(),context,evidence_banks=tuple(sorted(BANKS)),domain_restrictions=restrictions)\\n assert unknown.code=='ABSTAINED' and unknown.resolution.domains['I']==frozenset({-1,0,1})\\n before=measure_resolution(unknown.resolution);after=measure_resolution(accepted.resolution)\\n changed_banks=[b for b in BANKS if unknown.resolution.domains[b]!=accepted.resolution.domains[b]]\\n assert changed_banks==['I']\\n scopes=[]\\n for family in parse_plan(read(m['PLAN'])).values():\\n  rule=family.relation()\\n  for identity in ['wordnet:water:water.n.01','wordnet:self:self.n.02','wordnet:person:person.n.01']:\\n   source=exception_source(conn,identity);ctx=lexical_context(source['definition'],(source['observation'],),(rule,))\\n   applied=touches_scope((rule,),ctx)\\n   assert applied==(identity=='wordnet:water:water.n.01')\\n   scopes.append({'family':family.id,'entry_id':identity,'applicable':applied,'context':ctx})\\nreport={'format':'GSE.ssl-real-entry-adversarial/1','baseline_sha256':fingerprint(m['BASE']),'entry_id':request.entry_id,'request_id':request.request_id,'retained_original_result':accepted.code,'retained_assertion':asdict(accepted.assertion),'stale_context':stale.code,'wrong_bank':wrong.code,'null_answer':unknown.code,'changed_banks_in_memory':changed_banks,'per_entry_typed_teaching':space_delta(before,after),'scope_controls':scopes,'semantic_authority':'RETAINED_ORIGINAL_LOCAL_MODEL