
### GSE/curation/lexicon_builder/foundation.py
def load_manifest(path: str | Path | None) -> tuple[tuple[Relation, ...], dict[str, tuple[Assertion, ...]], dict]:
    """Load explicit approved rules/anchors and NUMBER metadata, never infer approval.

    Anchors are keyed by dictionary entry ID, not spelling. Each assertion must
    name its source and record. A manifest cannot mint additional coordinates.
    """
    if path is None:
        return (), {}, {}
    raw = read_json(path)
    if not isinstance(raw, dict) or current_id(raw.get("format")) != "GSE.lexicon-rules/1":
        raise ValueError("INVALID_RULE_MANIFEST")
    if set(raw) - {"format", "relations", "anchors", "hierarchy", "definitions", "prime_entries"}:
        raise ValueError("UNKNOWN_MANIFEST_FIELD")
    if not isinstance(raw.get("relations", []), list) or not isinstance(raw.get("anchors", {}), dict):
        raise ValueError("INVALID_RULE_MANIFEST")
    for entry_id, records in raw.get("anchors", {}).items():
        if not isinstance(entry_id, str) or not entry_id.strip() or not isinstance(records, list):
            raise ValueError("INVALID_ANCHORS")
    relations = []
    for record in raw.get("relations", []):
        required = {"rule_id", "banks", "allowed_rows", "provenance"}
        if (
            not isinstance(record, dict)
            or not required <= record.keys()
            or set(record) - required - {"authority", "approved", "guards", "absent_evidence"}
        ):
            raise ValueError("INVALID_RELATION_RECORD")
        for key in ("banks", "provenance", "allowed_rows", "guards", "absent_evidence"):
            if not isinstance(record.get(key, []), list):
                raise ValueError("INVALID_RELATION_SEQUENCE")
        if any(not isinstance(row, list) for row in record["allowed_rows"] + record.get("guards", [])):
            raise ValueError("INVALID_RELATION_ROWS")
        record = dict(record)
        for key in ("banks", "provenance"):
            record[key] = tuple(record[key])
        record["allowed_rows"] = tuple(tuple(row) for row in record["allowed_rows"])
        record["guards"] = tuple(tuple(pair) for pair in record.get("guards", []))
        record["absent_evidence"] = tuple(record.get("absent_evidence", []))
        relations.append(Relation(**record))
    try:
        anchors = {
            entry_id: tuple(Assertion(**record) for record in records)
            for entry_id, records in raw.get("anchors", {}).items()
        }
    except TypeError as exc:
        raise ValueError("INVALID_ANCHOR_RECORD") from exc
    hierarchy = raw.get("hierarchy", {})
    if not isinstance(hierarchy, dict):
        raise ValueError("INVALID_HIERARCHY")
    for entry_id, targets in hierarchy.items():
        if not isinstance(entry_id, str) or not isinstance(targets, dict):
            raise ValueError("INVALID_HIERARCHY")
        for bank, level in targets.items():
            if bank not in BANKS or type(level) is not int:
                raise ValueError("INVALID_HIERARCHY_TARGET")
    validate_lexical_guards(relations)
    return tuple(relations), anchors, hierarchy
def load_manifest_extensions(path: str | Path | None):
    """Explicit hand-authored definitions and prime-unit identity bindings.

    Existing source identities must be reused when they denote the same definition;
    neither this boundary nor catalog coverage merges meanings by spelling.
    """
    from .evidence import Definition

    if path is None:
        return (), {}
    raw = read_json(path)
    records = raw.get("definitions", [])
    links = raw.get("prime_entries", {})
    if not isinstance(records, list) or not isinstance(links, dict):
        raise ValueError("INVALID_MANIFEST_DEFINITIONS")
    definitions = []
    for record in records:
        required = {"entry_id", "lemma", "pos", "definition"}
        if not isinstance(record, dict) or not required <= record.keys() or set(record) - required - {"source_ids"}:
            raise ValueError("INVALID_MANIFEST_DEFINITION")
        if not isinstance(record.get("source_ids", []), list):
            raise ValueError("INVALID_MANIFEST_SOURCE_IDS")
        definitions.append(
            Definition(
                record["entry_id"],
                record["lemma"],
                record["pos"],
                record["definition"],
                tuple(record.get("source_ids", [])),
            )
        )
    for unit, entries in links.items():
        if (
            not isinstance(unit, str)
            or not isinstance(entries, list)
            or any(not isinstance(entry, str) or not entry.strip() for entry in entries)
        ):
            raise ValueError("INVALID_PRIME_ENTRIES")
    return tuple(definitions), {unit: tuple(entries) for unit, entries in links.items()}

### GSE/curation/lexicon_builder/rule_migration.py
def _apply_copy(conn, admission=None, *, revision=None):
    old = _relations(_metadata(conn, "relations"))
    if revision is None:
        if admission is None:
            raise ValueError("MIGRATION_REQUIRES_REVIEW")
        if admission["warrant"].get("required_exception_ids") or admission["warrant"].get("required_reservation_ids"):
            raise ValueError("RULE_REQUIRES_JOINT_EXCEPTION_REVIEW")
        if digest(relation_records(old)) != admission["baseline_version"]:
            raise ValueError("MIGRATION_BASELINE_VERSION_MISMATCH")
        addition = _relations([json.loads(_json(admission["relation"]))])[0]
        if any(rule.rule_id == addition.rule_id for rule in old):
            raise ValueError("MIGRATION_RULE_ALREADY_PRESENT")
        new = old + (addition,)
    else:
        new = revision_relations(conn, old, revision)
    removed, added = rule_changes(old, new)
    shared = tuple(rule for rule in old if rule not in removed)
    local_reviews = defaultdict(list)
    reservation_reviews = defaultdict(list)
    if revision is not None:
        for review in revision["exceptions"]:
            local_reviews[review["entry_id"]].append(review)
        for review in revision.get("reservations", ()):
            reservation_reviews[review["entry_id"]].append(review)
    preflight = _replay(conn, old)
    if preflight["code"] != "REPLAY_VALIDATED" or not preflight["complete_search"]:
        raise ValueError("MIGRATION_REQUIRES_COMPLETE_REPLAY")
    entries = tuple(row[0] for row in conn.execute("SELECT entry_id FROM definition_states ORDER BY entry_id"))
    _, models = _authorities(conn)
    failures = []
    native, _, relevance = _observations(conn, set(entries), lambda *a, **kw: failures.append((a, kw)), models)
    if failures:
        raise ValueError("MIGRATION_SOURCE_INVALID")
    history = read_history(conn, old)
    install_history(conn)
    old_version, new_version = _put_version(conn, old), _put_version(conn, new)
    archived, retained, changed, narrowed = [], 0, 0, 0
    known_changes, exception_checks = [], []
    reservation_checks = []
    for entry_id in entries:
        definition, assertions, restrictions, hierarchy = _entry(conn, entry_id)
        old_context = _stored_context(conn, definition, old)
        new_context = _stored_context(conn, definition, new)
        evidence_banks = tuple(sorted(relevance.get(entry_id, ())))
        receipts = models.get(entry_id, ())
        reviews = local_reviews.get(entry_id, ())
        withdrawn = reviewed_model_withdrawals(reviews, receipts)
        for receipt in receipts:
            request_id, receipt_hash = receipt_binding_key(receipt)
            if not conn.execute(
                "SELECT 1 FROM model_rule_versions WHERE request_id=? AND receipt_sha256=?", (request_id, receipt_hash)
            ).fetchone():
                conn.execute(
                    "INSERT INTO model_rule_versions VALUES (?,?,?,?)",
                    (request_id, entry_id, old_version, receipt_hash),
                )
        # Matching the guard is deliberately conservative, even if the premise
        # is currently unknown or an absence guard might block the new rule.
        scope_affected = touches_scope(removed, old_context) or touches_scope(added, new_context)
        first_affected = (
            0
            if scope_affected
            else next((i for i, receipt in enumerate(receipts) if receipt["request_id"] in withdrawn), len(receipts))
        )
        prefix, dropped = receipts[:first_affected], receipts[first_affected:]
        before = _read_json(
            conn.execute("SELECT domains FROM definition_states WHERE entry_id=?", (entry_id,)).fetchone()[0]
        )
        if dropped:
            archived.append(
                {
                    "definition": {key: getattr(definition, key) for key in ("entry_id", "lemma", "pos", "definition")},
                    "assertions": [asdict(a) for a in assertions],
                    "restrictions": [asdict(r) for r in restrictions],
                    "receipts": dropped,
                    **({"retained_prefix": prefix} if prefix else {}),
                    "evidence_banks": evidence_banks,
                    "reason": "REVIEWED_EXCEPTION_REQUIRES_MODEL_RECONSIDERATION"
                    if withdrawn
                    else "ADDED_RULE_SCOPE_REQUIRES_MODEL_CONTEXT_RECONSIDERATION"
                    if revision is None
                    else "REVISED_RULE_SCOPE_REQUIRES_MODEL_CONTEXT_RECONSIDERATION",
                }
            )
            retired_assertions = {_json(r["assertion"]) for r in dropped}
            assertions = tuple(a for a in assertions if _json(asdict(a)) not in retired_assertions)
            deleted = conn.execute(
                "DELETE FROM accepted_model_receipts WHERE entry_id=? AND ordinal>=?", (entry_id, first_affected)
            ).rowcount
            if deleted != len(dropped):
                raise ValueError("MIGRATION_MODEL_RECEIPT_DELETE_MISMATCH")
        retained += len(prefix)
        baseline = resolve_dictionary(
            BANKS, assertions, shared, old_context, evidence_banks=evidence_banks, domain_restrictions=restrictions
        )
        after = resolve_dictionary(
            BANKS, assertions, new, new_context, evidence_banks=evidence_banks, domain_restrictions=restrictions
        )
        if (
            baseline.code == "CONFLICT"
            or any(r["kind"] == "SOLVER_LIMIT" for r in baseline.trace)
            or after.code == "CONFLICT"
            or any(r["kind"] == "SOLVER_LIMIT" for r in after.trace)
            or _exception_keys(after) - _exception_keys(baseline)
        ):
            raise ValueError("MIGRATION_RULE_SCOPE_COUNTEREXAMPLE:" + entry_id)
        if any(after.assignments.get(bank) != value for bank, value in baseline.assignments.items()):
            raise ValueError("MIGRATION_CHANGED_RETAINED_KNOWN:" + entry_id)
        if any(after.assignments.get(bank) not in {-1, 1} for bank in hierarchy):
            raise ValueError("MIGRATION_HIERARCHY_REQUIRES_REVIEW:" + entry_id)
        after_domains = {bank: sorted(values) for bank, values in after.domains.items()}
        changed += before != after_domains
        narrowed += sum(len(after.domains[b]) < len(baseline.domains[b]) for b in BANKS)
        if revision is not None and before != after_domains:
            known_changes.extend(
                {"entry_id": entry_id, "bank": bank, "before": before[bank], "after": values}
                for bank, values in after_domains.items()
                if len(before[bank]) == 1 and before[bank] != values
            )
        for review in reviews:
            if any(value not in baseline.domains[bank] for bank, value in review["counterexample"].items()):
                raise ValueError("REVISION_EXCEPTION_CONFLICTS_WITH_RETAINED_EVIDENCE:" + entry_id)
            if any(value not in after.domains[bank] for bank, value in review["counterexample"].items()):
                raise ValueError("REVISION_EXCEPTION_NOT_HONORED:" + entry_id)
            exception_checks.append(
                {
                    "entry_id": entry_id,
                    "rule_id": review["rule_id"],
                    "code": "REVIEWED_LOCAL_EXCEPTION",
                    "reviewed_model_withdrawals": list(withdrawn),
                    "baseline_domains": {bank: sorted(baseline.domains[bank]) for bank in review["counterexample"]},
                    "after_domains": {bank: after_domains[bank] for bank in review["counterexample"]},
                }
            )
        for review in reservation_reviews.get(entry_id, ()):
            bank = review["bank"]
            expected = review["audit"]["request"]["allowed_values"]
            if (
                before[bank] != expected
                or sorted(baseline.domains[bank]) != expected
                or after_domains[bank] != expected
            ):
                raise ValueError("REVISION_RESERVATION_NOT_HONORED:" + entry_id)
            reservation_checks.append(
                {
                    "code": "REVIEWED_UNRESOLVED_RESERVATION",
                    "entry_id": entry_id,
                    "rule_id": review["rule_id"],
                    "bank": bank,
                    "baseline_domain": expected,
                    "after_domain": after_domains[bank],
                    "audit_request_id": review["audit"]["request_id"],
                }
            )
        store_entry(conn, definition, after, assertions, hierarchy, domain_restrictions=restrictions)
    event = {
        "format": "GSE.rule-migration-event/1",
        "from_version": old_version,
        "to_version": new_version,
        "created_utc": datetime.now(UTC).isoformat(),
        "admission": admission,
        "archived": archived,
    }
    if (
        revision is not None
        or history
        and any(current_id(item["format"]) == "GSE.rule-migration-event/2" for item in history["events"])
    ):
        del event["admission"]
        event.update(
            format="GSE.rule-migration-event/2",
            previous_event=history["head"] if history else None,
            revision=revision
            if revision is not None
            else {
                "format": REVISION_FORMAT,
                "baseline_version": old_version,
                "admissions": [admission],
                "retirements": [],
                "exceptions": [],
            },
        )
    event_id = digest(event)
    conn.execute("INSERT INTO rule_migrations VALUES (?,?)", (event_id, _json(event)))
    for key, value in (("relations", relation_records(new)), ("rule_version", new_version)):
        conn.execute("INSERT OR REPLACE INTO builder_metadata VALUES (?,?)", (key, _json(value)))
    coverage = _refresh_catalog(conn, new, native, relevance)
    verified = _replay(conn, new)
    if verified["code"] != "REPLAY_VALIDATED" or not verified["complete_search"]:
        raise ValueError("MIGRATION_POST_REPLAY_FAILED:" + _json(verified["mismatch_counts"]))
    return {
        "format": "GSE.rule-migration/1" if revision is None else "GSE.rule-migration/2",
        "code": "MIGRATED_CANDIDATE",
        "event_id": event_id,
        "from_version": old_version,
        "to_version": new_version,
        "entries_reclosed": len(entries),
        "entries_changed_domains": changed,
        "cells_symbolically_narrowed": narrowed,
        "archived_model_receipts": sum(len(e["receipts"]) for e in archived),
        "retained_model_receipts": retained,
        "preflight": preflight,
        "postflight": verified,
        "coverage": {key: coverage[key] for key in ("definitions", "outcomes", "cells")},
        "active_pointer_changed": False,
        "model_calls": 0,
        **(
            {
                "revised_scope_changes": {
                    "old_rule_ids": [rule.rule_id for rule in removed],
                    "new_rule_ids": [rule.rule_id for rule in added],
                },
                "known_domain_changes": known_changes,
                "reviewed_exceptions": exception_checks,
                **({"reviewed_reservations": reservation_checks} if reservation_checks else {}),
            }
            if revision is not None
            else {}
        ),
    }
def migrate_revision(source, output, revision):
    """Apply the complete reviewed delta as one atomic, replayed transition."""
    validate_revision_shape(revision)
    return _migrate(source, output, revision=revision)

### GSE/curation/lexicon_builder/validation.py
def _authorities(conn):
    anchors = _optional_metadata(conn, "anchors", {})
    if not isinstance(anchors, dict):
        raise ValueError("INVALID_ASSERTION_AUTHORITIES")
    anchor_records = {}
    for entry_id, records in anchors.items():
        if not _identity(entry_id) or not isinstance(records, list):
            raise ValueError("INVALID_ANCHOR_AUTHORITY")
        anchor_records[entry_id] = _assertions([(i, _canonical(record)) for i, record in enumerate(records)])
    return anchor_records, read_model_receipts(conn)
def _provenance(
    entry_id,
    assertions,
    definition,
    relations,
    native,
    relevant,
    anchors,
    models,
    conn,
    evidence_banks=(),
    domain_restrictions=(),
    *,
    rule_history=None,
):
    """Check authority separately from whether an assertion changes a domain."""
    remaining_anchors = Counter(anchors.get(entry_id, ()))
    remaining_models = list(models.get(entry_id, ()))
    prefix = ()
    model_started = False
    for assertion in assertions:
        if remaining_anchors[assertion]:
            if model_started:
                raise ValueError("MODEL_BEFORE_SYMBOLIC_EVIDENCE")
            remaining_anchors[assertion] -= 1
        else:
            matching = [record for record in remaining_models if record["assertion"] == asdict(assertion)]
            if matching:
                model_started = True
                if len(matching) != 1:
                    raise ValueError("AMBIGUOUS_MODEL_AUTHORITY")
                receipt = matching[0]
                from .rule_history import read_history, receipt_relations

                if rule_history is None:
                    rule_history = read_history(conn, relations)
                payload = receipt["request"]
                if not isinstance(payload, dict) or not isinstance(payload.get("observations"), list):
                    raise ValueError("INVALID_MODEL_REQUEST")
                if Counter(map(_canonical, payload["observations"])) != Counter(
                    map(_canonical, _model_observations(conn, relevant[entry_id]))
                ):
                    raise ValueError("MODEL_OBSERVATIONS_MISMATCH")
                request_relations = receipt_relations(
                    receipt, relations, None, rule_history, definition=definition, observations=payload["observations"]
                )
                request_context = lexical_context(definition, payload["observations"], request_relations)
                before = resolve_dictionary(
                    BANKS,
                    prefix,
                    request_relations,
                    request_context,
                    evidence_banks=evidence_banks,
                    domain_restrictions=domain_restrictions,
                )
                request = build_request(
                    entry_id,
                    assertion.bank,
                    before,
                    tuple(payload["observations"]),
                    definition=definition,
                    relations=request_relations,
                    context=request_context,
                    request_format=payload["format"],
                )
                if (
                    request.request_id != receipt["request_id"]
                    or _canonical(identity_form(request.payload())) != _canonical(identity_form(payload))
                    or _canonical(identity_form(request.output_schema()))
                    != _canonical(identity_form(receipt["schema"]))
                    or assertion.value not in request.allowed_values
                ):
                    raise ValueError("MODEL_REQUEST_MISMATCH")
                after = resolve_dictionary(
                    BANKS,
                    prefix + (assertion,),
                    request_relations,
                    request_context,
                    evidence_banks=evidence_banks,
                    domain_restrictions=domain_restrictions,
                )
                if after.code == "CONFLICT":
                    raise ValueError("MODEL_ACCEPTED_CONTRADICTION")
                previous_exceptions = {
                    rule_id
                    for record in before.trace
                    if record["kind"] == "CONDITIONAL_EXCEPTION"
                    for rule_id in record["rule_ids"]
                }
                if any(
                    record["kind"] == "CONDITIONAL_EXCEPTION" and set(record["rule_ids"]) - previous_exceptions
                    for record in after.trace
                ):
                    raise ValueError("MODEL_ADDED_CONDITIONAL_EXCEPTION")
                if any(after.assignments.get(bank) != value for bank, value in before.assignments.items()):
                    raise ValueError("MODEL_CHANGED_KNOWN_ASSIGNMENT")
                remaining_models.remove(receipt)
            else:
                if model_started:
                    raise ValueError("MODEL_BEFORE_SYMBOLIC_EVIDENCE")
                validate_assertion_competence(assertion)
                observation = native.get((assertion.source, assertion.record_id))
                if (
                    observation is None
                    or observation.entry_id != entry_id
                    or observation.family != assertion.family
                    or observation.scope != "lexical"
                ):
                    raise ValueError("ASSERTION_PROVENANCE_MISMATCH")
                if assertion.source == "wiktionary":
                    from .evidence import wiktionary_definition_projection

                    row = conn.execute(
                        "SELECT payload FROM source_observations WHERE record_id=?", (assertion.record_id,)
                    ).fetchone()
                    features = _read_json(row[0])["features"] if row is not None else {}
                    projected = wiktionary_definition_projection(definition, features)
                    if projected.get(assertion.bank) != assertion.value:
                        genus = "PERSON" if assertion.bank == "SOMEONE" else "ANATOMY"
                        raise ValueError(f"WIKTIONARY_{genus}_PROJECTION_WITNESS_MISMATCH")
                if assertion.source == "gse_closed_class" and assertion.bank in {"I", "YOU"}:
                    from GSE.curation.external_sources.gse_closed_class import GSEClosedClassParser

                    row = conn.execute(
                        "SELECT payload FROM source_observations WHERE record_id=?", (assertion.record_id,)
                    ).fetchone()
                    features = _read_json(row[0])["features"] if row is not None else {}
                    if (
                        features.get("entry_id") != entry_id
                        or features.get("lemma") != definition.lemma
                        or features.get("definition") != definition.definition
                        or GSEClosedClassParser().reference_projection_for_observation(features).get(assertion.bank)
                        != assertion.value
                    ):
                        raise ValueError("CLOSED_CLASS_REFERENCE_PROJECTION_WITNESS_MISMATCH")
        prefix += (assertion,)
    if any(remaining_anchors.values()) or remaining_models:
        raise ValueError("UNCONSUMED_ASSERTION_AUTHORITY")
