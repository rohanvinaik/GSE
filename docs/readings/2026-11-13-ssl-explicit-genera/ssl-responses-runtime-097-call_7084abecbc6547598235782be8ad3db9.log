GSE/api/native_repair.py from GSE.api.parse_repair import _entity_like, verbs_to_promote
GSE/api/encoder.py from GSE.api.parse_repair import verbs_to_promote
GSE/api/parse_repair.py def verbs_to_promote(doc) -> Set[int]:
    """Token indices of buried (mis-tagged) verbs to promote to ``pos == VERB``.

    A buried verb is a non-VERB token whose lemma has a verb sense and whose
    nearest *content* token on each side (determiners/punctuation skipped) is
    entity-like — the transitive-mistag signature (subject before, object
    after). WS1: the flanking signal is *positional* (the token stream), NOT
    spaCy dependency arcs — ``children``/``head`` are never read. Validated to
    match the arc version on the bounded register (``scripts/ws1_parity.py``);
    the coherence gate flags any tail divergence.
    """
    toks = list(doc)

    def _nearest_content(i: int, step: int):
        j = i + step
        while 0 <= j < len(toks):
            if toks[j].pos_ not in _SKIP_FLANK_POS:
                return toks[j]
            j += step
        return None

    promote: Set[int] = set()
    for i, t in enumerate(toks):
        if t.pos_ in ("VERB", "PUNCT"):
            continue
        if not _has_verb_sense(t.lemma_):
            continue
        if _in_hyphen_compound(toks, i):  # a hyphenated noun-compound member is a modifier, not a verb
            continue
        # In a governed counted NP, the cardinal belongs to the noun phrase.
        # A clause-initial "one" can still serve as the subject of a real verb.
        if t.pos_ == "NOUN" and i >= 2 and toks[i - 2].pos_ in {"ADP", "DET"}:
            numeral = get_numeral_encoding(toks[i - 1].lemma_) or {}
            if numeral.get("quantity_type") == "cardinal":
                continue
        left = _nearest_content(i, -1)
        right = _nearest_content(i, +1)
        # A possessive determiner on the left is NOT the subject — it governs the candidate as the
        # possessed noun head ("his ambition, Macbeth murdered …" → ambition is a NOUN, murder the verb).
        # Without this, the PRON-tagged possessive reads as an entity-like subject and buries the real verb.
        if (
            left is not None
            and right is not None
            and _entity_like(left)
            and not _is_possessive_determiner(left)
            and _entity_like(right)
        ):
            promote.add(t.i)
    return promote
