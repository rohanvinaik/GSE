      "arguments": "{\"command\":\"/Users/rohanvinaik/Projects/SquishOS/ops/agents/bin/owned-run --label ssl-controller-event-frontier-census -- .venv/bin/python - <<'PY'\\nfrom pathlib import Path\\nfrom contextlib import closing\\nimport json\\nfrom GSE.curation.lexicon_builder.epoch import Family,census,connect,record,fingerprint\\nfrom GSE.curation.lexicon_builder.completion import _priority_source\\nroot=Path('docs/readings/2026-11-13-ssl-explicit-genera');base=Path('data/lexicon_builder/2026-11-12/ssl-explicit-genera/checkpoint-foundation.db')\\nwarrant={'kind':'DEFINITIONAL_DERIVATION','warrant_id':'checkpoint:native-own-event-happen','review_id':'checkpoint:native-event-defining-genus-review','reviewer':'Exact native defining-genus review; independent audits pending','source_refs':[str((root/'ssl-api-controller-event-genus-warrant.md').absolute()),str(Path('docs/program/LEXICON_CONSTRUCTION_DESIGN.md').absolute()),str(Path('data/external/references/nsm-primes-chart-v20-2022.txt').absolute())],'statement':'The exact native event.n.01 genus is something that happens at a given place and time. A witnessed IS-A path establishes the noun definition as an event-kind rather than a participant, capacity or merely associated object. Its own occurrence content warrants HAPPEN=+1 only when the stored native identity and native lemma are both exact. Taxonomy proposal labels and frequencies are not semantic authority; inherited scope must withstand independent held-out counterexamples before admission.'}\\nfamily=Family('native-own-event-happen',None,('HAPPEN',1),(('pos','noun'),('wordnet_native_lemma','true'),('wordnet_ancestor:event.n.01','true')),(),warrant)\\ninventory=census(base,{family.id:family})[family.id];members={r['entry_id']:r for r in inventory};_,freq=_priority_source('zipf',None);groups={};domains={};counts={}\\nwith closing(connect(base)) as conn:\\n for i,encoded in conn.execute('SELECT entry_id,domains FROM definition_states'):\\n  if i in members:\\n   domain=json.loads(encoded)['HAPPEN'];domains[i]=domain;key=str(domain);counts[key]=counts.get(key,0)+1\\n for i,lemma,gloss,payload in conn.execute(\\\"SELECT d.entry_id,l.lemma,l.gloss,o.payload FROM definition_states d JOIN lexemes l ON l.id=d.lexeme_id JOIN source_observations o ON o.record_id=d.entry_id WHERE o.source='wordnet_hierarchy' ORDER BY d.entry_id\\\"):\\n  if i not in members or len(domains[i])<2 or lemma.casefold() in {'leap','whisper','neatness','femur','kidney','teacher'}:continue\\n  observation=json.loads(payload);paths=observation['features']['hypernym_paths'];branch=tuple(sorted({p[p.index('event.n.01')+1] if p.index('event.n.01')+1<len(p) else 'event.n.01' for p in paths if 'event.n.01' in p}));row={'entry_id':i,'lemma':lemma,'definition':gloss,'paths':paths,'branch':branch,'frequency':freq.get(lemma.casefold(),0),'domain':domains[i],'source_sha256':members[i]['source_sha256']};groups.setdefault(branch,[]).append(row)\\nselected=[];senses=set();spellings=set()\\nfor branch,rows in sorted(groups.items(),key=lambda item:-max(r['frequency'] for r in item[1])):\\n for row in sorted(rows,key=lambda r:(-r['frequency'],r['entry_id'])):\\n  sense=members[row['entry_id']]['synset']\\n  if sense in senses or row['lemma'].casefold() in spellings:continue\\n  selected.append(row);senses.add(sense);spellings.add(row['lemma'].casefold());break\\n if len(selected)==4:break\\nreport={'format':'GSE.ssl-checkpoint-source-frontier/1','baseline_sha256':fingerprint(base),'family':family.proposal(),'scope_definitions':len(members),'HAPPEN_domains':counts,'selected_independent_native_branches':selected,'holdout_separation':'Distinct exact senses and spellings; different immediate native event branches; final benchmark examples excluded from new teaching and audits.','status':'UNADMITTED_GENUS_HYPOTHESIS_AWAITING_DEFINITIONAL_BOUNDARY_AUDITS','gold_used_as_warrant':False,'new_model_calls':0,'bank_writes':0}\\nrecord(root/'ssl-api-controller-event-frontier.json',report);record(base.parent/'ssl-api-checkpoint/event-inventory.json',inventory);print(json.dumps(report,indent=2))\\nPY\",\"cwd\":\"/Users/rohanvinaik/Projects/GSE\",\"timeout_seconds\":900}",
