@pytest.mark.parametrize(
    "text", ["A woman smiled.", "A woman smiled because she ran.", "Her dog barked.", "Alice and Bob ran."]
)
def test_source_resolution_preserves_default_bound_tree(text):
    from GSE.symbolic import evaluate_tree, from_trace, resolve, resolve_with_sources
    from GSE.symbolic.serialization import to_dict

    expression = from_trace(GSEEncoder().encode(text))
    pair = resolve_with_sources(expression)
    assert to_dict(evaluate_tree(pair["bound"])) == to_dict(evaluate_tree(resolve(expression)))


def test_source_entity_join_retains_local_pronoun_with_document_identity():
    from GSE.symbolic import resolve_document

    outcomes = [
        event
        for event in encode_document_utterance_events(GSEEncoder(), [("a", "A woman smiled."), ("b", "She ran.")])
        if event["type"] == "utterance"
    ]
    resolved = resolve_document([event["tree"] for event in outcomes], None)
    origin = entity_source_evidence(outcomes[1]["trace"], outcomes[1]["source_tree"], resolved[1])["mentions"][0]
    assert origin["state"] == "read"
    assert origin["source_head"]["lemma"] == "she"
    assert origin["source_head"]["pos"] == "PRON"
    assert origin["source_head"]["position"] == 0
    assert origin["resolved_head"]["lemma"] == "woman"
    assert origin["entity_id"] is not None


def test_source_entity_join_retains_within_sentence_pronoun_before_binding():
    event = next(
        event
        for event in encode_document_utterance_events(GSEEncoder(), [("fixed", "A woman smiled because she ran.")])
        if event["type"] == "utterance"
    )
    origins = entity_source_evidence(event["trace"], event["source_tree"], event["tree"])
    assert origins["state"] == "read"
    pronouns = [row for row in origins["mentions"] if row["source_head"]["pos"] == "PRON"]
    assert len(pronouns) == 1
    assert pronouns[0]["source_head"]["lemma"] == "she"
    assert pronouns[0]["source_head"]["position"] == 4
    assert pronouns[0]["resolved_head"]["lemma"] == "woman"


def test_source_origin_failure_does_not_erase_primary_reading(simple_pipeline, monkeypatch):
    import GSE.symbolic

    calls = []

    def evaluate(node):
        calls.append(node)
        if len(calls) == 2:
            raise ValueError("auxiliary source evaluation failed")
        return node

    monkeypatch.setattr(GSE.symbolic, "evaluate_tree", evaluate)
    event = list(encode_document_utterance_events(Encoder(), [("fixed", "good")]))[1]
    assert event["state"] == "read" and event["tree"] is not None and event["error"] is None
    assert event["source_tree"] is None
    assert event["source_origins"] == {
        "state": "unread",
        "reason": "source_evaluation_error",
        "error_type": "ValueError",
    }


def test_source_entity_join_refuses_changed_path_and_does_not_count_copied_antecedent_children():
    trace = {"tokens": [{"position": 0, "lemma": "she", "token": "She"}]}
    source = {"_kind": "Event", "agent": {"_kind": "Entity", "head": {"lemma": "she", "position": 0}}}
    bound = {
        "_kind": "Event",
        "agent": {
            "_kind": "Entity",
            "head": {"lemma": "woman", "position": 1},
            "entity_id": "e0",
            "possessor": {"_kind": "Entity", "head": {"lemma": "bob"}},
        },
    }
    evidence = entity_source_evidence(trace, source, bound)
    assert evidence["state"] == "read" and len(evidence["mentions"]) == 1
    assert evidence["mentions"][0]["entity_id"] == "e0"
    changed = entity_source_evidence(trace, source, {"_kind": "Event", "patient": bound["agent"]})
    assert changed["state"] == "partial"
    assert changed["mentions"][0]["reason"] == "source_entity_path_changed"
    assert changed["mentions"][0]["entity_id"] is None


FILE tests/test_claim_semantics.py
"""Two signs of the shared claim contract, including the real public KB door."""

import pytest

from GSE.api import GSEEncoder
from GSE.symbolic import evaluate_tree, from_trace, resolve
from GSE.symbolic.claims import claim_key, commitment, commitment_modes, identity, polarity, scope_signature
from GSE.symbolic.emit import emit_contract
from GSE.symbolic.expression import Atom, Negation
from GSE.symbolic.inference import KnowledgeBase
from GSE.symbolic.narrative import NarrativeGraph, _collect_predicates, _trace_key
from GSE.symbolic.predicates import ClauseCoordination, Conditional, Event, Temporal, TypeAssertion
from GSE.symbolic.propositions import Proposition, propositions
from GSE.symbolic.resolution import Entity


@pytest.fixture(scope="module")
def encoder():
    with GSEEncoder() as enc:
        yield enc


def _entity(lemma, eid=None):
    return Entity(Atom(lemma), entity_id=eid)


@pytest.mark.parametrize(
    "modes,expected",
    [
        ((), "committed"),
        (("negated",), "committed"),
        (("negated", "possible"), "non_committed"),
        (("epistemic", "negated"), "committed"),
        (("belief",), "non_committed"),
        (("asserted", "belief"), "non_committed"),
        (("conditional",), "non_committed"),
        (("irrealis",), "non_committed"),
        (("necessary",), "non_committed"),
        (("negated", "epistemic"), "abstained"),
        (("negated", "belief"), "abstained"),
        (("abstained",), "abstained"),
        (("question",), "in_question"),
        (("in_question",), "in_question"),
        (("unrecognized",), "non_committed"),
    ],
)
def test_flat_scope_decision_has_both_signs(modes, expected):
    assert commitment_modes(modes) == expected


def test_structural_invalidity_and_interrogative_evidence_have_named_decisions():
    assert commitment_modes(("negated",), valid=False) == "unresolved"
    assert commitment_modes(("negated", "epistemic"), interrogative=True) == "in_question"
    assert commitment(None) == "unresolved"
    assert polarity(Proposition(Event("", None))).state == "unresolved"


def test_possible_negative_is_not_a_committed_negative(encoder):
    possible = evaluate_tree(resolve(from_trace(encoder.encode("He might not leave."))))
    definite = evaluate_tree(resolve(from_trace(encoder.encode("He did not leave."))))
    (p,) = propositions(possible)
    (q,) = propositions(definite)
    assert p.status == q.status == "negated"  # legacy status cannot decide commitment
    assert commitment(p) == "non_committed"
    assert commitment(q) == "committed"
    assert polarity(p).sign == polarity(q).sign == -1


def test_belief_and_denied_knowing_do_not_admit_their_content(encoder):
    belief = evaluate_tree(resolve(from_trace(encoder.encode("She believes that he left."))))
    denied = evaluate_tree(resolve(from_trace(encoder.encode("She does not know that he left."))))
    assert commitment(propositions(belief)[-1]) == "non_committed"
    assert commitment(propositions(denied)[-1]) == "abstained"
    assert polarity(propositions(denied)[-1]).clause_sign == 1


def test_source_question_cannot_become_a_fact():
    event = Event("bark", _entity("rex"))
    (question,) = propositions(event, source_text="Rex barks?")
    assert commitment(question) == "in_question"
    assert commitment(Proposition(event), interrogative=True) == "in_question"
    kb = KnowledgeBase.from_trees([event], source_texts=["Rex barks?"])
    assert kb.event("bark", "rex").state == "not_entailed"
    assert kb.admissions[0].commitment == "in_question"


def test_negation_must_not_distribute_over_conjunction():
