"""Narrow noun-genus frames shared by exact native dictionary senses."""

import re
from functools import lru_cache

NATIVE_FRAME_PREFIX = "native_noun_frame:"
WIKTIONARY_ANATOMY_FRAME_PREFIX = "wiktionary_anatomy_frame:"
WIKTIONARY_ANATOMY_FRAMES = {
    "organ_gland": frozenset({"organ", "gland"}),
    "physical_structure": frozenset(
        {"artery", "bone", "cartilage", "ligament", "muscle", "nerve", "skin", "tendon", "vein"}
    ),
}
_MENTAL_ANATOMY_ATTACHMENT = re.compile(
    r"\b(?:desires?|desired|desiring|wants?|wanted|wanting|wills?|volition(?:al)?|intentions?|intentionally|"
    r"wishes?|wishing|emotions?|emotional|affections?|appetites?|urges?|motivation|aversion)\b",
    re.IGNORECASE,
)
NATIVE_NOUN_FRAMES = frozenset(
    {
        "part_of",
        "word_unit",
        "coordinated_person",
        "person_own_capacity",
        "explicit_person",
        "explicit_place",
        "explicit_time",
        "explicit_stative",
        "stative_being",
        "explicit_occurrence",
        "agentive_intervention",
        "agentive_acquisition",
        "qualified_occurrence",
        "temporal_extent",
        "human_collective",
    }
)
_BOUNDARY = re.compile(r"[,;:!?/\[\]()\n\r]|\bor\b")
_PART = re.compile(r"^(?:(?:a|the) )?part of \S")
_WORD = re.compile(r"^(?:a|the) word (?:that|which|used|for|meaning) \S")
_PERSON = re.compile(r"^(?:a|the) person (?:who|that) \S")
_EXPLICIT_PERSON = re.compile(r"^(?:(?:a|the) person|someone) (?:who|that) (?!is part\b)\S")
_EXPLICIT_PLACE = re.compile(r"^a place (?:where|in which) \S")
_EXPLICIT_TIME = re.compile(r"^(?:a|the) (?:time|period of time) (?:when|during which) \S")
_EXTENT_QUALIFIER = (
    r"(?:(?:brief|short|long|extended|limited|unlimited|specific|specified|certain|particular|"
    r"continuous|unbroken|indefinite|indeterminate|fixed|definite|entire|complete|regular|"
    r"recurring|initial|final|whole|measured|given|intervening|distinct|prolonged|normal) )*"
)
_TEMPORAL_EXTENT = re.compile(
    r"^(?:an?|the) "
    + _EXTENT_QUALIFIER
    + r"(?:(?:period|interval|span|duration) of time|time (?:period|interval|span))(?:$| )"
)
_HUMAN_COLLECTIVE = re.compile(
    r"^(?:(?:an?|the) (?:group|class|body|collection) of (?:people|persons|human beings)|(?:the )?people)"
    r"(?:$| (?:who|that|with|without|having|viewed|considered|engaged|interested|raised|"
    r"living|migrating|collectively|capable|in|of|from)\b)"
)
_EXPLICIT_STATIVE = re.compile(r"^(?:a|the) state (?:of|in which) \S")
_STATIVE_BEING = re.compile(r"^(?:a|the) state of being (?P<condition>\S.*)$")
_EXPLICIT_OCCURRENCE = re.compile(
    r"^(?:(?:an|the) event(?:$| (?:of|that|which|in which|causing|involving|during which) \S)"
    r"|a (?:single distinct|social|formal|natural|brief) event\b"
    r"|the (?:daily )?event of \S|(?:something|anything) that happens(?: |$)"
    r"|(?:an?|the) (?:sudden |spontaneous |unexpected )?occurrence(?:$| of (?:"
    r"something|breaking|an? (?:event|change|discharge|uncontrollable condition|uniting))\b))"
)
_EVENT_UNCERTAINTY = re.compile(r"\b(?:may|might|could|can|never|not|possible|likely)\b")
_AGENTIVE_INTERVENTION = re.compile(
    r"^(?:an|the) act of (?:"
    r"(?:putting|inserting|throwing|cutting|pushing|gripping|grasping|striking|hitting) \S"
    r"|delivering a blow\b|applying force\b|making something clean\b)"
)
_INTERVENTION_BOUNDARY = re.compile(
    r"\b(?:and|being|getting|involuntar\w*|accidental\w*|automatic\w*|itself|themselves)\b|\bhitting on\b"
)
_ACQUISITION = re.compile(
    r"^(?:(?:an|the) (?:formal )?act of (?:"
    r"(?:purchasing|buying)(?: something)?"
    r"|taking (?:possession of|into custody) \S.*"
    r"|making a purchase"
    r"|apprehending(?: a (?:criminal|suspect)| \(especially apprehending a criminal\))?"
    r"|forcibly dispossessing \S.*"
    r")|(?:the )?acquisition of \S.+ for payment)$"
)
_ACQUISITION_BOUNDARY = re.compile(
    r"[,;:!?/\[\]\n\r]|\b(?:and|or|without|not|being|accidental\w*|involuntar\w*|automatic\w*)\b"
)
_EVENT_GENUS = re.compile(
    r"^(?:(?:an?|the) (?:natural |brief |sudden |designated )?|designated )event "
    r"(?:of|that|which|in which|whose|caused by|causing|resulting in|involving|consisting of) \S"
)
_QUALIFIED_EVENT_BOUNDARY = re.compile(r"[,;:!?/\[\]()\n\r]|\b(?:or|and) (?:an?|the)\b")
_EVENT_QUALIFIER = re.compile(r" \((?:especially (?:a|an|the) [a-z -]+|often [a-z -]+)\)$")
_PERSON_CAPACITY = re.compile(
    r"^(?P<subject>(?:a|the) person|someone) (?:who|that) (?P<modal>can|is able to) "
    r"(?!(?:be|get|have|never|not|only)\b)[a-z]+\b(?: |$)"
)


def wiktionary_anatomy_frame(gloss: str, pos: str, native_sense: dict) -> str | None:
    """Scope physical anatomy using the existing exact genus and attachment witness."""
    from GSE.curation.external_sources.wiktionary import native_anatomy_witness

    if not isinstance(gloss, str) or not isinstance(native_sense, dict) or _MENTAL_ANATOMY_ATTACHMENT.search(gloss):
        return None
    witness = native_anatomy_witness(gloss, pos, native_sense)
    if witness is None:
        return None
    genus, _ = witness
    return next((frame for frame, genera in WIKTIONARY_ANATOMY_FRAMES.items() if genus in genera), None)


@lru_cache(maxsize=1024)
def native_noun_frames(gloss: str) -> frozenset[str]:
    """Recognize all applicable frames, including overlaps with person coordination."""
    lowered = gloss.casefold()
    text = " ".join(lowered.split()).removesuffix(".")
    frames = set()
    if not _ACQUISITION_BOUNDARY.search(lowered) and "." not in text and _ACQUISITION.fullmatch(text):
        frames.add("agentive_acquisition")
    genus = _EVENT_QUALIFIER.sub("", text)
    if (
        "\n" not in lowered
        and "\r" not in lowered
        and "." not in genus
        and not _QUALIFIED_EVENT_BOUNDARY.search(genus)
        and not _EVENT_UNCERTAINTY.search(genus)
        and _EVENT_GENUS.match(genus)
    ):
        frames.add("qualified_occurrence")
    if _BOUNDARY.search(lowered):
        return frozenset(frames)
    if "." in text:
        return frozenset(frames)
    primary = native_noun_frame(gloss)
    if primary is not None:
        frames.add(primary)
    if _EXPLICIT_PERSON.match(text):
        frames.add("explicit_person")
    if _EXPLICIT_PLACE.match(text):
        frames.add("explicit_place")
    if _EXPLICIT_TIME.match(text):
        frames.add("explicit_time")
    # A coordinated second genus remains outside these literal-head scopes.
    # Existing frames retain their historical membership semantics.
    if " and " not in text:
        if _TEMPORAL_EXTENT.match(text):
            frames.add("temporal_extent")
        if _HUMAN_COLLECTIVE.match(text):
            frames.add("human_collective")
    if _EXPLICIT_STATIVE.match(text):
        frames.add("explicit_stative")
    stative = _STATIVE_BEING.match(text)
    if stative and _qualified_stative_condition(stative["condition"]):
        frames.add("stative_being")
    if _EXPLICIT_OCCURRENCE.match(text) and not _EVENT_UNCERTAINTY.search(text):
        frames.add("explicit_occurrence")
    if _AGENTIVE_INTERVENTION.match(text) and not _INTERVENTION_BOUNDARY.search(text):
        frames.add("agentive_intervention")
    capacity = _PERSON_CAPACITY.match(text)
    if capacity and _active_capacity_verb(text, capacity):
        frames.add("person_own_capacity")
    return frozenset(frames)


def _qualified_stative_condition(condition: str) -> bool:
    """Require a lexical predicate after being, not a dangling function word."""
    from GSE.nlp.native import NativeNLP

    return any(token.pos_ in {"NOUN", "PROPN", "PRON", "ADJ", "ADV", "VERB", "NUM"} for token in NativeNLP()(condition))


def _active_capacity_verb(text: str, capacity: re.Match[str]) -> bool:
    from GSE.nlp.native import NativeNLP

    subject_words = len(capacity["subject"].split())
    modal_words = len(capacity["modal"].split())
    tokens = tuple(NativeNLP()(text))
    index = subject_words + 1 + modal_words
    if index >= len(tokens):
        return False
    verb = tokens[index]
    return verb.pos_ == "VERB" and verb.text == verb.lemma_


@lru_cache(maxsize=1024)
def native_noun_frame(gloss: str) -> str | None:
    """Recognize defining heads while reserving alternate genera and glosses."""
    lowered = gloss.casefold()
    if _BOUNDARY.search(lowered):
        return None
    text = " ".join(lowered.split()).removesuffix(".")
    if "." in text:
        return None
    if _PART.match(text):
        return "part_of"
    if _WORD.match(text) and " and " not in text:
        return "word_unit"
    if not _PERSON.match(text) or text.count(" and ") != 1:
        return None
    from GSE.nlp.native import NativeNLP

    tokens = tuple(NativeNLP()(text))
    split = next(index for index, token in enumerate(tokens) if token.text == "and")
    verbs = {"VERB", "AUX"}
    if any(token.pos_ in verbs for token in tokens[3:split]) and tokens[split + 1].pos_ in verbs:
        return "coordinated_person"
    return None

def valid_lexical_guard(key, value) -> bool:
    """Recognize lexical scope predicates, never bank values or inferred signs."""
    if not isinstance(key, str) or not isinstance(value, str):
        return False
    if key == "pos":
        return bool(value.strip())
    if key == "wordnet_native_lemma":
        return value == "true"
    if key.startswith(NATIVE_FRAME_PREFIX):
        return value == "true" and key.removeprefix(NATIVE_FRAME_PREFIX) in NATIVE_NOUN_FRAMES
    if key.startswith(WIKTIONARY_ANATOMY_FRAME_PREFIX):
        return value == "true" and key.removeprefix(WIKTIONARY_ANATOMY_FRAME_PREFIX) in WIKTIONARY_ANATOMY_FRAMES
    if key.startswith(EXCEPTION_GUARD_PREFIX):
        identity = key.removeprefix(EXCEPTION_GUARD_PREFIX)
        return bool(identity) and not any(char.isspace() for char in identity) and value == "true"
    return value == "true" and any(
        key.startswith(prefix) and _WORDNET_SYNSET.fullmatch(key.removeprefix(prefix)) is not None
        for prefix in WORDNET_ANCESTRY_GUARD_PREFIXES
    )
