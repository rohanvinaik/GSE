SCHEMA
('accepted_model_receipts', 'CREATE TABLE accepted_model_receipts (\n entry_id TEXT NOT NULL, ordinal INTEGER NOT NULL, request_id TEXT NOT NULL UNIQUE,\n payload TEXT NOT NULL, PRIMARY KEY(entry_id,ordinal))')
('builder_assertions', 'CREATE TABLE builder_assertions (\n entry_id TEXT NOT NULL, ordinal INTEGER NOT NULL, payload TEXT NOT NULL,\n PRIMARY KEY(entry_id,ordinal))')
('builder_domain_restrictions', 'CREATE TABLE builder_domain_restrictions (\n entry_id TEXT NOT NULL, ordinal INTEGER NOT NULL, payload TEXT NOT NULL,\n PRIMARY KEY(entry_id,ordinal))')
('builder_metadata', 'CREATE TABLE builder_metadata (key TEXT PRIMARY KEY, value TEXT NOT NULL)')
('candidate_evidence', 'CREATE TABLE candidate_evidence (\n rule_id TEXT NOT NULL, category TEXT NOT NULL, ordinal INTEGER NOT NULL, payload TEXT NOT NULL,\n PRIMARY KEY(rule_id,category,ordinal))')
('candidate_relations', 'CREATE TABLE candidate_relations (\n rule_id TEXT PRIMARY KEY, summary TEXT NOT NULL)')
('completion_attempts', 'CREATE TABLE completion_attempts (\n entry_id TEXT NOT NULL, bank TEXT NOT NULL, request_id TEXT NOT NULL,\n model TEXT NOT NULL, code TEXT NOT NULL, details TEXT NOT NULL,\n PRIMARY KEY(entry_id,bank,request_id,model))')
('completion_schedule', 'CREATE TABLE completion_schedule (\n scope_id TEXT PRIMARY KEY, protocol TEXT NOT NULL, banks TEXT NOT NULL,\n cursor TEXT NOT NULL, pass_number INTEGER NOT NULL)')
('completion_visits', 'CREATE TABLE completion_visits (\n scope_id TEXT NOT NULL, pass_number INTEGER NOT NULL, entry_id TEXT NOT NULL,\n PRIMARY KEY(scope_id,pass_number,entry_id))')
('decomposition_provenance', 'CREATE TABLE decomposition_provenance (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    lexeme_id INTEGER NOT NULL,\n    primitive TEXT,\n    source_type TEXT NOT NULL,\n    source_detail TEXT,\n    timestamp TIMESTAMP DEFAULT CURRENT_TIMESTAMP,\n    confidence_before REAL,\n    confidence_after REAL,\n    FOREIGN KEY (lexeme_id) REFERENCES lexemes(id) ON DELETE CASCADE\n)')
('definition_states', 'CREATE TABLE definition_states (\n entry_id TEXT PRIMARY KEY, lexeme_id INTEGER UNIQUE NOT NULL,\n code TEXT NOT NULL, domains TEXT NOT NULL, conflicts TEXT NOT NULL,\n trace TEXT NOT NULL, hierarchy TEXT NOT NULL,\n FOREIGN KEY(lexeme_id) REFERENCES lexemes(id))')
('external_disagreements', "CREATE TABLE external_disagreements (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    lexeme_id INTEGER NOT NULL,\n    primitive TEXT NOT NULL,\n    llm_value INTEGER NOT NULL,\n    external_value INTEGER NOT NULL,\n    external_source TEXT NOT NULL,\n    severity TEXT NOT NULL,  -- 'minor', 'major', 'sign_flip'\n    resolved BOOLEAN DEFAULT FALSE,\n    resolution TEXT,  -- 'llm_correct', 'external_correct', 'both_valid', 'manual'\n    resolved_value INTEGER,\n    timestamp TIMESTAMP DEFAULT CURRENT_TIMESTAMP,\n    FOREIGN KEY (lexeme_id) REFERENCES lexemes(id) ON DELETE CASCADE\n)")
('external_source_coverage', 'CREATE TABLE external_source_coverage (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    lexeme_id INTEGER NOT NULL,\n    source_name TEXT NOT NULL,\n    primitives_matched INTEGER DEFAULT 0,\n    primitives_agreed INTEGER DEFAULT 0,\n    agreement_rate REAL,\n    timestamp TIMESTAMP DEFAULT CURRENT_TIMESTAMP,\n    FOREIGN KEY (lexeme_id) REFERENCES lexemes(id) ON DELETE CASCADE,\n    UNIQUE(lexeme_id, source_name)\n)')
('lexemes', "CREATE TABLE lexemes (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    lemma TEXT NOT NULL,\n    pos TEXT NOT NULL,\n    sense_id TEXT DEFAULT '01',\n    gloss TEXT,\n    source TEXT DEFAULT 'llm',\n    confidence REAL DEFAULT 1.0,\n    frequency_rank INTEGER,\n    frequency_weight REAL,\n    phase INTEGER DEFAULT 0,\n    validation_status TEXT DEFAULT 'pending',\n    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP, comp_primitive TEXT, comp_arity INTEGER DEFAULT 0, comp_operation TEXT,\n    UNIQUE(lemma, pos, sense_id)\n)")
('llm_batches', "CREATE TABLE llm_batches (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    batch_id TEXT UNIQUE NOT NULL,\n    phase INTEGER NOT NULL,\n    status TEXT DEFAULT 'pending',\n    words_count INTEGER,\n    started_at TIMESTAMP,\n    completed_at TIMESTAMP,\n    model_name TEXT,\n    prompt_version TEXT,\n    error_message TEXT\n)")
('model_receipt_contexts', 'CREATE TABLE model_receipt_contexts (\n context_sha256 TEXT PRIMARY KEY NOT NULL, payload TEXT NOT NULL)')
('model_reconsideration_archive', 'CREATE TABLE model_reconsideration_archive (\n event_id TEXT PRIMARY KEY NOT NULL, root_request_id TEXT NOT NULL,\n entry_id TEXT NOT NULL, convention TEXT NOT NULL, reason TEXT NOT NULL,\n created_utc TEXT NOT NULL, payload TEXT NOT NULL)')
('model_rule_versions', 'CREATE TABLE model_rule_versions (request_id TEXT NOT NULL,entry_id TEXT NOT NULL,version TEXT NOT NULL,receipt_sha256 TEXT NOT NULL,PRIMARY KEY (request_id,receipt_sha256))')
('primitive_values', "CREATE TABLE primitive_values (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    lexeme_id INTEGER NOT NULL,\n    primitive TEXT NOT NULL,\n    value INTEGER NOT NULL DEFAULT 0,\n    confidence REAL DEFAULT 1.0,\n    source TEXT DEFAULT 'inferred',\n    FOREIGN KEY (lexeme_id) REFERENCES lexemes(id) ON DELETE CASCADE,\n    UNIQUE(lexeme_id, primitive)\n)")
('processing_checkpoints', 'CREATE TABLE processing_checkpoints (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    phase INTEGER NOT NULL,\n    last_processed_rank INTEGER NOT NULL,\n    timestamp TIMESTAMP DEFAULT CURRENT_TIMESTAMP,\n    words_processed INTEGER DEFAULT 0,\n    words_validated INTEGER DEFAULT 0,\n    UNIQUE(phase)\n)')
('rule_migrations', 'CREATE TABLE rule_migrations (event_id TEXT PRIMARY KEY NOT NULL,payload TEXT NOT NULL)')
('rule_versions', 'CREATE TABLE rule_versions (version TEXT PRIMARY KEY NOT NULL,payload TEXT NOT NULL)')
('sentence_primitive_values', 'CREATE TABLE sentence_primitive_values (\n lexeme_id INTEGER NOT NULL, primitive TEXT NOT NULL, value INTEGER NOT NULL,\n UNIQUE(lexeme_id,primitive))')
('source_observations', 'CREATE TABLE source_observations (\n record_id TEXT PRIMARY KEY, entry_id TEXT, source TEXT NOT NULL,\n family TEXT NOT NULL, scope TEXT NOT NULL, payload TEXT NOT NULL)')
('sqlite_sequence', 'CREATE TABLE sqlite_sequence(name,seq)')
('unresolved_sources', 'CREATE TABLE unresolved_sources (\n ordinal INTEGER PRIMARY KEY, code TEXT NOT NULL, payload TEXT NOT NULL)')
('validation_results', 'CREATE TABLE validation_results (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    lexeme_id INTEGER NOT NULL,\n    validation_type TEXT NOT NULL,\n    passed BOOLEAN NOT NULL,\n    details TEXT,\n    timestamp TIMESTAMP DEFAULT CURRENT_TIMESTAMP,\n    FOREIGN KEY (lexeme_id) REFERENCES lexemes(id) ON DELETE CASCADE\n)')

