 """A reviewed change to one pinned rule set, with exact-definition exceptions."""

import json
from dataclasses import replace

from GSE.namespace import current_id

from .foundation import EXCEPTION_GUARD_PREFIX, _exact_wordnet_ancestry, lexical_context, validate_lexical_guards
from .rule_history import digest, relation_records

FORMAT = "GSE.rule-revision/1"
RESERVATION_FORMAT = "GSE.rule-revision/2"
REVIEW_FIELDS = {"review_id", "reviewer", "rationale", "source_refs"}


def _review(record, fields, *, optional=()):
    required = REVIEW_FIELDS | fields
    if type(record) is not dict or not required <= record.keys() <= required | set(optional):
        raise ValueError("INVALID_REVISION_REVIEW")
    if any(type(record[key]) is not str or not record[key].strip() for key in REVIEW_FIELDS - {"source_refs"}):
        raise ValueError("INVALID_REVISION_REVIEW")
    refs = record["source_refs"]
    if type(refs) is not list or not refs or any(type(ref) is not str or not ref.strip() for ref in refs):
        raise ValueError("REVISION_SOURCE_REQUIRED")


def exception_source(conn, entry_id):
    """Read the exact native definition and evidence used by a local exception."""
    from .validation import _read_json

    row = conn.execute(
        "SELECT l.lemma,l.pos,l.gloss,o.payload FROM definition_states d "
        "JOIN lexemes l ON l.id=d.lexeme_id JOIN source_observations o ON o.record_id=d.entry_id "
        "WHERE d.entry_id=? AND o.entry_id=d.entry_id AND o.scope='lexical' AND o.source='wordnet_hierarchy'",
        (entry_id,),
    ).fetchone()
    if row is None:
        raise ValueError("REVISION_EXCEPTION_SOURCE_MISSING")
    definition = dict(entry_id=entry_id, lemma=row[0], pos=row[1], definition=row[2])
    observation = _read_json(row[3])
    if not _exact_wordnet_ancestry(definition, observation):
        raise ValueError("REVISION_EXCEPTION_SOURCE_IDENTITY_MISMATCH")
    return {"definition": definition, "observation": observation}


def rule_changes(before, after):
    """Approved relations whose applicability or consequence may have changed."""
    old = {rule.rule_id: rule for rule in before}
    new = {rule.rule_id: rule for rule in after}
    return (
        tuple(rule for rule in before if rule.approved and new.get(rule.rule_id) != rule),
        tuple(rule for rule in after if rule.approved and old.get(rule.rule_id) != rule),
    )


def touches_scope(relations, context):
    return any(all(context.get(key) == value for key, value in rule.guards) for rule in relations)


def reviewed_model_withdrawals(reviews, receipts):
    """Match an explicit local reconsideration to a live or archived receipt."""
    requested = set()
    for review in reviews:
        if "withdraw_model_receipt_sha256" not in review:
            continue
        key = review["withdraw_model_receipt_sha256"]
        matches = [row for row in receipts if digest(row) == key]
        if len(matches) != 1:
            raise ValueError("REVISION_EXCEPTION_MODEL_RECEIPT_CHANGED")
        [receipt] = matches
        claim = receipt["assertion"]
        if (
            receipt["entry_id"] != review["entry_id"]
            or claim["bank"] not in review["counterexample"]
            or claim["value"] == review["counterexample"][claim["bank"]]
        ):
            raise ValueError("REVISION_EXCEPTION_MODEL_RECEIPT_NOT_OPPOSING")
        requested.add(receipt["request_id"])
    return tuple(sorted(requested))


def _except(conn, rule, review):
    identity = review["entry_id"]
    if type(identity) is not str or not identity or rule.authority != "conditional" or not rule.approved:
        raise ValueError("INVALID_REVISION_EXCEPTION_TARGET")
    guard = (EXCEPTION_GUARD_PREFIX + identity, "true")
    if guard in rule.guards:
        raise ValueError("DUPLICATE_REVISION_EXCEPTION")
    source = exception_source(conn, identity)
    if digest(source) != review["source_sha256"]:
        raise ValueError("REVISION_EXCEPTION_SOURCE_CHANGED")
    scope = replace(rule, guards=tuple(item for item in rule.guards if not item[0].startswith(EXCEPTION_GUARD_PREFIX)))
    context = lexical_context(source["definition"], (source["observation"],), (scope,))
    if not touches_scope((scope,), context):
        raise ValueError("REVISION_EXCEPTION_OUTSIDE_SCOPE")
    values = review["counterexample"]
    if (
        type(values) is not dict
        or not values
        or not values.keys() <= set(rule.banks)
        or any(type(value) is not int or value not in (-1, 0, 1) for value in values.values())
    ):
        raise ValueError("INVALID_REVISION_COUNTEREXAMPLE")
    if any(all(row[rule.banks.index(bank)] == value for bank, value in values.items()) for row in rule.allowed_rows):
        raise ValueError("REVISION_EXCEPTION_DOES_NOT_OPPOSE_RULE")
    return replace(rule, guards=tuple(sorted((*rule.guards, guard))))


def validate_revision_shape(revision):
    required = {"format", "baseline_version", "admissions", "retirements", "exceptions"}
    if type(revision) is dict and current_id(revision.get("format")) == RESERVATION_FORMAT:
        required.add("reservations")
    if (
        type(revision) is not dict
        or set(revision) != required
        or type(revision["format"]) is not str
        or current_id(revision["format"]) not in {FORMAT, RESERVATION_FORMAT}
        or any(type(revision[key]) is not list for key in ("admissions", "retirements", "exceptions"))
        or "reservations" in revision
        and type(revision["reservations"]) is not list
    ):
        raise ValueError("INVALID_RULE_REVISION")
    if any(type(record) is not dict or "input" not in record for record in revision["admissions"]):
        raise ValueError("INVALID_REVISION_ADMISSION")


def revision_relations(conn, before, revision):
    """Validate the exact change and reconstruct its resulting rule set."""
    from .rule_admission import verify_admission
    from .validation import _relations

    validate_revision_shape(revision)
    baseline = digest(relation_records(before))
    if revision["baseline_version"] != baseline:
        raise ValueError("MIGRATION_BASELINE_VERSION_MISMATCH")
    rules = {rule.rule_id: rule for rule in before}
    for review in revision["retirements"]:
        _review(review, {"rule_id", "rule_sha256"})
        identity = review["rule_id"]
        old = rules.get(identity) if type(identity) is str else None
        if old is None or old.authority != "conditional" or not old.approved:
            raise ValueError("INVALID_RULE_RETIREMENT_TARGET")
        if digest(relation_records((old,))[0]) != review["rule_sha256"]:
            raise ValueError("RULE_RETIREMENT_WITNESS_CHANGED")
        del rules[identity]
    admitted = {}
    for admission in revision["admissions"]:
        verify_admission(admission)
        if admission["baseline_version"] != baseline:
            raise ValueError("REVISION_ADMISSION_BASELINE_MISMATCH")
        [rule] = _relations(json.loads(json.dumps([admission["relation"]])))
        if rule.rule_id in rules or rule.rule_id in admitted:
            raise ValueError("MIGRATION_RULE_ALREADY_PRESENT")
        admitted[rule.rule_id] = rule
    rules.update(sorted(admitted.items()))
    for review in revision["exceptions"]:
        _review(
            review,
            {"rule_id", "entry_id", "source_sha256", "counterexample"},
            optional=("withdraw_model_receipt_sha256",),
        )
        identity = review["rule_id"]
        if type(identity) is not str or identity not in rules:
            raise ValueError("INVALID_REVISION_EXCEPTION_TARGET")
        rules[identity] = _except(conn, rules[identity], review)
    for review in revision.get("reservations", ()):
        from .rule_reservations import reserve_relation

        _review(review, {"rule_id", "entry_id", "source_sha256", "bank", "audit"})
        identity = review["rule_id"]
        if type(identity) is not str or identity not in rules:
            raise ValueError("INVALID_REVISION_RESERVATION_TARGET")
        rules[identity] = reserve_relation(conn, rules[identity], review, before)
    for admission in revision["admissions"]:
        rule = rules[admission["relation"]["rule_id"]]
        if any(
            (EXCEPTION_GUARD_PREFIX + entry, "true") not in rule.guards
            for entry in admission["warrant"].get("required_exception_ids", ())
        ):
            raise ValueError("REQUIRED_REVISION_EXCEPTION_MISSING")
        required = set(admission["warrant"].get("required_reservation_ids", ()))
        supplied = {r["entry_id"] for r in revision.get("reservations", ()) if r["rule_id"] == rule.rule_id}
        if not required <= supplied:
            raise ValueError("REQUIRED_REVISION_RESERVATION_MISSING")
    after = tuple(rules.values())
    validate_lexical_guards(after)
    if after == before:
        raise ValueError("EMPTY_RULE_REVISION")
    return after


=== GSE/curation/lexicon_builder/retention.py ===
 """Retire a generated snapshot only after preserving its sources and unique audits."""

import gzip
import json
import os
import re
import sqlite3
import subprocess
from contextlib import closing
from hashlib import file_digest, sha256
from pathlib import Path

from GSE.lexicon_resource import resolve_lexicon_path

from .epoch import record

_DERIVED = frozenset(
    {
        "definition_states",
        "primitive_values",
        "sentence_primitive_values",
        "source_observations",
        "sqlite_sequence",
    }
)
_STREAMS = {
    "native_observations": "SELECT record_id,entry_id,source,family,scope,payload FROM source_observations ORDER BY record_id",
    "definitions": "SELECT d.entry_id,l.lemma,l.pos,l.sense_id,l.gloss,l.source "
    "FROM definition_states d JOIN lexemes l ON l.id=d.lexeme_id ORDER BY d.entry_id",
}


def _fingerprint(path):
    with path.open("rb") as stream:
        return file_digest(stream, "sha256").hexdigest()


def _identity(path):
    stat = path.stat()
    return {"device": stat.st_dev, "inode": stat.st_ino, "logical_bytes": stat.st_size, "mtime_ns": stat.st_mtime_ns}


def no_open_handles(path):
    """Use the existing local-file handle instrument; incomplete scans abstain."""
    result = subprocess.run(["lsof", "-nP", "-f", "-Fpn", "--", str(path)], capture_output=True, text=True)
    if result.returncode != 1 or result.stdout:
        raise ValueError("CHECKPOINT_OPEN_HANDLE_CHECK_FAILED:" + str(path))
    warning = None
    if result.stderr:
        diagnostic = re.fullmatch(
            r"lsof: WARNING: can't stat\(\) smbfs file system (?P<mount>/Volumes/\.timemachine/[^\n]+)\n"
            r'      Output information may be incomplete.\n      assuming "dev=(?P<device>[0-9a-fA-F]+)" from mount table\n',
            result.stderr,
        )
        if diagnostic is None:
            raise ValueError("CHECKPOINT_OPEN_HANDLE_CHECK_FAILED:" + str(path))
        mount = Path(diagnostic["mount"])
        device = int(diagnostic["device"], 16)
        if path.absolute().is_relative_to(mount) or path.stat().st_dev == device:
            raise ValueError("CHECKPOINT_ON_UNINSPECTED_NETWORK_FILESYSTEM")
        warning = {"code": "UNRELATED_INACCESSIBLE_SMB_MOUNT", "path": str(mount), "device": device}
    return {"code": "NO_OPEN_LOCAL_FILE_MATCHES", "stderr": result.stderr, "unrelated_mount": warning}


def _verify_retirement_witness(active, expected_sha256, learning_state):
    if learning_state is None:
        if resolve_lexicon_path().resolve() != active.resolve():
            raise ValueError("RETIREMENT_ACTIVE_WITNESS_CHANGED")
    else:
        head = learning_state.head()
        if Path(head["candidate"]).resolve() != active.resolve() or head["candidate_sha256"] != expected_sha256:
            raise ValueError("RETIREMENT_WORKING_HEAD_CHANGED")
    if _fingerprint(active) != expected_sha256:
        raise ValueError("RETIREMENT_ACTIVE_WITNESS_CHANGED")


def _verify_learning_retirement(source, learning_state):
    """A working-head witness can retire only its ledger's owned phase files."""
    owner = learning_state.path.parent.absolute()
    if source.parent.parent != owner or source.name not in {"teaching.db", "candidate.db"}:
        raise ValueError("RETIREMENT_NOT_OWNED_LEARNING_STAGE")
    if source.parent.is_symlink() or source.parent.name not in {
        f"epoch-{row['epoch']:02d}" for row in learning_state.head_history()
    }:
        raise ValueError("RETIREMENT_NOT_OWNED_LEARNING_STAGE")
    expected = {
        row["path"]: row["sha256"]
        for transition in learning_state.head_history()
        for row in transition["staging"]
    }.get(str(source))
    if expected is None or source.exists() and (_fingerprint(source) != expected or source.stat().st_nlink != 1):
        raise ValueError("RETIREMENT_LEARNING_STAGE_CHANGED_OR_ALIASED")
    if source.resolve() == resolve_lexicon_path().resolve():
        raise ValueError("RETIREMENT_PROTECTS_ACTIVE_AND_ROLLBACK")


def _stream(connection, query, parameters=()):
    digest, count = sha256(), 0
    for row in connection.execute(query, parameters):
        payload = json.dumps(row, ensure_ascii=False, separators=(",", ":")).encode()
        digest.update(len(payload).to_bytes(8, "big"))
        digest.update(payload)
        count += 1
    return {"rows": count, "sha256": digest.hexdigest()}


def retire_snapshot(
    source,
    active,
    previous,
    *,
    expected_sha256,
    previous_sha256,
    archive_path,
    receipt_path,
    handle_check,
    new_context_ids=(),
    learning_state=None,
):
    """Preserve complete native streams and every unique non-derived row.

    ``new_context_ids`` names separately audited context additions in the active
    successor. A record absent from the retired snapshot may be omitted from the
    witness comparison only when explicitly named here. No old source may vanish.
    The caller supplies the established local-file handle instrument; its named
    positive result is required before unlinking. Active and rollback are protected.
    """
    source, active, previous = (Path(path).absolute() for path in (source, active, previous))
    archive_path, receipt_path = Path(archive_path), Path(receipt_path)
    if source.is_symlink() or source.resolve() in {active.resolve(), previous.resolve()}:
        raise ValueError("RETIREMENT_PROTECTS_ACTIVE_AND_ROLLBACK")
    if learning_state is not None:
        _verify_learning_retirement(source, learning_state)
    _verify_retirement_witness(active, expected_sha256, learning_state)
    if previous.is_symlink() or not previous.is_file() or _fingerprint(previous) != previous_sha256:
        raise ValueError("RETIREMENT_ROLLBACK_MISSING_OR_CHANGED")
    if receipt_path.exists():
        receipt = json.loads(receipt_path.read_text())
        if (
            source.exists()
            or receipt["path"] != str(source)
            or receipt["witness_sha256"] != expected_sha256
            or receipt["witness"] != str(active)
            or receipt["previous_sha256"] != previous_sha256
        ):
            raise ValueError("RETIREMENT_RECEIPT_IDENTITY_CHANGED")
        if _fingerprint(Path(receipt["audit_archive"])) != receipt["archive_sha256"]:
            raise ValueError("RETIREMENT_ARCHIVE_CHANGED")
        return receipt
    intent_path = receipt_path.with_suffix(".intent.json")
    if not source.exists():
        if not intent_path.exists():
            raise ValueError("RETIREMENT_ABSENT_WITHOUT_VERIFIED_INTENT")
        intent = json.loads(intent_path.read_text())
        if (
            intent.get("code") != "SNAPSHOT_RETIREMENT_READY"
            or intent.get("path") != str(source)
            or intent.get("witness_sha256") != expected_sha256
            or intent.get("previous_sha256") != previous_sha256
            or intent.get("audit_archive") != str(archive_path)
            or _fingerprint(archive_path) != intent.get("archive_sha256")
        ):
            raise ValueError("RETIREMENT_INTERRUPTED_INTENT_MISMATCH")
        result = {**intent, "code": "SOURCE_AND_UNIQUE_AUDITS_PRESERVED_SNAPSHOT_RETIRED"}
        record(receipt_path, result)
        return result
    if (
        not isinstance(new_context_ids, tuple)
        or len(set(new_context_ids)) != len(new_context_ids)
        or any(type(identity) is not str or not identity for identity in new_context_ids)
    ):
        raise ValueError("RETIREMENT_INVALID_NEW_CONTEXT_IDENTITIES")
    before, source_hash = _identity(source), _fingerprint(source)
    checks, tables = {}, {}
    with (
        closing(sqlite3.connect(source.resolve(strict=True).as_uri() + "?mode=ro", uri=True)) as old,
        closing(sqlite3.connect(active.resolve(strict=True).as_uri() + "?mode=ro", uri=True)) as witness,
    ):
        old.execute("PRAGMA query_only=ON")
        witness.execute("PRAGMA query_only=ON")
        missing = tuple(
            identity
            for identity in new_context_ids
            if not old.execute("SELECT 1 FROM source_observations WHERE record_id=?", (identity,)).fetchone()
        )
        for name, query in _STREAMS.items():
            target, parameters = query, ()
            if name == "native_observations" and missing:
                target = query.replace(
                    " ORDER BY record_id",
                    " WHERE record_id NOT IN (" + ",".join("?" for _ in missing) + ") ORDER BY record_id",
                )
                parameters = missing
            observed = _stream(old, query)
            if observed != _stream(witness, target, parameters):
                raise ValueError("RETIREMENT_SOURCE_STREAM_MISMATCH:" + name)
            checks[name] = observed
        old.execute("ATTACH DATABASE ? AS retained", (active.resolve().as_uri() + "?mode=ro",))
        for (name,) in old.execute("SELECT name FROM main.sqlite_master WHERE type='table' ORDER BY name").fetchall():
            if name in _DERIVED:
                continue
            table = '"' + name.replace('"', '""') + '"'
            columns = [row[1] for row in old.execute("PRAGMA main.table_info(" + table + ")")]
            if columns != [row[1] for row in old.execute("PRAGMA retained.table_info(" + table + ")")]:
                raise ValueError("RETIREMENT_SCHEMA_MISMATCH:" + name)
            fields = ",".join('"' + column.replace('"', '""') + '"' for column in columns)
            rows = old.execute(
                "SELECT " + fields + " FROM main." + table + " EXCEPT SELECT " + fields + " FROM retained." + table
            ).fetchall()
            if rows:
                tables[name] = {"columns": columns, "rows": rows}
    document = {
        "format": "GSE.checkpoint-audit-delta/1",
        "source": str(source),
        "source_sha256": source_hash,
        "witness": str(active),
        "witness_sha256": expected_sha256,
        "source_identity": before,
        "source_data_checks": checks,
        "excluded_new_context_ids_from_witness_only": list(missing),
        "tables": tables,
        "derived_or_verified_tables": sorted(_DERIVED),
    }
    encoded = json.dumps(document, sort_keys=True, ensure_ascii=False).encode()
    if archive_path.exists():
        if gzip.decompress(archive_path.read_bytes()) != encoded:
            raise ValueError("RETIREMENT_EXISTING_ARCHIVE_DIFFERS")
    else:
        with archive_path.open("xb") as stream:
            stream.write(gzip.compress(encoded, mtime=0))
            stream.flush()
            os.fsync(stream.fileno())
    if json.loads(gzip.decompress(archive_path.read_bytes())) != json.loads(encoded):
        raise ValueError("RETIREMENT_ARCHIVE_ROUNDTRIP_FAILED")
    handles = handle_check(source)
    if not isinstance(handles, dict) or handles.get("code") != "NO_OPEN_LOCAL_FILE_MATCHES":
        raise ValueError("RETIREMENT_NO_OPEN_HANDLES_NOT_ESTABLISHED")
    if _identity(source) != before or _fingerprint(source) != source_hash:
        raise ValueError("RETIREMENT_SOURCE_CHANGED")
    if any(Path(str(source) + suffix).exists() for suffix in ("-wal", "-shm", "-journal")):
        raise ValueError("RETIREMENT_HAS_SIDECAR")
    _verify_retirement_witness(active, expected_sha256, learning_state)
    if _fingerprint(previous) != previous_sha256:
        raise ValueError("RETIREMENT_ROLLBACK_MISSING_OR_CHANGED")
    result = {
        "code": "SOURCE_AND_UNIQUE_AUDITS_PRESERVED_SNAPSHOT_RETIRED",
        "path": str(source),
        "sha256": source_hash,
        "identity": before,
        "witness": str(active),
        "witness_sha256": expected_sha256,
        "previous_sha256": previous_sha256,
        "audit_archive": str(archive_path),
        "archive_sha256": _fingerprint(archive_path),
        "unique_audit_rows": {name: len(value["rows"]) for name, value in tables.items()},
        "handle_check": handles,
    }
    record(intent_path, {**result, "code": "SNAPSHOT_RETIREMENT_READY"})
    source.unlink()
    record(receipt_path, result)
    return result


=== scripts/run_lexicon_epochs.py ===
 """Initialize, resume, and compare two budgeted lexicon learning arms."""

import argparse
import fcntl
import json
import math
from pathlib import Path

from GSE.curation.lexicon_builder.epoch import (
    POLICIES,
    _domains,
    _resolve,
    fingerprint,
    mine_scope_chains,
    parse_plan,
    read,
    record,
    run_arm,
    scope_rows,
)
from GSE.curation.lexicon_builder.learning_curriculum import curriculum, plan_inventory
from GSE.curation.lexicon_builder.residual import OllamaTransport
from GSE.curation.lexicon_builder.rule_history import digest
from GSE.curation.lexicon_builder.specification import compare_measurements
from GSE.lexicon_resource import ACTIVE_POINTER, resolve_lexicon_path


def rule_interactions(candidate, inventory, child, parents, bank):
    rules, rows = scope_rows(candidate, inventory)
    result = []
    for parent in parents:
        parent_id = parent["rule_id"]
        exclusions = {
            "both": set(),
            "parent_only": {child},
            "child_only": {parent_id},
            "neither": {parent_id, child},
        }
        singletons = {}
        for variant, dropped in exclusions.items():
            subset = tuple(rule for rule in rules if rule.rule_id not in dropped)
            resolved = set()
            for identity, row in rows.items():
                state = _resolve(row, subset)
                if state.code == "CONFLICT" or any(r["kind"] == "SOLVER_LIMIT" for r in state.trace):
                    raise ValueError("EPOCH_INTERACTION_INCOMPLETE")
                if variant == "both" and _domains(state) != row[-1]:
                    raise ValueError("EPOCH_INTERACTION_BASELINE_MISMATCH")
                if bank in state.assignments:
                    resolved.add(identity)
            singletons[variant] = resolved
        result.append(
            {
                "parent": parent_id,
                "bank": bank,
                "definitions_checked": len(rows),
                "singletons": {key: len(values) for key, values in singletons.items()},
                "joint_only": len(singletons["both"] - singletons["parent_only"] - singletons["child_only"]),
            }
        )
    return result


def conjunctive_results(directory, policy, arm, inventory):
    results = []
    for epoch in arm["epochs"]:
        selected = epoch.get("selected", {})
        if epoch["code"] != "RULE_ADMITTED" or "premises" not in selected:
            continue
        phase = directory / policy / f"epoch-{epoch['epoch']:02d}"
        observed = read(phase / "observed-conjunction.json")
        groundings = read(phase / "grounded-discovery.json")
        parent_ids = sorted(
            {
                rule_id
                for chain in groundings["chains"]
                if chain["consequent"] in selected["premises"]
                for rule_id in chain["rule_ids"]
            }
        )
        interactions = rule_interactions(
            Path(arm["candidate"]),
            inventory[selected["family"]],
            epoch["rule_id"],
            [{"rule_id": rule_id} for rule_id in parent_ids],
            selected["bank"],
        )
        results.append(
            {
                "epoch": epoch["epoch"],
                "rule_id": epoch["rule_id"],
                "family": selected["family"],
                "premises": selected["premises"],
                "consequent": observed["consequent"],
                "audit_outcomes": epoch["audit_outcomes"],
                "symbolic_new_cells": epoch["symbolic_new_cells"],
                "interactions": interactions,
            }
        )
    return results


def joint_learning(arms):
    """Compare actual phase measurements, including zero-singleton contraction."""
    summaries, baselines = {}, {}
    for policy, arm in arms.items():
        epochs = arm["epochs"]
        if not epochs or any("specification_learning" not in epoch for epoch in epochs):
            return {"code": "JOINT_PHASE_MEASUREMENTS_UNAVAILABLE", "policy": policy}
        phases = [epoch["specification_learning"] for epoch in epochs]
        baseline = phases[0]["baseline"]
        previous = baseline
        direct, revisions = [], []
        for phase in phases:
            before, taught, revised = (phase[name] for name in ("baseline", "post_teaching", "post_revision"))
            compare_measurements(previous, before)
            if any(previous[name] != before[name] for name in ("lexicon", "buckets", "sentence_constructions")):
                raise ValueError("EPOCH_JOINT_MEASUREMENT_CHAIN_BROKEN")
            direct.append(compare_measurements(before, taught))
            revisions.append(compare_measurements(taught, revised))
            previous = revised
        total = compare_measurements(baseline, previous)
        if any(change["lexicon"]["joint_count_comparison"] != "EXACT" for change in (*direct, *revisions, total)):
            return {"code": "JOINT_PHASE_COUNTS_UNAVAILABLE", "policy": policy}
        direct_bits = math.fsum(item["lexicon"]["specification_gain_bits"] for item in direct)
        revision_bits = math.fsum(item["lexicon"]["specification_gain_bits"] for item in revisions)
        if not math.isclose(
            direct_bits + revision_bits, total["lexicon"]["specification_gain_bits"], rel_tol=1e-12, abs_tol=1e-7
        ):
            raise ValueError("EPOCH_JOINT_MEASUREMENT_ACCOUNTING_MISMATCH")
        baselines[policy] = baseline
        summaries[policy] = {
            "baseline_specification_bits": baseline["lexicon"]["specification_bits"],
            "final_specification_bits": previous["lexicon"]["specification_bits"],
            "teaching_with_existing_closure_gain_bits": direct_bits,
            "rule_revision_gain_bits": revision_bits,
            "total": total,
        }
    left, right = (baselines[policy] for policy in POLICIES)
    compare_measurements(left, right)
    if any(left[name] != right[name] for name in ("lexicon", "buckets", "sentence_constructions")):
        raise ValueError("EPOCH_JOINT_BASELINES_DIFFER")
    return {
        "code": "EXACT_JOINT_COMPARISON",
        "arms": summaries,
        "closure_minus_zipf_specification_gain_bits": (
            summaries["closure"]["total"]["lexicon"]["specification_gain_bits"]
            - summaries["zipf"]["total"]["lexicon"]["specification_gain_bits"]
        ),
    }


def arm_inventory(arm, initial):
    """Resolve the exact discovered populations used by one learning arm."""
    result = dict(initial)
    for key, reference in arm.get("learned_inventory", {}).items():
        rows = read(Path(reference["path"]))
        if key in result or digest(rows) != reference["sha256"]:
            raise ValueError("EPOCH_LEARNED_INVENTORY_CHANGED")
        result[key] = rows
    return result


def compare(directory, plan):
    arms = {policy: read(directory / policy / "arm-result.json") for policy in POLICIES}
    configuration = {policy: read(directory / policy / "arm.json") for policy in POLICIES}
    if any(arm["plan_sha256"] != digest(plan) for arm in arms.values()):
        raise ValueError("EPOCH_COMPARISON_PLAN_CHANGED")
    shared_keys = ("plan_sha256", "inventory_sha256", "frequency_sha256", "transport")
    if curriculum(plan):
        shared_keys += ("learning_protocol",)
    if any(len({digest(config.get(key)) for config in configuration.values()}) != 1 for key in shared_keys):
        raise ValueError("EPOCH_COMPARISON_INPUTS_DIFFER")
    if any(
        arm["replay"]["code"] != "REPLAY_VALIDATED"
        or not arm["replay"]["complete_search"]
        or fingerprint(Path(arm["candidate"])) != arm["candidate_sha256"]
        for arm in arms.values()
    ):
        raise ValueError("EPOCH_COMPARISON_REPLAY_REQUIRED")
    budgets = {policy: arm["typed_questions_used"] for policy, arm in arms.items()}
    equal = len(set(budgets.values())) == 1 and all(
        arm["typed_questions_used"] == arm["typed_question_budget"] for arm in arms.values()
    )
    if curriculum(plan):
        equal = len(set(budgets.values())) == 1 and all(
            0 < arm["typed_questions_used"] <= arm["typed_question_budget"]
            and arm["code"] in {"LEARNING_DECLARED_FRONTIER_EXHAUSTED", "LEARNING_EPOCH_LIMIT_REACHED"}
            for arm in arms.values()
        )
    inventory = read(directory / "inventory.json")
    if digest(inventory) != configuration["closure"]["inventory_sha256"]:
        raise ValueError("EPOCH_COMPARISON_INVENTORY_CHANGED")
    inventories = {policy: arm_inventory(arm, inventory) for policy, arm in arms.items()}
    feedback = [
        {
            "epoch": epoch["epoch"],
            "rule_id": epoch["rule_id"],
            "family": epoch["selected"]["family"],
            "parents": epoch["premise_depends_on"],
            "audit_outcomes": epoch["audit_outcomes"],
            "interactions": rule_interactions(
                Path(arms["closure"]["candidate"]),
                inventories["closure"][epoch["selected"]["family"]],
                epoch["rule_id"],
                epoch["premise_depends_on"],
                epoch["selected"]["bank"],
            ),
        }
        for epoch in arms["closure"]["epochs"]
        if epoch["code"] == "RULE_ADMITTED" and epoch["premise_depends_on"]
    ]
    grounded_files = {policy: directory / policy / "grounded-chains-final.json" for policy in arms}
    conjunctive = {
        policy: conjunctive_results(directory, policy, arm, inventories[policy]) for policy, arm in arms.items()
    }
    grounded = {policy: len(read(path)["proposals"]) if path.exists() else 0 for policy, path in grounded_files.items()}
    joint = joint_learning(arms)
    if not equal or joint["code"] != "EXACT_JOINT_COMPARISON":
        code = "EPOCH_ACCEPTANCE_INCOMPLETE"
    elif not any(summary["total"]["lexicon"]["specification_gain_bits"] > 0 for summary in joint["arms"].values()):
        code = "EQUAL_BUDGET_NO_JOINT_CONTRACTION"
    elif any(row["joint_only"] for generation in feedback for row in generation["interactions"]):
        code = "EQUAL_BUDGET_FEEDBACK_VALIDATED"
    elif all(
        grounded[policy] and any(w["joint_only"] for case in conjunctive[policy] for w in case["interactions"])
        for policy in arms
    ):
        code = "EQUAL_BUDGET_GROUNDED_DISCOVERY_VALIDATED"
    else:
        code = "EQUAL_BUDGET_JOINT_CONTRACTION_VALIDATED"
    result = {
        "format": "GSE.lexicon-epoch-comparison/2",
        "code": code,
        "budget": budgets,
        "equal_budget": equal,
        "joint_learning": joint,
        "second_generation_rules": feedback,
        **(
            {"conjunctive_admissions": conjunctive, "grounded_chain_proposals": grounded}
            if any(path.exists() for path in grounded_files.values())
            else {}
        ),
        "arms": {
            policy: {
                "candidate": arm["candidate"],
                "new_cells": arm["new_cells"],
                "reopened_cells": arm["reopened_cells"],
                "epoch_families": [e.get("selected", {}).get("family") for e in arm["epochs"]],
                "direct_typed_assignments": sum(
                    e.get("teaching", {}).get("code")
                    in {"TYPED_TEACHING", "REVIEWED_TEACHING", "REVIEWED_TEACHING_COUNTEREXAMPLE"}
                    and not e.get("selected", {}).get("reviewed_teaching")
                    for e in arm["epochs"]
                ),
                "symbolic_new_cells": sum(e.get("symbolic_new_cells", 0) for e in arm["epochs"]),
                "marginal_domain_potential_removed_bits": sum(
                    math.log2(len(row["before"]) / len(row["after"]))
                    for row in arm["changes"]
                    if row["before"] and row["after"]
                ),
                "remaining_unknown": arm["publication"]["cells"]["unresolved"],
                "semantic_reviews": arm.get("semantic_reviews", 0),
            }
            for policy, arm in arms.items()
        },
        "closure_minus_zipf_new_cells": arms["closure"]["new_cells"] - arms["zipf"]["new_cells"],
        "activation_performed": False,
    }
    record(directory / "comparison-joint-v2.json", result)
    return result


def retire_published_work(directory, result, release):
    """Retire the working databases of a newly owned production round."""
    installed = Path(release["path"]).resolve()
    if resolve_lexicon_path().resolve() != installed or release["sha256"] != result["candidate_sha256"]:
        return {"code": "WORK_SNAPSHOT_RETIREMENT_DEFERRED", "reason": "ACTIVE_SUCCESSOR_CHANGED"}
    protected = {installed}
    if release.get("previous_path"):
        protected.add(Path(release["previous_path"]).resolve())
    retired, deferred = [], []
    for epoch in result["epochs"]:
        phase = directory / f"epoch-{epoch['epoch']:02d}"
        for name in ("teaching.db", "candidate.db"):
            path = phase / name
            if not path.exists():
                continue
            label = str(path.relative_to(directory))
            if (
                phase.is_symlink()
                or path.is_symlink()
                or path.resolve() in protected
                or any(path.with_name(name + suffix).exists() for suffix in ("-wal", "-shm", "-journal"))
            ):
                deferred.append(label)
                continue
            try:
                path.unlink()
            except OSError:
                deferred.append(label)
            else:
                retired.append(label)
    return {
        "code": "WORK_SNAPSHOTS_RETIRED" if not deferred else "WORK_SNAPSHOT_RETIREMENT_DEFERRED",
        "retired": retired,
        "deferred": deferred,
        "published_snapshot": str(installed),
    }


def publish_round(result, directory, destination, gold):
    from GSE.curation.lexicon_builder.publication import publish_sparse
    from scripts.audit_lexicon_runtime import audit_sparse_runtime

    if not result["changes"]:
        return {"code": "NO_ROUND_DOMAIN_CHANGES"}
    runtime = audit_sparse_runtime(result["candidate"])
    if runtime["code"] != "SPARSE_RUNTIME_VALIDATED":
        return {"code": "PUBLICATION_BLOCKED", "blockers": [runtime["code"]]}
    record(directory / "sparse-runtime.json", {key: value for key, value in runtime.items() if key != "measured_at"})
    release = publish_sparse(
        result["candidate"],
        destination,
        gold,
        expected_sha256=result["candidate_sha256"],
        expected_pointer_sha256=result["active_pointer_sha256"],
    )
    if release["code"] == "PUBLISHED_SPARSE_LEXICON":
        record(directory / "sparse-publication.json", release)
        owner = directory / "production-round.json"
        if owner.is_file() and read(owner) == {"plan_sha256": result["plan_sha256"]}:
            retention = retire_published_work(directory, result, release)
            record(directory / "snapshot-retention.json", retention)
            release = {**release, "retention": retention}
    return release


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("phase", choices=("init", "run", "compare"))
    parser.add_argument("--plan", type=Path, required=True)
    parser.add_argument("--baseline", type=Path, required=True)
    parser.add_argument("--directory", type=Path, required=True)
    parser.add_argument("--policy", choices=POLICIES)
    parser.add_argument("--model")
    parser.add_argument("--model-digest")
    parser.add_argument("--model-context-tokens", type=int, default=65536)
    parser.add_argument("--publish-sparse-to", type=Path)
    parser.add_argument("--release-gold", type=Path)
    args = parser.parse_args()
    if bool(args.publish_sparse_to) != bool(args.release_gold) or (args.publish_sparse_to and args.phase != "run"):
        parser.error("Sparse round publication requires run, --publish-sparse-to, and --release-gold")
    plan = read(args.plan)
    parse_plan(plan)
    baseline, directory = args.baseline.resolve(strict=True), args.directory.resolve()
    if fingerprint(baseline) != plan["baseline_sha256"] or fingerprint(ACTIVE_POINTER) != plan["active_pointer_sha256"]:
        raise ValueError("EPOCH_FROZEN_INPUT_MISMATCH")
    if args.publish_sparse_to and baseline != resolve_lexicon_path():
        raise ValueError("EPOCH_PUBLICATION_REQUIRES_ACTIVE_BASELINE")
    directory.mkdir(parents=True, exist_ok=True)
    record(directory / "plan.json", plan)
    inventory_path = directory / "inventory.json"
    if args.phase == "init":
        inventory = plan_inventory(baseline, plan)
        record(inventory_path, inventory)
        groundings = mine_scope_chains(baseline, inventory)
        record(directory / "grounded-chains.json", groundings)
        print(
            json.dumps(
                {
                    "scope_sizes": {key: len(rows) for key, rows in inventory.items()},
                    "grounded_chain_proposals": len(groundings["proposals"]),
                }
            ),
            flush=True,
        )
        return
    if args.phase == "compare":
        result = compare(directory, plan)
        print(json.dumps(result), flush=True)
        return
    if not args.policy or not args.model or not args.model_digest:
        parser.error("run requires --policy, --model, and --model-digest")
    transport = OllamaTransport(
        args.model, context_tokens=args.model_context_tokens, timeout=420, thinking=False, output_tokens=256
    )
    transport.pin()
    if not transport.identity.startswith(f"{args.model}#{args.model_digest}@"):
        raise ValueError("EPOCH_MODEL_DIGEST_CHANGED")
    with (directory / (args.policy + ".lock")).open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        arm_directory = directory / args.policy
        if args.publish_sparse_to and not arm_directory.exists():
            arm_directory.mkdir()
            record(arm_directory / "production-round.json", {"plan_sha256": digest(plan)})
        result = run_arm(
            plan,
            baseline,
            ACTIVE_POINTER,
            arm_directory,
            read(inventory_path),
            args.policy,
            transport,
            directory / "model.lock",
        )
        summary = {key: result[key] for key in ("candidate", "new_cells", "typed_questions_used")}
        if args.publish_sparse_to:
            release = publish_round(result, arm_directory, args.publish_sparse_to, args.release_gold)
            summary["publication"] = {
                key: release[key] for key in ("code", "path", "blockers", "retention") if key in release
            }
    print(json.dumps(summary), flush=True)
    if summary.get("publication", {}).get("code") == "PUBLICATION_BLOCKED":
        raise SystemExit(2)


if __name__ == "__main__":
    main()

