### GSE/curation/lexicon_builder/reviewed_patterns.py
def guarded_patterns(
    records, *, discovery_entry_ids, audit_entry_ids, entries, rulings, relations=(), native_premises=False
):
    """Explicit scoped proposals with supplied warrants; never infer approval."""
    from .grounded_rules import MAX_PREMISES, implication_rows

    discovery, audit = _ids(discovery_entry_ids), _ids(audit_entry_ids)
    if set(discovery) & set(audit):
        raise ValueError("DISCOVERY_AUDIT_ID_OVERLAP")
    if type(records) is not list:
        raise ValueError("INVALID_GUARDED_PATTERN_CANDIDATES")
    patterns, seen = [], set()
    for record in records:
        _fields(
            record, ("consequent", "guards", "absent_evidence", "warrant"), ("antecedent", "premises", "allowed_values")
        )
        if ("antecedent" in record) == ("premises" in record):
            raise ValueError("PATTERN_REQUIRES_ONE_PREMISE_FORM")
        left, right = record.get("antecedent"), record["consequent"]
        premises = record.get("premises", [] if left is None else [left])
        conjunctive = "premises" in record
        if conjunctive and (
            not native_premises or type(premises) is not list or not 2 <= len(premises) <= MAX_PREMISES
        ):
            raise ValueError("INVALID_CONJUNCTIVE_PATTERN_PREMISES")
        for pair in [*premises, right]:
            if (
                type(pair) is not list
                or len(pair) != 2
                or type(pair[0]) is not str
                or pair[0] not in BANKS
                or type(pair[1]) is not int
                or pair[1] not in (-1, 0, 1)
            ):
                raise ValueError("INVALID_GUARDED_PATTERN_COORDINATE")
        banks = [pair[0] for pair in [*premises, right]]
        if len(set(banks)) != len(banks):
            raise ValueError("INVALID_GUARDED_PATTERN_COORDINATE")
        warrant = record["warrant"]
        _fields(
            warrant,
            ("warrant_id", "kind", "source_refs", "statement", "review_id", "reviewer"),
            ("required_exception_ids", "required_reservation_ids"),
        )
        if (
            warrant["kind"] not in {"DEFINITIONAL_DERIVATION", "APPROVED_GSE_CONVENTION"}
            or any(
                type(warrant[key]) is not str or not warrant[key].strip()
                for key in ("warrant_id", "statement", "review_id", "reviewer")
            )
            or not _ids(warrant["source_refs"])
        ):
            raise ValueError("EXPLICIT_CAUSAL_WARRANT_REQUIRED")
        for key in ("required_exception_ids", "required_reservation_ids"):
            if key in warrant:
                exclusions = _ids(warrant[key])
                if not exclusions or set(exclusions) & (set(discovery) | set(audit)):
                    raise ValueError("INVALID_REQUIRED_REVISION_EXCEPTIONS")
        if not premises and not record["guards"]:
            raise ValueError("UNARY_PATTERN_REQUIRES_TYPED_GUARD")
        expected_values = record.get("allowed_values", [right[1]])
        if (
            type(expected_values) is not list
            or not 1 <= len(expected_values) <= 2
            or any(type(v) is not int or v not in (-1, 0, 1) for v in expected_values)
            or len(set(expected_values)) != len(expected_values)
            or right[1] not in expected_values
        ):
            raise ValueError("INVALID_PATTERN_ALLOWED_CONSEQUENTS")
        allowed = [
            list(row)
            for row in sorted(
                {row for value in expected_values for row in implication_rows(premises, (right[0], value))}
            )
        ]
        relation = _relation(
            {
                "rule_id": "reviewed-guarded-pattern:" + _request_id(record),
                "banks": banks,
                "allowed_rows": allowed,
                "provenance": [f"warrant:{warrant['warrant_id']}:{_request_id(warrant)}", *warrant["source_refs"]],
                "authority": "conditional",
                "approved": False,
                "guards": record["guards"],
                "absent_evidence": record["absent_evidence"],
            }
        )
        from .foundation import EXCEPTION_GUARD_PREFIX

        if any(
            key.startswith(EXCEPTION_GUARD_PREFIX) or not valid_lexical_guard(key, value)
            for key, value in relation.guards
        ):
            raise ValueError("UNSUPPORTED_PATTERN_CONTEXT")
        if any(bank not in BANKS for bank in relation.absent_evidence):
            raise ValueError("UNKNOWN_PATTERN_EVIDENCE_BANK")
        if relation.rule_id in seen:
            raise ValueError("DUPLICATE_GUARDED_PATTERN")
        seen.add(relation.rule_id)
        pattern = Pattern(
            relation,
            tuple(left) if left else None,
            tuple(right),
            discovery,
            audit,
            (),
            dict(warrant),
            tuple(tuple(pair) for pair in premises) if conjunctive else (),
            tuple(expected_values) if "allowed_values" in record else (),
        )
        observed = []
        for entry_id in discovery:
            entry = entries[entry_id]
            applicable = _applicability(relation, entry)
            values, consequent_witness, consequent_code = _discovery_consequent(
                entry, right[0], relations, rulings, native_premises
            )
            if conjunctive:
                baseline, _, code = _antecedent_state(pattern, entry, relations, rulings)
                witnesses = [
                    _baseline_witness(baseline, bank, relations)
                    for bank, value in pattern.premises
                    if baseline.assignments.get(bank) == value
                ]
                observed.append(
                    {
                        "entry_id": entry_id,
                        "code": (
                            code
                            if code != "READY"
                            else consequent_code
                            if consequent_code is not None
                            else "CONSEQUENT_CONFLICT"
                            if len(values) > 1
                            else "CONSEQUENT_UNKNOWN"
                            if not values
                            else "OBSERVED_AGREEMENT"
                            if values <= set(expected_values)
                            else "OBSERVED_COUNTEREXAMPLE"
                        ),
                        "rulings": [
                            _ruling_reference(row)
                            for row in rulings
                            if row.entry_id == entry_id and row.bank == right[0]
                        ],
                        "premise_witnesses": witnesses,
                        **({"consequent_witness": consequent_witness} if consequent_witness is not None else {}),
                    }
                )
                continue
            premises = {
                row.value for row in rulings if left is not None and row.entry_id == entry_id and row.bank == left[0]
            }
            witness, baseline_code = None, None
            if native_premises and applicable == "READY" and left is not None and not premises:
                baseline = _baseline(pattern, entry, relations)
                if baseline.code == "CONFLICT":
                    baseline_code = "BASELINE_CONFLICT"
                elif left[0] in baseline.assignments:
                    premises = {baseline.assignments[left[0]]}
                    witness = _baseline_witness(baseline, left[0], relations)
            code = (
                applicable
                if applicable != "READY"
                else baseline_code
                if baseline_code is not None
                else "ANTECEDENT_CONFLICT"
                if len(premises) > 1
                else "ANTECEDENT_UNKNOWN"
                if left is not None and not premises
                else "PREMISE_NOT_MET"
                if left is not None and premises != {left[1]}
                else consequent_code
                if consequent_code is not None
                else "CONSEQUENT_CONFLICT"
                if len(values) > 1
                else "CONSEQUENT_UNKNOWN"
                if not values
                else "OBSERVED_AGREEMENT"
                if values <= set(expected_values)
                else "OBSERVED_COUNTEREXAMPLE"
            )
            observed.append(
                {
                    "entry_id": entry_id,
                    "code": code,
                    "rulings": [
                        _ruling_reference(row)
                        for row in rulings
                        if row.entry_id == entry_id and row.bank in relation.banks
                    ],
                    **({"premise_witness": witness} if witness is not None else {}),
                    **({"consequent_witness": consequent_witness} if consequent_witness is not None else {}),
                }
            )
        patterns.append(replace(pattern, records=tuple(observed)))
    return tuple(patterns)

### tests/test_lexicon_builder_rule_reservations.py
"""An unresolved audit is not an opposing sign; exact scope can reserve it."""

import json
import sqlite3
from copy import deepcopy
from dataclasses import replace

import pytest
from test_lexicon_builder_joint_revisions import REVIEW
from test_lexicon_builder_source_guard_migration import SyntheticTransport, states
from test_lexicon_epoch import native

from GSE.curation.lexicon_builder.completion import complete_dictionary
from GSE.curation.lexicon_builder.evidence import Definition, EvidenceBundle, Observation, _record_id
from GSE.curation.lexicon_builder.model_receipts import read_model_receipts
from GSE.curation.lexicon_builder.pipeline import build_dictionary
from GSE.curation.lexicon_builder.residual import _request_id
from GSE.curation.lexicon_builder.reviewed_export import export_reviewed_input
from GSE.curation.lexicon_builder.reviewed_patterns import run_workflow_input
from GSE.curation.lexicon_builder.rule_admission import admit_records
from GSE.curation.lexicon_builder.rule_history import digest
from GSE.curation.lexicon_builder.rule_migration import migrate_revision
from GSE.curation.lexicon_builder.rule_reservations import reservation_source
from GSE.curation.lexicon_builder.rule_revisions import RESERVATION_FORMAT, validate_revision_shape
from GSE.curation.lexicon_builder.validation import validate_build


def packet(tmp_path, source_kind):
    pairs = []
    for lemma in ("seed", "audit", "reserved"):
        definition, observation = native(lemma, "state.n.02")
        gloss = "The state of being ready."
        definition = replace(definition, definition=gloss)
        observation = replace(observation, features={**observation.features, "definition": gloss})
        if lemma == "reserved" and source_kind == "wiktionary":
            identity = "wiktionary:reserved-fixture"
            definition = Definition(identity, lemma, "noun", gloss)
            features = {
                "identity_scheme": "GSE.wiktionary-native-leaf/1",
                "entry_id": identity,
                "lemma": lemma,
                "word": lemma,
                "pos": "noun",
                "native_id": "reserved-fixture",
                "definition": gloss,
                "native_sense": {"glosses": [gloss]},
            }
            observation = Observation(
                identity,
                "wiktionary",
                _record_id("wiktionary", lemma, features),
                "wiktionary",
                features,
                "lexical",
                (identity,),
            )
        pairs.append((definition, observation))
    definitions, observations = zip(*pairs)
    source = tmp_path / "source.db"
    build_dictionary(EvidenceBundle(definitions, observations, (), ()), source)
    seed, audit_id, reserved = (definition.entry_id for definition in definitions)
    complete_dictionary(source, SyntheticTransport(1), 1, entry_ids=(seed,), banks=("BE",))
    with sqlite3.connect(source) as conn:
        receipt = read_model_receipts(conn)[seed][0]
    selection = {
        "format": "GSE.reviewed-pattern-selection/1",
        "discovery_entry_ids": [seed],
        "audit_entry_ids": [audit_id, reserved],
        "reviews": [
            {
                "request_id": receipt["request_id"],
                "review": {
                    **REVIEW,
                    "code": "ACCEPTED",
                    "receipt_sha256": _request_id(receipt),
                },
            }
        ],
        "guarded_candidates": [
            {
                "antecedent": None,
                "consequent": ["BE", 1],
                "guards": [["pos", "noun"], ["native_noun_frame:stative_being", "true"]],
                "absent_evidence": [],
                "warrant": {
                    "warrant_id": "synthetic:stative",
                    "kind": "DEFINITIONAL_DERIVATION",
                    "source_refs": ["synthetic:test"],
                    "statement": "Synthetic rule tests data flow only.",
                    "review_id": "synthetic:rule",
                    "reviewer": "fixture",
                },
            }
        ],
    }
    raw = export_reviewed_input(source, selection)["input"]

    class Transport:
        identity = "synthetic:reservation-audit"

        def __call__(self, payload, schema):
            return json.dumps({"BE": None if payload["entry_id"] == reserved else 1})

    parent = run_workflow_input(raw, Transport(), max_calls=2)
    abstention = next(a for a in parent["candidates"][0]["audits"] if a["entry_id"] == reserved)
    child = deepcopy(raw)
    child["audit_entry_ids"] = [audit_id]
    child["guarded_candidates"][0]["warrant"]["required_reservation_ids"] = [reserved]
    child = export_reviewed_input(
        source,
        {
            **selection,
            "audit_entry_ids": [audit_id],
            "guarded_candidates": child["guarded_candidates"],
        },
    )["input"]
    tested = run_workflow_input(child, Transport(), max_calls=1)
    [candidate] = tested["candidates"]
    admission = admit_records(
        child,
        tested,
        {
            **REVIEW,
            "decision": "APPROVE_DEFINITIONAL_RULE",
            "rule_id": candidate["relation"]["rule_id"],
            "warrant_sha256": candidate["warrant_sha256"],
        },
    )
    with sqlite3.connect(source) as conn:
        witness = digest(reservation_source(conn, reserved))
    reservation = {
        **REVIEW,
        "rule_id": candidate["relation"]["rule_id"],
        "entry_id": reserved,
        "source_sha256": witness,
        "bank": "BE",
        "audit": abstention,
    }
    revision = {
        "format": RESERVATION_FORMAT,
        "baseline_version": admission["baseline_version"],
        "admissions": [admission],
        "retirements": [],
        "exceptions": [],
        "reservations": [reservation],
    }
    return source, revision, seed, audit_id, reserved


@pytest.mark.parametrize("source_kind", ["wordnet", "wiktionary"])
def test_reserved_unknown_survives_propagation_and_later_independent_teaching(tmp_path, source_kind):
    source, revision, seed, audited, reserved = packet(tmp_path, source_kind)
    before = source.read_bytes()
    output = tmp_path / "candidate.db"
    result = migrate_revision(source, output, revision)
    assert source.read_bytes() == before
    assert result["postflight"]["code"] == "REPLAY_VALIDATED"
    assert states(output)[audited]["domains"]["BE"] == [1]
    assert states(output)[seed]["domains"]["BE"] == [1]
    assert states(output)[reserved]["domains"]["BE"] == [-1, 0, 1]
    assert result["reviewed_reservations"][0]["code"] == "REVIEWED_UNRESOLVED_RESERVATION"
    assert result["reviewed_exceptions"] == []
    complete_dictionary(output, SyntheticTransport(0), 1, entry_ids=(reserved,), banks=("BE",))
    assert states(output)[reserved]["domains"]["BE"] == [0]
    assert validate_build(output)["code"] == "REPLAY_VALIDATED"


@pytest.mark.parametrize(
    "defect", ["signed", "wrong_request", "wrong_source", "missing", "schema", "known", "duplicate", "malformed"]
)
def test_reservation_cannot_turn_an_invalid_or_signed_audit_into_uncertainty(tmp_path, defect):
    source, revision, _, _, _ = packet(tmp_path, "wiktionary")
    review = revision["reservations"][0]
    if defect == "signed":
        review["audit"]["raw_output"] = '{"BE":0}'
    elif defect == "wrong_request":
        review["audit"]["request_id"] = "other"
    elif defect == "wrong_source":
        review["source_sha256"] = "stale"
    elif defect == "missing":
        revision["reservations"] = []
    elif defect == "schema":
        review["audit"]["schema"]["additionalProperties"] = True
    elif defect == "known":
        review["audit"]["request"]["known"]["BE"] = 1
        review["audit"]["request_id"] = _request_id(review["audit"]["request"])
    elif defect == "duplicate":
        revision["reservations"].append(deepcopy(review))
    else:
        review["audit"]["raw_output"] = '{"BE":null,"BE":null}'
    output = tmp_path / "invalid.db"
    with pytest.raises(ValueError):
        migrate_revision(source, output, revision)
    assert not output.exists()


@pytest.mark.parametrize("value", [None, [], {}, True])
def test_revision_version_boundary_refuses_malformed_format(value):
    with pytest.raises(ValueError, match="INVALID_RULE_REVISION"):
        validate_revision_shape(
            {"format": value, "baseline_version": "", "admissions": [], "retirements": [], "exceptions": []}
        )

