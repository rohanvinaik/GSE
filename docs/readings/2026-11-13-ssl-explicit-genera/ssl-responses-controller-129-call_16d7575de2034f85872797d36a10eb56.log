
UNIT GSE/curation/lexicon_builder/residual.py complete_bank 
def complete_bank(
    request: BankRequest,
    banks: tuple[str, ...],
    assertions: tuple[Assertion, ...],
    relations: tuple[Relation, ...],
    transport: Callable[[dict, dict], str],
    context: dict[str, str] | None = None,
    *,
    evidence_banks: tuple[str, ...] = (),
    domain_restrictions: tuple[DomainRestriction, ...] = (),
) -> Completion:
    """Validate freshness, obtain one ruling, then propagate before admitting it.

    Inputs are never mutated. Invalid caller-supplied engine inputs raise the
    engine's ValueError rather than being mislabeled as a model/network failure.
    """
    current = resolve_dictionary(
        banks, assertions, relations, context, evidence_banks=evidence_banks, domain_restrictions=domain_restrictions
    )
    try:
        fresh = build_request(
            request.entry_id,
            request.bank,
            current,
            request.observations,
            definition=request.definition,
            relations=relations,
            context=context,
            request_format=request.request_format,
        )
        same = fresh.request_id == request.request_id and _request_id(request.payload()) == request.request_id
    except ValueError as exc:
        return Completion("STALE_REQUEST", None, current, {"reason": str(exc)})
    if not same:
        return Completion("STALE_REQUEST", None, current, {"reason": "changed_request_state"})

    try:
        raw = transport(fresh.payload(), fresh.output_schema())
    except Exception as exc:
        details = {"error_type": type(exc).__name__}
        if isinstance(exc, ModelTransportError):
            details["reason"] = exc.code
        return Completion("TRANSPORT_ERROR", None, current, details)
    try:
        value = _read_value(raw, fresh)
    except (ValueError, TypeError, RecursionError) as exc:
        return Completion("INVALID_OUTPUT", None, current, {"reason": str(exc)})
    if value is None:
        return Completion("ABSTAINED", None, current, {"request_id": fresh.request_id})

    from .scope_admission import model_scope_admission

    scope = model_scope_admission(fresh.entry_id, fresh.bank, value, fresh.observations)
    if scope["code"] == "SCOPE_UNJUSTIFIED":
        return Completion("SCOPE_UNJUSTIFIED", None, current, {"request_id": fresh.request_id, **scope})

    model = getattr(transport, "identity", getattr(transport, "model", "typed-residual"))
    if type(model) is not str or not model:
        model = "typed-residual"
    assertion = Assertion(fresh.bank, value, f"model:{model}", fresh.request_id, "model")
    resolved = resolve_dictionary(
        banks,
        assertions + (assertion,),
        relations,
        context,
        evidence_banks=evidence_banks,
        domain_restrictions=domain_restrictions,
    )
    previous_exceptions = {
        rule_id
        for record in current.trace
        if record["kind"] == "CONDITIONAL_EXCEPTION"
        for rule_id in record["rule_ids"]
    }
    new_exceptions = tuple(
        record
        for record in resolved.trace
        if record["kind"] == "CONDITIONAL_EXCEPTION" and set(record["rule_ids"]) - previous_exceptions
    )
    changed_known = {
        bank: {"before": value, "after": resolved.assignments.get(bank)}
        for bank, value in current.assignments.items()
        if resolved.assignments.get(bank) != value
    }
    if resolved.code == "CONFLICT" or new_exceptions or changed_known:
        return Completion(
            "CONTRADICTION",
            None,
            current,
            {
                "request_id": fresh.request_id,
                "conflicts": resolved.conflicts
                or tuple(conflict for record in new_exceptions for conflict in record["conflicts"]),
                "conditional_exceptions": new_exceptions,
                "changed_known": changed_known,
            },
        )
    return Completion("ASSIGNED", assertion, resolved, {"request_id": fresh.request_id})

UNIT GSE/curation/lexicon_builder/rule_migration.py _apply_copy 
def _apply_copy(conn, admission=None, *, revision=None):
    old = _relations(_metadata(conn, "relations"))
    if revision is None:
        if admission is None:
            raise ValueError("MIGRATION_REQUIRES_REVIEW")
        if admission["warrant"].get("required_exception_ids") or admission["warrant"].get("required_reservation_ids"):
            raise ValueError("RULE_REQUIRES_JOINT_EXCEPTION_REVIEW")
        if digest(relation_records(old)) != admission["baseline_version"]:
            raise ValueError("MIGRATION_BASELINE_VERSION_MISMATCH")
        addition = _relations([json.loads(_json(admission["relation"]))])[0]
        if any(rule.rule_id == addition.rule_id for rule in old):
            raise ValueError("MIGRATION_RULE_ALREADY_PRESENT")
        new = old + (addition,)
    else:
        new = revision_relations(conn, old, revision)
    removed, added = rule_changes(old, new)
    shared = tuple(rule for rule in old if rule not in removed)
    local_reviews = defaultdict(list)
    reservation_reviews = defaultdict(list)
    if revision is not None:
        for review in revision["exceptions"]:
            local_reviews[review["entry_id"]].append(review)
        for review in revision.get("reservations", ()):
            reservation_reviews[review["entry_id"]].append(review)
    preflight = _replay(conn, old)
    if preflight["code"] != "REPLAY_VALIDATED" or not preflight["complete_search"]:
        raise ValueError("MIGRATION_REQUIRES_COMPLETE_REPLAY")
    entries = tuple(row[0] for row in conn.execute("SELECT entry_id FROM definition_states ORDER BY entry_id"))
    _, models = _authorities(conn)
    failures = []
    native, _, relevance = _observations(conn, set(entries), lambda *a, **kw: failures.append((a, kw)), models)
    if failures:
        raise ValueError("MIGRATION_SOURCE_INVALID")
    history = read_history(conn, old)
    install_history(conn)
    old_version, new_version = _put_version(conn, old), _put_version(conn, new)
    archived, retained, changed, narrowed = [], 0, 0, 0
    known_changes, exception_checks = [], []
    reservation_checks = []
    for entry_id in entries:
        definition, assertions, restrictions, hierarchy = _entry(conn, entry_id)
        old_context = _stored_context(conn, definition, old)
        new_context = _stored_context(conn, definition, new)
        evidence_banks = tuple(sorted(relevance.get(entry_id, ())))
        receipts = models.get(entry_id, ())
        reviews = local_reviews.get(entry_id, ())
        withdrawn = reviewed_model_withdrawals(reviews, receipts)
        for receipt in receipts:
            request_id, receipt_hash = receipt_binding_key(receipt)
            if not conn.execute(
                "SELECT 1 FROM model_rule_versions WHERE request_id=? AND receipt_sha256=?", (request_id, receipt_hash)
            ).fetchone():
                conn.execute(
                    "INSERT INTO model_rule_versions VALUES (?,?,?,?)",
                    (request_id, entry_id, old_version, receipt_hash),
                )
        # Matching the guard is deliberately conservative, even if the premise
        # is currently unknown or an absence guard might block the new rule.
        scope_affected = touches_scope(removed, old_context) or touches_scope(added, new_context)
        first_affected = (
            0
            if scope_affected
            else next((i for i, receipt in enumerate(receipts) if receipt["request_id"] in withdrawn), len(receipts))
        )
        prefix, dropped = receipts[:first_affected], receipts[first_affected:]
        before = _read_json(
            conn.execute("SELECT domains FROM definition_states WHERE entry_id=?", (entry_id,)).fetchone()[0]
        )
        if dropped:
            archived.append(
                {
                    "definition": {key: getattr(definition, key) for key in ("entry_id", "lemma", "pos", "definition")},
                    "assertions": [asdict(a) for a in assertions],
                    "restrictions": [asdict(r) for r in restrictions],
                    "receipts": dropped,
                    **({"retained_prefix": prefix} if prefix else {}),
                    "evidence_banks": evidence_banks,
                    "reason": "REVIEWED_EXCEPTION_REQUIRES_MODEL_RECONSIDERATION"
                    if withdrawn
                    else "ADDED_RULE_SCOPE_REQUIRES_MODEL_CONTEXT_RECONSIDERATION"
                    if revision is None
                    else "REVISED_RULE_SCOPE_REQUIRES_MODEL_CONTEXT_RECONSIDERATION",
                }
            )
            retired_assertions = {_json(r["assertion"]) for r in dropped}
            assertions = tuple(a for a in assertions if _json(asdict(a)) not in retired_assertions)
            deleted = conn.execute(
                "DELETE FROM accepted_model_receipts WHERE entry_id=? AND ordinal>=?", (entry_id, first_affected)
            ).rowcount
            if deleted != len(dropped):
                raise ValueError("MIGRATION_MODEL_RECEIPT_DELETE_MISMATCH")
        retained += len(prefix)
        baseline = resolve_dictionary(
            BANKS, assertions, shared, old_context, evidence_banks=evidence_banks, domain_restrictions=restrictions
        )
        after = resolve_dictionary(
            BANKS, assertions, new, new_context, evidence_banks=evidence_banks, domain_restrictions=restrictions
        )
        if (
            baseline.code == "CONFLICT"
            or any(r["kind"] == "SOLVER_LIMIT" for r in baseline.trace)
            or after.code == "CONFLICT"
            or any(r["kind"] == "SOLVER_LIMIT" for r in after.trace)
            or _exception_keys(after) - _exception_keys(baseline)
        ):
            raise ValueError("MIGRATION_RULE_SCOPE_COUNTEREXAMPLE:" + entry_id)
        if any(after.assignments.get(bank) != value for bank, value in baseline.assignments.items()):
            raise ValueError("MIGRATION_CHANGED_RETAINED_KNOWN:" + entry_id)
        if any(after.assignments.get(bank) not in {-1, 1} for bank in hierarchy):
            raise ValueError("MIGRATION_HIERARCHY_REQUIRES_REVIEW:" + entry_id)
        after_domains = {bank: sorted(values) for bank, values in after.domains.items()}
        changed += before != after_domains
        narrowed += sum(len(after.domains[b]) < len(baseline.domains[b]) for b in BANKS)
        if revision is not None and before != after_domains:
            known_changes.extend(
                {"entry_id": entry_id, "bank": bank, "before": before[bank], "after": values}
                for bank, values in after_domains.items()
                if len(before[bank]) == 1 and before[bank] != values
            )
        for review in reviews:
            if any(value not in baseline.domains[bank] for bank, value in review["counterexample"].items()):
                raise ValueError("REVISION_EXCEPTION_CONFLICTS_WITH_RETAINED_EVIDENCE:" + entry_id)
            if any(value not in after.domains[bank] for bank, value in review["counterexample"].items()):
                raise ValueError("REVISION_EXCEPTION_NOT_HONORED:" + entry_id)
            exception_checks.append(
                {
                    "entry_id": entry_id,
                    "rule_id": review["rule_id"],
                    "code": "REVIEWED_LOCAL_EXCEPTION",
                    "reviewed_model_withdrawals": list(withdrawn),
                    "baseline_domains": {bank: sorted(baseline.domains[bank]) for bank in review["counterexample"]},
                    "after_domains": {bank: after_domains[bank] for bank in review["counterexample"]},
                }
            )
        for review in reservation_reviews.get(entry_id, ()):
            bank = review["bank"]
            expected = review["audit"]["request"]["allowed_values"]
            if (
                before[bank] != expected
                or sorted(baseline.domains[bank]) != expected
                or after_domains[bank] != expected
            ):
                raise ValueError("REVISION_RESERVATION_NOT_HONORED:" + entry_id)
            reservation_checks.append(
                {
                    "code": "REVIEWED_UNRESOLVED_RESERVATION",
                    "entry_id": entry_id,
                    "rule_id": review["rule_id"],
                    "bank": bank,
                    "baseline_domain": expected,
                    "after_domain": after_domains[bank],
                    "audit_request_id": review["audit"]["request_id"],
                }
            )
        store_entry(conn, definition, after, assertions, hierarchy, domain_restrictions=restrictions)
    event = {
        "format": "GSE.rule-migration-event/1",
        "from_version": old_version,
        "to_version": new_version,
        "created_utc": datetime.now(UTC).isoformat(),
        "admission": admission,
        "archived": archived,
    }
    if (
        revision is not None
        or history
        and any(current_id(item["format"]) == "GSE.rule-migration-event/2" for item in history["events"])
    ):
        del event["admission"]
        event.update(
            format="GSE.rule-migration-event/2",
            previous_event=history["head"] if history else None,
            revision=revision
            if revision is not None
            else {
                "format": REVISION_FORMAT,
                "baseline_version": old_version,
                "admissions": [admission],
                "retirements": [],
                "exceptions": [],
            },
        )
    event_id = digest(event)
    conn.execute("INSERT INTO rule_migrations VALUES (?,?)", (event_id, _json(event)))
    for key, value in (("relations", relation_records(new)), ("rule_version", new_version)):
        conn.execute("INSERT OR REPLACE INTO builder_metadata VALUES (?,?)", (key, _json(value)))
    coverage = _refresh_catalog(conn, new, native, relevance)
    verified = _replay(conn, new)
    if verified["code"] != "REPLAY_VALIDATED" or not verified["complete_search"]:
        raise ValueError("MIGRATION_POST_REPLAY_FAILED:" + _json(verified["mismatch_counts"]))
    return {
        "format": "GSE.rule-migration/1" if revision is None else "GSE.rule-migration/2",
        "code": "MIGRATED_CANDIDATE",
        "event_id": event_id,
        "from_version": old_version,
        "to_version": new_version,
        "entries_reclosed": len(entries),
        "entries_changed_domains": changed,
        "cells_symbolically_narrowed": narrowed,
        "archived_model_receipts": sum(len(e["receipts"]) for e in archived),
        "retained_model_receipts": retained,
        "preflight": preflight,
        "postflight": verified,
        "coverage": {key: coverage[key] for key in ("definitions", "outcomes", "cells")},
        "active_pointer_changed": False,
        "model_calls": 0,
        **(
            {
                "revised_scope_changes": {
                    "old_rule_ids": [rule.rule_id for rule in removed],
                    "new_rule_ids": [rule.rule_id for rule in added],
                },
                "known_domain_changes": known_changes,
                "reviewed_exceptions": exception_checks,
                **({"reviewed_reservations": reservation_checks} if reservation_checks else {}),
            }
            if revision is not None
            else {}
        ),
    }

UNIT GSE/curation/lexicon_builder/model_receipts.py validate_receipt 
def validate_receipt(record):
    required = {"entry_id", "assertion", "request_id", "code", "request", "schema"}
    if (
        not isinstance(record, dict)
        or set(record) != required
        or not isinstance(record["entry_id"], str)
        or not record["entry_id"].strip()
    ):
        raise ValueError("INVALID_MODEL_AUTHORITY")
    raw = record["assertion"]
    if not isinstance(raw, dict) or set(raw) != {field.name for field in fields(Assertion)}:
        raise ValueError("INVALID_MODEL_ASSERTION")
    assertion = Assertion(**raw)
    if (
        record["code"] != "ASSIGNED"
        or record["request_id"] != assertion.record_id
        or assertion.family != "model"
        or not assertion.source.startswith("model:")
        or not assertion.source.removeprefix("model:").strip()
        or not isinstance(record["request"], dict)
        or not isinstance(record["schema"], dict)
    ):
        raise ValueError("INVALID_MODEL_AUTHORITY")
    return record

UNIT GSE/curation/lexicon_builder/model_receipts.py ModelReceipts 
class ModelReceipts(Mapping):
    """Keep only entry identities in memory; load bodies for one definition."""

    def __init__(self, conn, entries, version=VERSION):
        self.conn = conn
        self.entries = frozenset(entries)
        self.version = version

    def __iter__(self):
        return iter(sorted(self.entries))

    def __len__(self):
        return len(self.entries)

    def __contains__(self, entry):
        return entry in self.entries

    def __getitem__(self, entry):
        if entry not in self.entries:
            raise KeyError(entry)
        return tuple(
            _restored_receipt(self.conn, _decode(row[0]), self.version)
            for row in self.conn.execute(
                "SELECT payload FROM accepted_model_receipts WHERE entry_id=? ORDER BY ordinal", (entry,)
            )
        )

UNIT GSE/curation/lexicon_builder/validation.py validate_build 
def validate_build(path: str | Path) -> dict:
    """Replay an existing build using a read-only SQLite connection.

    Unsupported formats or unreadable global contracts raise named ValueError.
    Malformed entry records produce REPLAY_MISMATCH receipts and are never silently
    coerced into a valid assignment or default zero.
    """
    file = Path(path).expanduser().resolve()
    if not file.is_file():
        raise ValueError("BUILD_NOT_FOUND")
    try:
        conn = sqlite3.connect(file.as_uri() + "?mode=ro", uri=True)
        try:
            conn.row_factory = sqlite3.Row
            conn.execute("PRAGMA query_only=ON")
            conn.execute("BEGIN")
            _schema(conn)
            if current_id(_metadata(conn, "format")) != VERSION:
                raise ValueError("UNSUPPORTED_BUILD_FORMAT")
            relations = _relations(_metadata(conn, "relations"))
            return _replay(conn, relations)
        finally:
            conn.close()
    except sqlite3.DatabaseError as error:
        raise ValueError("INVALID_BUILD_DATABASE") from error

PACKET WRITER
"""Replay exact checkpoint packets through the ordinary sustained typed writer.

This helper makes no model/service calls. In particular, it never relabels a
98K-context answer as an earlier 65K-context answer, and never rebinds a reply
to a new post-revision question. Native sources, joint constraints and admission
remain the ordinary builder's responsibility. This is not an activation tool.
"""

from __future__ import annotations

import argparse
import json
from pathlib import Path

from GSE.curation.lexicon_builder.completion import complete_dictionary
from GSE.curation.lexicon_builder.epoch import fingerprint, make_questions, read, record
from GSE.curation.lexicon_builder.residual import OllamaTransport, _request_id

ROOT = Path(__file__).resolve().parents[3]
WORK = ROOT / "data/lexicon_builder/2026-11-12/ssl-explicit-genera/ssl-api-checkpoint"


class PacketTransport:
    """An exact retained wire packet under its actual pinned protocol identity."""

    def __init__(self, packet_path, answers_path, configuration):
        self.packet_path = Path(packet_path)
        self.answers_path = Path(answers_path)
        self.packet = read(self.packet_path)
        answers = read(self.answers_path)
        config = configuration["configuration"]
        # Construction computes the current protocol digest locally; pin() and
        # __call__ are deliberately never invoked on this service transport.
        local = OllamaTransport(
            config["model"],
            timeout=config["timeout_seconds"],
            context_tokens=config["context_tokens"],
            thinking=config["thinking"],
            output_tokens=config["output_tokens"],
        )
        artifact = config["artifact"]
        expected = f"{config['model']}#{artifact['digest']}@{local._protocol_digest}"
        if artifact["model"] != config["model"] or config["identity"] != expected:
            raise ValueError("CHECKPOINT_PACKET_PROTOCOL_IDENTITY_CHANGED")
        self.identity = expected
        if (
            answers.keys() != {"format", "questions_sha256", "transport", "answers"}
            or answers["format"] != "GSE.ssl-checkpoint-local-answers/1"
            or answers["questions_sha256"] != fingerprint(self.packet_path)
            or answers["transport"] != self.identity
            or type(answers["answers"]) is not list
            or self.packet.get("format") != "GSE.ssl-checkpoint-local-questions/1"
        ):
            raise ValueError("CHECKPOINT_PACKET_ANSWERS_IDENTITY_CHANGED")
        self.requests, self.answers = {}, {}
        coordinates = []
        for row in self.packet["questions"]:
            identity = row["request_id"]
            if (
                row.keys() != {"request_id", "request", "schema"}
                or identity != _request_id(row["request"])
                or identity in self.requests
            ):
                raise ValueError("CHECKPOINT_PACKET_QUESTION_IDENTITY_CHANGED")
            self.requests[identity] = row
            coordinates.append([row["request"]["entry_id"], row["request"]["bank"]])
        if coordinates != self.packet["coordinates"] or len({tuple(pair) for pair in coordinates}) != len(coordinates):
            raise ValueError("CHECKPOINT_PACKET_COORDINATES_CHANGED")
        for row in answers["answers"]:
            if (
                type(row) is not dict
                or row.keys() != {"request_id", "raw_output"}
                or row["request_id"] not in self.requests
                or row["request_id"] in self.answers
                or type(row["raw_output"]) is not str
            ):
                raise ValueError("CHECKPOINT_PACKET_REPLY_IDENTITY_CHANGED")
            self.answers[row["request_id"]] = row["raw_output"]
        self.replayed = []

    def check(self, payload, schema):
        identity = _request_id(payload)
        original = self.requests.get(identity)
        if original is None or original["request"] != payload or original["schema"] != schema:
            raise ValueError("CHECKPOINT_PACKET_FRESH_QUESTION_CHANGED")
        if identity not in self.answers:
            raise ValueError("CHECKPOINT_PACKET_EXACT_REPLY_MISSING")
        return identity

    def __call__(self, payload, schema):
        identity = self.check(payload, schema)
        self.replayed.append(identity)
        return self.answers[identity]


class PacketSet:
    """Dispatch independent packets without merging different model identities."""

    def __init__(self, transports):
        if not transports or len({transport.identity for transport in transports}) != 1:
            raise ValueError("CHECKPOINT_PACKET_MIXED_TRANSPORT_IDENTITIES")
        self.identity = transports[0].identity
        self.transports = tuple(transports)
        self.by_id = {}
        for transport in transports:
            for identity in transport.requests:
                if identity in self.by_id:
                    raise ValueError("CHECKPOINT_PACKET_DUPLICATE_QUESTION")
                self.by_id[identity] = transport

    def check(self, payload, schema):
        transport = self.by_id.get(_request_id(payload))
        if transport is None:
            raise ValueError("CHECKPOINT_PACKET_FRESH_QUESTION_CHANGED")
        return transport.check(payload, schema)

    def __call__(self, payload, schema):
        self.check(payload, schema)
        return self.by_id[_request_id(payload)](payload, schema)


def write_packets(database, transports, coordinates, report):
    """One full version-boundary preflight, then bounded exact entry-bank work."""
    database = Path(database).resolve()
    if database.parent != WORK or database.name not in {"teaching.db", "checkpoint-teaching.db", "candidate.db"}:
        raise ValueError("CHECKPOINT_PACKET_REQUIRES_OWNED_PRIVATE_DATABASE")
    coordinates = tuple(tuple(pair) for pair in coordinates)
    if not coordinates or len(set(coordinates)) != len(coordinates):
        raise ValueError("CHECKPOINT_PACKET_INVALID_SELECTED_COORDINATES")
    model = PacketSet(transports)
    # Fail before the expensive preflight if a revision or a prior answer has
    # actually changed a question. No relaxation based on matching spellings,
    # matching source hashes alone, or predicted answers is permitted.
    fresh = make_questions(database, coordinates)
    for request in fresh:
        model.check(request.payload(), request.output_schema())
    before = fingerprint(database)
    result = complete_dictionary(
        database,
        model,
        len(coordinates),
        entry_bank_questions=coordinates,
        continue_cohorts=True,
        max_calls_per_entry=1,
        max_entries_per_pass=len(coordinates),
        priority="zipf",
        progress=lambda row: print(json.dumps(row), flush=True),
    )
    receipt = {
        "format": "GSE.checkpoint-retained-packet-writer/1",
        "database": str(database),
        "before_sha256": before,
        "after_sha256": fingerprint(database),
        "transport": model.identity,
        "packets": [
            {
                "questions": str(transport.packet_path),
                "questions_sha256": fingerprint(transport.packet_path),
                "answers": str(transport.answers_path),
                "answers_sha256": fingerprint(transport.answers_path),
                "replayed_request_ids": transport.replayed,
            }
            for transport in transports
        ],
        "writer": result,
        "new_model_service_calls": 0,
        "postflight": "REQUIRED_BEFORE_PUBLICATION",
        "activation_performed": False,
    }
    record(Path(report), receipt)
    return receipt


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--database", required=True, type=Path)
    parser.add_argument("--configuration", required=True, type=Path)
    parser.add_argument("--packet", required=True, action="append", type=Path)
    parser.add_argument("--answers", required=True, action="append", type=Path)
    parser.add_argument("--coordinates", required=True, type=Path, help="JSON array of exact [entry_id,bank] pairs")
    parser.add_argument("--report", required=True, type=Path)
    args = parser.parse_args()
    if len(args.packet) != len(args.answers):
        parser.error("Each exact packet requires its own answer file")
    configuration = read(args.configuration)
    transports = [
        PacketTransport(packet, answers, configuration) for packet, answers in zip(args.packet, args.answers)
    ]
    write_packets(args.database, transports, read(args.coordinates), args.report)

