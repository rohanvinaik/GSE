### GSE/api/__init__.py """
GSE API - Encoding and Decoding natural language to HDC vectors.

Usage:
    from GSE.api import GSEEncoder, GSEDecoder

    # Encode
    encoder = GSEEncoder()
    trace = encoder.encode("The dog is cuter than the cat")
    print(trace.to_json())

    # Decode
    decoder = GSEDecoder()
    semantics = decoder.decode(trace.vector)
    print(semantics.to_json())

    # Compare
    similarity = decoder.similarity(trace1.vector, trace2.vector)
    print(similarity.cosine)

    # Strict mode (raises exceptions instead of silent fallbacks)
    encoder = GSEEncoder(strict=True)
    try:
        trace = encoder.encode("xyzzy flurble")  # OOV words
    except OOVError as e:
        print(f"Unknown word: {e.word}")
"""

from GSE.api.decoder import GSEDecoder
from GSE.api.encoder import GSEEncoder
from GSE.api.errors import (
    DecodingError,
    EncodingError,
    GSEError,
    OOVError,
    OperatorError,
    PrimitiveError,
)
from GSE.api.trace import (
    AttributeExtraction,
    DecodedSemantics,
    EntityExtraction,
    OperationTrace,
    OperatorTrace,
    RelationExtraction,
    SimilarityResult,
    TokenTrace,
)

__all__ = [
    # Core classes
    "GSEEncoder",
    "GSEDecoder",
    # Trace types
    "TokenTrace",
    "OperatorTrace",
    "OperationTrace",
    "EntityExtraction",
    "AttributeExtraction",
    "RelationExtraction",
    "DecodedSemantics",
    "SimilarityResult",
    # Error types
    "GSEError",
    "OOVError",
    "EncodingError",
    "PrimitiveError",
    "OperatorError",
    "DecodingError",
]


### GSE/symbolic/__init__.py """
Symbolic evaluator over OperationTrace.

Per ``sentence_architecture.md`` line 164: the API for engaging with the
system should be pure Python / order of operations / set theory — not
direct vector math. This package lifts encoder traces into typed ASTs
and applies the set-theory semantics of each compositional operator
symbolically.

Sub-packages:

* :mod:`expression` — the AST (Atom, Phrase, Negation, Op) + builder
  ``from_trace`` that turns an :class:`GSE.api.trace.OperationTrace`
  into an :class:`Expression`.
* :mod:`resolution` *(planned, B5)* — multi-word entity grouping and
  within-sentence reference binding.
* :mod:`operators` *(planned, B2)* — pure-Python implementations of
  SET_DIFF, BIND_EQ, etc.
* :mod:`queries` *(planned, B3)* — consumer interface: entities(),
  predicates(), is_logically_equal_to(), etc.
* :mod:`templating` *(planned, B6)* — structural substitution.

See ``docs/PHASE_B_SCOPE.md`` for the live scope.
"""

