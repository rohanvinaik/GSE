└── PP309 Filter warnings specified ❌
    filterwarnings must be set (probably to at least ["error"]). Python will    
    hide important warnings otherwise, like deprecations.                       
    
                                                                                
     # Old pytest                                                               
     [tool.pytest.ini_options]                                                  
     filterwarnings = ["error"]                                                 
                                                                                
     # pytest 9+                                                                
     [tool.pytest]                                                              
     filterwarnings = ["error"]                                                 
                                                                                

